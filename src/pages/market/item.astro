---
import MarketDetail from '../../components/MarketDetail.astro'
import MarketPage from '../../components/MarketPage.astro'
import { marketCopy } from '../../i18n/market'

const locale = 'zh-CN' as const
const copy = marketCopy(locale)
---

<MarketPage
  locale={locale}
  title={copy.detailMetaTitle}
  description={copy.detailDescription}
  pathname={Astro.url.pathname}
>
  <MarketDetail locale={locale} />
</MarketPage>
