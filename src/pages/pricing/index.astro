---
import CommercialPage from '../../components/CommercialPage.astro'
import PricingCatalog from '../../components/PricingCatalog.astro'
import { commercialCopy } from '../../i18n/commercial'

const locale = 'zh-CN' as const
const copy = commercialCopy(locale)
---

<CommercialPage
  locale={locale}
  title={`${copy.pricingTitle} · CodeY`}
  description={copy.pricingDescription}
  pathname={Astro.url.pathname}
>
  <PricingCatalog locale={locale} />
</CommercialPage>
