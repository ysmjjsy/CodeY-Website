---
import CommercialPage from '../../../components/CommercialPage.astro'
import ModelsCatalog from '../../../components/ModelsCatalog.astro'
import { commercialCopy } from '../../../i18n/commercial'

const locale = 'en' as const
const copy = commercialCopy(locale)
---

<CommercialPage
  locale={locale}
  title={`${copy.modelsTitle} · CodeY`}
  description={copy.modelsDescription}
  pathname={Astro.url.pathname}
>
  <ModelsCatalog locale={locale} />
</CommercialPage>
