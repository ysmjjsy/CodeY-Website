---
import CommercialPage from '../../../components/CommercialPage.astro'
import RegisterAccount from '../../../components/RegisterAccount.astro'
import { authCopy } from '../../../i18n/auth'

const locale = 'en' as const
const copy = authCopy(locale)
---

<CommercialPage
  locale={locale}
  title={`${copy.registerTitle} · CodeY`}
  description={copy.registerDescription}
  pathname={Astro.url.pathname}
>
  <RegisterAccount locale={locale} />
</CommercialPage>
