---
import ConsoleShell from '../../../components/ConsoleShell.astro'
import MarketDashboard from '../../../components/MarketDashboard.astro'
import { dashboardCopy } from '../../../i18n/dashboard'
import MarketLayout from '../../../layouts/MarketLayout.astro'

const locale = 'en' as const
const copy = dashboardCopy(locale)
---

<MarketLayout title={copy.metaTitle} description={copy.metaDescription} locale={locale} alternateHref="/console/templates/">
  <ConsoleShell locale={locale} activeSection="templates">
    <MarketDashboard locale={locale} />
  </ConsoleShell>
</MarketLayout>
