---
import ConsoleShell from '../../../components/ConsoleShell.astro'
import ProfileOverview from '../../../components/ProfileOverview.astro'
import { profileCopy } from '../../../i18n/profile'
import MarketLayout from '../../../layouts/MarketLayout.astro'

const locale = 'en' as const
const copy = profileCopy(locale)
---

<MarketLayout title={`${copy.title} · CodeY`} description={copy.description} locale={locale} alternateHref="/console/">
  <ConsoleShell locale={locale} activeSection="profile">
    <ProfileOverview locale={locale} />
  </ConsoleShell>
</MarketLayout>
