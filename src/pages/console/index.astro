---
import CloudOverview from '../../components/CloudOverview.astro'
import ConsoleShell from '../../components/ConsoleShell.astro'
import { cloudCopy } from '../../i18n/cloud'
import MarketLayout from '../../layouts/MarketLayout.astro'

const locale = 'zh-CN' as const
const copy = cloudCopy(locale)
---

<MarketLayout title={`${copy.accountTitle} · CodeY`} description={copy.accountDescription} locale={locale} alternateHref="/en/console/">
  <ConsoleShell locale={locale} activeSection="credits">
    <CloudOverview locale={locale} />
  </ConsoleShell>
</MarketLayout>
