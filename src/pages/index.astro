---
import Architecture from '../components/Architecture.astro'
import Features from '../components/Features.astro'
import GetStarted from '../components/GetStarted.astro'
import Hero from '../components/Hero.astro'
import LandingPage from '../components/LandingPage.astro'
import SdkSection from '../components/SdkSection.astro'

const locale = 'zh-CN' as const
---

<LandingPage locale={locale} pathname={Astro.url.pathname}>
  <Hero locale={locale} />
  <Features locale={locale} />
  <Architecture locale={locale} />
  <SdkSection locale={locale} />
  <GetStarted locale={locale} />
</LandingPage>
