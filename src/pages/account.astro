---
import CloudAccount from '../components/CloudAccount.astro'
import { cloudCopy } from '../i18n/cloud'
import MarketLayout from '../layouts/MarketLayout.astro'

const locale = 'zh-CN' as const
const copy = cloudCopy(locale)
---

<MarketLayout title={`${copy.accountTitle} · CodeY`} description={copy.accountDescription} locale={locale} alternateHref="/en/account/">
  <CloudAccount locale={locale} />
</MarketLayout>
