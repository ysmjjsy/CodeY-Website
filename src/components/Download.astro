---
import type { Locale } from '../i18n/ui'
import { docsPath, t } from '../i18n/utils'
import ReleaseHistory from './ReleaseHistory.astro'
import Button from './ui/Button.astro'
import Container from './ui/Container.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const releasesApi = 'https://api.github.com/repos/ysmjjsy/CodeY-Releases/releases?per_page=20'
const docsHref = docsPath(locale, 'getting-started')
---

<section
  class="section download-section"
  id="download"
  data-download-root
  data-locale={locale}
  data-release-api={releasesApi}
  data-release-state="loading"
  data-status-ready={t(locale, 'download.status.ready')}
  data-status-empty={t(locale, 'download.status.empty')}
  data-status-error={t(locale, 'download.status.error')}
  data-platform-unavailable={t(locale, 'download.platform.unavailable')}
  data-arch-arm64={t(locale, 'download.arch.arm64')}
  data-arch-x64={t(locale, 'download.arch.x64')}
  data-arch-apple-silicon={t(locale, 'download.arch.appleSilicon')}
  data-arch-intel={t(locale, 'download.arch.intel')}
  data-history-count={t(locale, 'download.history.count')}
  data-history-latest={t(locale, 'download.history.latest')}
  data-history-prerelease={t(locale, 'download.history.prerelease')}
  data-history-published={t(locale, 'download.history.published')}
  data-history-notes={t(locale, 'download.history.notes')}
  data-history-downloads={t(locale, 'download.history.downloads')}
  data-history-packages={t(locale, 'download.history.packages')}
  data-history-empty-notes={t(locale, 'download.history.emptyNotes')}
  data-history-empty-downloads={t(locale, 'download.history.emptyDownloads')}
  data-history-error={t(locale, 'download.history.error')}
>
  <div class="download-bg" aria-hidden="true"></div>
  <div class="download-glow download-glow-cyan" aria-hidden="true"></div>
  <div class="download-glow download-glow-amber" aria-hidden="true"></div>

  <Container class="download-inner">
    <div class="download-head reveal">
      <div class="section-head">
        <p class="section-tag">{t(locale, 'download.tag')}</p>
        <h1 class="section-title">
          {t(locale, 'download.title.prefix')}
          <span class="title-accent">{t(locale, 'download.title.brand')}</span>
        </h1>
        <p class="section-desc">{t(locale, 'download.desc')}</p>
      </div>

      <div class="download-meta">
        <div class="release-status" data-release-state="loading" aria-live="polite">
          <span class="release-dot" aria-hidden="true"></span>
          <span data-release-status-text>{t(locale, 'download.status.loading')}</span>
        </div>
        <div class="platform-chips" aria-hidden="true">
          <span>macOS</span>
          <span>Windows</span>
          <span>Linux</span>
        </div>
      </div>
    </div>

    <div class="download-grid" data-download-grid>
      <article class="download-card reveal" data-platform="darwin" style="--reveal-delay: 0s">
        <div class="platform-head">
          <span class="platform-icon"><i class="ph ph-apple-logo" aria-hidden="true"></i></span>
          <span class="recommended-badge" data-recommended hidden>{t(locale, 'download.recommended')}</span>
        </div>
        <h3>{t(locale, 'download.mac.title')}</h3>
        <p>{t(locale, 'download.mac.desc')}</p>
        <div class="asset-actions" data-assets>
          <span class="asset-skeleton" aria-hidden="true"></span>
          <span class="asset-skeleton" aria-hidden="true"></span>
        </div>
        <p class="platform-unavailable" data-unavailable hidden></p>
      </article>

      <article class="download-card reveal" data-platform="windows" style="--reveal-delay: 0.08s">
        <div class="platform-head">
          <span class="platform-icon"><i class="ph ph-windows-logo" aria-hidden="true"></i></span>
          <span class="recommended-badge" data-recommended hidden>{t(locale, 'download.recommended')}</span>
        </div>
        <h3>{t(locale, 'download.windows.title')}</h3>
        <p>{t(locale, 'download.windows.desc')}</p>
        <div class="asset-actions" data-assets>
          <span class="asset-skeleton" aria-hidden="true"></span>
          <span class="asset-skeleton" aria-hidden="true"></span>
        </div>
        <p class="platform-unavailable" data-unavailable hidden></p>
      </article>

      <article class="download-card reveal" data-platform="linux" style="--reveal-delay: 0.16s">
        <div class="platform-head">
          <span class="platform-icon"><i class="ph ph-linux-logo" aria-hidden="true"></i></span>
          <span class="recommended-badge" data-recommended hidden>{t(locale, 'download.recommended')}</span>
        </div>
        <h3>{t(locale, 'download.linux.title')}</h3>
        <p>{t(locale, 'download.linux.desc')}</p>
        <div class="asset-actions" data-assets>
          <span class="asset-skeleton" aria-hidden="true"></span>
          <span class="asset-skeleton" aria-hidden="true"></span>
        </div>
        <p class="platform-unavailable" data-unavailable hidden></p>
      </article>
    </div>

    <div class="download-foot reveal">
      <p class="download-trust">
        <i class="ph ph-shield-check" aria-hidden="true"></i>
        {t(locale, 'download.trust')}
      </p>
      <div class="download-links">
        <Button variant="ghost" size="sm" href={docsHref}>
          <i class="ph ph-book-open-text" aria-hidden="true"></i>
          {t(locale, 'download.docs')}
        </Button>
        <Button variant="ghost" size="sm" href="#release-history">
          <i class="ph ph-clock-counter-clockwise" aria-hidden="true"></i>
          {t(locale, 'download.releases')}
        </Button>
      </div>
    </div>

    <ReleaseHistory locale={locale} />
  </Container>
</section>

<style>
  .download-section {
    position: relative;
    overflow: hidden;
    min-height: calc(100vh - 286px);
    padding-top: clamp(132px, 14vw, 172px);
    padding-bottom: clamp(72px, 10vw, 112px);
    border-bottom: 1px solid var(--border);
  }

  .download-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 75% 55% at 50% 0%, black 18%, transparent 78%);
    pointer-events: none;
  }

  .download-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    pointer-events: none;
  }

  .download-glow-cyan {
    width: min(420px, 70vw);
    height: min(420px, 70vw);
    top: -80px;
    right: -40px;
    background: var(--decorative-glow);
  }

  .download-glow-amber {
    width: min(260px, 50vw);
    height: min(260px, 50vw);
    top: 180px;
    left: -80px;
    background: var(--amber-soft);
  }

  .download-inner {
    position: relative;
    z-index: 1;
  }

  .download-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-28);
    margin-bottom: clamp(28px, 5vw, 48px);
  }

  .download-head .section-head {
    margin-bottom: 0;
  }

  .title-accent {
    color: var(--accent-bright);
  }

  .download-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-12);
  }

  .release-status {
    display: flex;
    align-items: center;
    gap: var(--space-9);
    min-height: 40px;
    padding: var(--space-8) var(--space-14);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    color: var(--fg-muted);
    background: var(--chip-bg);
    backdrop-filter: blur(8px);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  .release-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--amber);
    box-shadow: 0 0 8px var(--amber);
    animation: release-pulse 1.8s ease-in-out infinite;
  }

  .release-status[data-release-state="ready"] .release-dot {
    background: var(--success);
    box-shadow: 0 0 8px var(--success);
    animation: none;
  }

  .release-status[data-release-state="empty"] .release-dot {
    background: var(--fg-faint);
    box-shadow: none;
    animation: none;
  }

  .release-status[data-release-state="error"] .release-dot {
    background: var(--danger);
    box-shadow: none;
    animation: none;
  }

  @keyframes release-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  .platform-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-8);
  }

  .platform-chips span {
    padding: var(--space-5) var(--space-12);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--fg-faint);
    background: var(--ghost-bg);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
  }

  .download-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-16);
  }

  .download-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(22px, 3vw, 30px);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: linear-gradient(180deg, var(--ghost-bg-hover), var(--ghost-bg)), var(--surface);
    box-shadow: inset 0 1px 0 var(--panel-inset);
    transition:
      transform 0.25s var(--ease-out),
      border-color 0.25s,
      box-shadow 0.25s,
      background 0.25s;
  }

  .download-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-hover);
  }

  .download-card.is-recommended {
    border-color: var(--accent-ring);
    background:
      radial-gradient(ellipse 90% 70% at 100% 0%, var(--accent-glow), transparent 55%),
      linear-gradient(180deg, var(--ghost-bg-hover), var(--ghost-bg)), var(--surface);
    box-shadow:
      inset 0 1px 0 var(--panel-inset),
      0 0 0 1px var(--accent-ring),
      var(--shadow-window);
  }

  .platform-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-16);
    margin-bottom: var(--space-22);
  }

  .platform-icon {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid var(--accent-ring);
    border-radius: var(--radius-lg);
    color: var(--accent-bright);
    background: var(--accent-soft);
    font-size: var(--text-3xl);
  }

  .recommended-badge {
    padding: var(--space-4) var(--space-10);
    border: 1px solid var(--accent-ring);
    border-radius: var(--radius-pill);
    color: var(--accent-bright);
    background: var(--accent-soft);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    white-space: nowrap;
  }

  .download-card h3 {
    font-size: var(--text-2xl);
    font-weight: 600;
  }

  .download-card > p:not(.platform-unavailable) {
    flex: 1;
    min-height: 3.2em;
    margin: var(--space-8) 0 var(--space-24);
    color: var(--fg-muted);
    font-size: var(--text-base);
  }

  .asset-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    margin-top: auto;
  }

  .asset-skeleton {
    display: block;
    height: 42px;
    border-radius: var(--radius-md);
    background: linear-gradient(
      90deg,
      var(--ghost-bg) 0%,
      var(--ghost-bg-hover) 45%,
      var(--ghost-bg) 90%
    );
    background-size: 200% 100%;
    animation: skeleton-shine 1.4s ease-in-out infinite;
  }

  .download-section[data-release-state="ready"] .asset-skeleton,
  .download-section[data-release-state="empty"] .asset-skeleton,
  .download-section[data-release-state="error"] .asset-skeleton {
    display: none;
  }

  @keyframes skeleton-shine {
    0% {
      background-position: 100% 0;
    }
    100% {
      background-position: -100% 0;
    }
  }

  .asset-actions :global(.btn) {
    width: 100%;
    min-height: 42px;
    justify-content: flex-start;
    padding-inline: var(--space-14);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .asset-actions :global(.btn-primary) {
    box-shadow: 0 8px 24px var(--accent-glow);
  }

  .asset-actions :global(.download-asset .asset-kind) {
    display: inline-flex;
    min-width: 4.2em;
    color: inherit;
    opacity: 0.92;
  }

  .asset-actions :global(.btn-ghost .asset-kind) {
    color: var(--accent-bright);
  }

  .asset-actions :global(.download-asset .asset-meta) {
    color: inherit;
    opacity: 0.78;
  }

  .platform-unavailable {
    margin: var(--space-12) 0 0;
    color: var(--fg-faint);
    font-size: var(--text-xs);
  }

  .download-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-20);
    margin-top: clamp(28px, 4vw, 40px);
    padding-top: var(--space-22);
    border-top: 1px solid var(--border);
  }

  .download-trust {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    margin: 0;
    color: var(--fg-faint);
    font-size: var(--text-xs);
  }

  .download-trust i {
    flex-shrink: 0;
    color: var(--success);
    font-size: var(--text-lg);
  }

  .download-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  .download-links :global(.btn) {
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .download-head {
      align-items: start;
      flex-direction: column;
    }

    .download-meta {
      align-items: stretch;
      width: 100%;
    }

    .release-status {
      width: 100%;
      flex-wrap: wrap;
      white-space: normal;
    }

    .platform-chips {
      justify-content: flex-start;
    }

    .download-grid {
      grid-template-columns: 1fr;
    }

    .download-card > p:not(.platform-unavailable) {
      min-height: 0;
    }

    .download-foot {
      flex-direction: column;
      align-items: stretch;
    }

    .download-links :global(.btn) {
      flex: 1 1 auto;
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .download-section {
      padding-top: var(--space-116);
    }

    .release-status {
      align-items: flex-start;
      border-radius: var(--radius-md);
    }

    .download-trust {
      align-items: flex-start;
    }

    .download-glow-cyan {
      top: -40px;
      right: -100px;
    }
  }

  @media (hover: none) {
    .download-card:hover {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .release-dot,
    .asset-skeleton {
      animation: none;
    }
  }
</style>

<script>
  import { initDownload } from '../lib/download.ts'
  initDownload()
</script>
