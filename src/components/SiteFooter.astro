---
import { Image } from 'astro:assets'
import logo from '../assets/logo.png'
import type { Locale } from '../i18n/ui'
import { docsPath, homePath, t } from '../i18n/utils'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href={homePath(locale)} class="footer-logo">
        <Image src={logo} alt="CodeY" width="28" height="28" />
        <span>CodeY</span>
      </a>
      <p>{t(locale, 'footer.desc')}</p>
    </div>
    <nav class="footer-col" aria-label={t(locale, 'footer.docs')}>
      <h4>{t(locale, 'footer.docs')}</h4>
      <a href={docsPath(locale, 'intro')}>{t(locale, 'footer.docs.intro')}</a>
      <a href={docsPath(locale, 'getting-started')}>{t(locale, 'footer.docs.start')}</a>
      <a href={docsPath(locale, 'architecture')}>{t(locale, 'footer.docs.arch')}</a>
      <a href={docsPath(locale, 'sdk/overview')}>{t(locale, 'footer.docs.sdk')}</a>
    </nav>
    <nav class="footer-col" aria-label={t(locale, 'footer.community')}>
      <h4>{t(locale, 'footer.community')}</h4>
      <a href="https://github.com/ysmjjsy/CodeY" target="_blank" rel="noopener">GitHub</a>
      <a href="https://github.com/ysmjjsy/CodeY/issues" target="_blank" rel="noopener">Issues</a>
      <a href={docsPath(locale, 'contributing')}>{t(locale, 'footer.community.contribute')}</a>
      <a
        href="https://github.com/ysmjjsy/CodeY/blob/main/CODE_OF_CONDUCT.md"
        target="_blank"
        rel="noopener">{t(locale, 'footer.community.coc')}</a
      >
    </nav>
    <nav class="footer-col" aria-label={t(locale, 'footer.more')}>
      <h4>{t(locale, 'footer.more')}</h4>
      <a href={docsPath(locale, 'support')}>{t(locale, 'footer.more.support')}</a>
      <a
        href="https://github.com/ysmjjsy/CodeY/blob/main/LICENSE"
        target="_blank"
        rel="noopener">{t(locale, 'footer.more.license')}</a
      >
    </nav>
  </div>
  <div class="container footer-bottom">
    <span>{t(locale, 'footer.copy')}</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--bg-soft);
    padding-top: clamp(40px, 6vw, 64px);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 48px);
    padding-bottom: clamp(36px, 5vw, 56px);
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
  }

  .footer-logo img {
    border-radius: 7px;
  }

  .footer-brand p {
    color: var(--fg-faint);
    font-size: 0.86rem;
    max-width: 30em;
    margin: 16px 0 0;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-col h4 {
    margin: 0 0 6px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--fg);
    letter-spacing: 0.04em;
  }

  .footer-col a {
    color: var(--fg-muted);
    font-size: 0.88rem;
    transition: color 0.15s;
  }

  .footer-col a:hover {
    color: var(--accent-bright);
  }

  .footer-bottom {
    border-top: 1px solid var(--border);
    padding-block: 24px;
    font-size: 0.8rem;
    color: var(--fg-faint);
    font-family: var(--font-mono);
  }

  @media (max-width: 820px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .footer-brand {
      grid-column: auto;
    }
  }
</style>
