---
import type { Locale } from '../i18n/ui'
import { marketCopy } from '../i18n/market'
import { marketPath } from '../i18n/utils'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = marketCopy(locale)
const apiBase = '/api/market/v1'
---

<section
  class="container market-detail"
  data-market-detail
  data-api-base={apiBase}
  data-locale={locale}
  data-copy={JSON.stringify(copy)}
>
  <a class="market-back" href={marketPath(locale)}>← {copy.back}</a>
  <div class="market-state" data-detail-state>{copy.loading}</div>

  <article hidden data-detail-content>
    <header class="market-detail-head">
      <div>
        <div class="market-card-top market-detail-kind-row">
          <span class="market-kind-mark" data-detail-mark></span>
          <span class="market-kind" data-detail-kind></span>
        </div>
        <h1 class="market-detail-title" data-detail-title></h1>
        <p class="market-detail-summary" data-detail-summary></p>
        <div class="market-tags" data-detail-tags></div>
      </div>
      <div class="market-detail-actions">
        <label for="market-version" class="market-kind">{copy.selectVersion}</label>
        <select id="market-version" class="market-select" data-detail-versions></select>
        <a class="btn btn-primary" data-detail-download>{copy.download}</a>
      </div>
    </header>

    <div class="market-detail-grid">
      <div>
        <section class="market-detail-section">
          <h2>{copy.about}</h2>
          <div class="market-readme" data-detail-readme></div>
        </section>
        <section class="market-detail-section">
          <h2>{copy.resources}</h2>
          <ul class="market-list" data-detail-resources></ul>
        </section>
        <section class="market-detail-section">
          <h2>{copy.permissions}</h2>
          <ul class="market-list" data-detail-permissions></ul>
        </section>
      </div>
      <aside class="market-detail-aside">
        <h2>{copy.compatibility}</h2>
        <dl class="market-facts">
          <div><dt>{copy.packageId}</dt><dd data-fact-package></dd></div>
          <div><dt>{copy.by}</dt><dd data-fact-publisher></dd></div>
          <div><dt>{copy.license}</dt><dd data-fact-license></dd></div>
          <div><dt>{copy.codeyRange}</dt><dd data-fact-codey></dd></div>
          <div><dt>{copy.platforms}</dt><dd data-fact-platforms></dd></div>
          <div><dt>{copy.architectures}</dt><dd data-fact-architectures></dd></div>
          <div><dt>{copy.published}</dt><dd data-fact-published></dd></div>
          <div><dt>{copy.downloads}</dt><dd data-fact-downloads></dd></div>
        </dl>
      </aside>
    </div>
  </article>
</section>

<script>
  type ReleaseSummary = {
    releaseId: string
    version: string
    publishedAt: string
    compatibility: { codeyVersionRange: string; platforms: string[]; architectures: string[] }
  }
  type Resource = { displayName: string; resource: { type: string } }
  type Listing = {
    listingId: string
    packageId: string
    kind: 'agent_template' | 'team_template' | 'skill' | 'mcp'
    title: string
    summary: string
    tags: string[]
    publisherDisplayName: string
    license: string
    downloadCount: number
    readmeMarkdown: string
    requestedPermissions: string[]
    resources: Resource[]
    releases: ReleaseSummary[]
    latestRelease: ReleaseSummary
  }
  type Release = ReleaseSummary & {
    packageId: string
    kind: Listing['kind']
    title: string
    summaryText: string
    tags: string[]
    publisherDisplayName: string
    license: string
    readmeMarkdown: string
    requestedPermissions: string[]
    resources: Resource[]
  }

  const root = document.querySelector<HTMLElement>('[data-market-detail]')
  if (root) {
    const apiBase = root.dataset.apiBase || '/api/market/v1'
    const locale = root.dataset.locale === 'en' ? 'en' : 'zh-CN'
    const copy = JSON.parse(root.dataset.copy || '{}') as Record<string, string>
    const state = root.querySelector<HTMLElement>('[data-detail-state]')!
    const content = root.querySelector<HTMLElement>('[data-detail-content]')!
    const versions = root.querySelector<HTMLSelectElement>('[data-detail-versions]')!
    const download = root.querySelector<HTMLAnchorElement>('[data-detail-download]')!
    let listing: Listing | null = null

    const kindCopy: Record<Listing['kind'], string> = {
      agent_template: copy.agentTemplate,
      team_template: copy.teamTemplate,
      skill: copy.skill,
      mcp: copy.mcp,
    }
    const kindMark: Record<Listing['kind'], string> = {
      agent_template: 'A',
      team_template: 'AT',
      skill: 'S',
      mcp: 'M',
    }

    function setText(selector: string, value: string): void {
      const element = root.querySelector<HTMLElement>(selector)
      if (element) element.textContent = value
    }

    function fillList(selector: string, values: string[], fallback?: string): void {
      const element = root.querySelector<HTMLElement>(selector)!
      element.replaceChildren()
      const items = values.length ? values : fallback ? [fallback] : []
      items.forEach((value) => {
        const item = document.createElement('li')
        item.textContent = value
        element.append(item)
      })
    }

    function renderMarkdown(markdown: string): void {
      const target = root.querySelector<HTMLElement>('[data-detail-readme]')!
      target.replaceChildren()
      const lines = markdown.replace(/\r\n/g, '\n').split('\n')
      let code: string[] | null = null
      let list: HTMLUListElement | null = null
      for (const line of lines) {
        if (line.trim().startsWith('```')) {
          list = null
          if (code) {
            const pre = document.createElement('pre')
            const node = document.createElement('code')
            node.textContent = code.join('\n')
            pre.append(node)
            target.append(pre)
            code = null
          } else {
            code = []
          }
          continue
        }
        if (code) {
          code.push(line)
          continue
        }
        const heading = /^(#{1,3})\s+(.+)$/.exec(line)
        if (heading) {
          list = null
          const node = document.createElement(`h${heading[1].length}`)
          node.textContent = heading[2]
          target.append(node)
          continue
        }
        const bullet = /^[-*]\s+(.+)$/.exec(line)
        if (bullet) {
          if (!list) {
            list = document.createElement('ul')
            target.append(list)
          }
          const item = document.createElement('li')
          item.textContent = bullet[1]
          list.append(item)
          continue
        }
        list = null
        if (line.trim()) {
          const paragraph = document.createElement('p')
          paragraph.textContent = line
          target.append(paragraph)
        }
      }
      if (code) {
        const pre = document.createElement('pre')
        const node = document.createElement('code')
        node.textContent = code.join('\n')
        pre.append(node)
        target.append(pre)
      }
      if (!target.childElementCount) {
        const paragraph = document.createElement('p')
        paragraph.textContent = listing?.summary || ''
        target.append(paragraph)
      }
    }

    function applyDetail(detail: Listing | Release, release: ReleaseSummary): void {
      const summary = 'summaryText' in detail ? detail.summaryText : detail.summary
      setText('[data-detail-mark]', kindMark[detail.kind])
      setText('[data-detail-kind]', kindCopy[detail.kind])
      setText('[data-detail-title]', detail.title)
      setText('[data-detail-summary]', summary)
      const tags = root.querySelector<HTMLElement>('[data-detail-tags]')!
      tags.replaceChildren()
      detail.tags.forEach((tag) => {
        const item = document.createElement('span')
        item.className = 'market-tag'
        item.textContent = tag
        tags.append(item)
      })
      renderMarkdown(detail.readmeMarkdown)
      fillList('[data-detail-resources]', detail.resources.map((resource) => resource.displayName))
      fillList('[data-detail-permissions]', detail.requestedPermissions, copy.noPermissions)
      setText('[data-fact-package]', detail.packageId)
      setText('[data-fact-publisher]', detail.publisherDisplayName)
      setText('[data-fact-license]', detail.license)
      setText('[data-fact-codey]', release.compatibility.codeyVersionRange)
      setText('[data-fact-platforms]', release.compatibility.platforms.join(', ') || '—')
      setText('[data-fact-architectures]', release.compatibility.architectures.join(', ') || '—')
      setText('[data-fact-published]', new Intl.DateTimeFormat(locale, { dateStyle: 'medium' }).format(new Date(release.publishedAt)))
      setText('[data-fact-downloads]', new Intl.NumberFormat(locale).format(listing?.downloadCount || 0))
      download.href = `${apiBase}/releases/${encodeURIComponent(release.releaseId)}/artifact`
      document.title = `${detail.title} · CodeY`
    }

    async function selectRelease(releaseId: string): Promise<void> {
      const release = listing?.releases.find((item) => item.releaseId === releaseId)
      if (!release || !listing) return
      download.href = `${apiBase}/releases/${encodeURIComponent(releaseId)}/artifact`
      try {
        const response = await fetch(`${apiBase}/releases/${encodeURIComponent(releaseId)}`)
        if (!response.ok) throw new Error(`HTTP ${response.status}`)
        applyDetail((await response.json()) as Release, release)
      } catch {
        applyDetail(listing, release)
      }
    }

    async function load(): Promise<void> {
      const listingId = new URLSearchParams(window.location.search).get('id')
      if (!listingId) {
        state.textContent = copy.missingId
        return
      }
      try {
        const response = await fetch(`${apiBase}/listings/${encodeURIComponent(listingId)}`)
        if (!response.ok) throw new Error(`HTTP ${response.status}`)
        listing = (await response.json()) as Listing
        versions.replaceChildren()
        listing.releases.forEach((release) => {
          const option = document.createElement('option')
          option.value = release.releaseId
          option.textContent = release.version
          option.selected = release.releaseId === listing?.latestRelease.releaseId
          versions.append(option)
        })
        applyDetail(listing, listing.latestRelease)
        state.hidden = true
        content.hidden = false
      } catch {
        state.textContent = copy.unavailable
      }
    }

    versions.addEventListener('change', () => void selectRelease(versions.value))
    void load()
  }
</script>
