---
import type { Locale } from '../i18n/ui'
import { marketCopy } from '../i18n/market'
import { marketPath } from '../i18n/utils'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = marketCopy(locale)
const apiBase = '/api/market/v1'
---

<section
  class="market-detail"
  data-market-detail
  data-api-base={apiBase}
  data-locale={locale}
  data-copy={JSON.stringify(copy)}
>
  <a class="market-back" href={marketPath(locale)}><span aria-hidden="true">←</span>{copy.back}</a>
  <div class="market-state" data-detail-state>{copy.loading}</div>

  <article hidden data-detail-content>
    <header class="market-detail-hero">
      <div class="market-detail-identity">
        <span class="market-detail-icon" data-detail-mark aria-hidden="true"></span>
        <div class="market-detail-heading">
          <div class="market-detail-title-row">
            <h1 data-detail-title></h1>
            <span class="market-detail-version" data-detail-version></span>
          </div>
          <p class="market-detail-summary" data-detail-summary></p>
          <div class="market-detail-meta">
            <span class="market-detail-kind" data-detail-kind></span>
            <span><span aria-hidden="true">●</span> <span data-detail-publisher></span></span>
            <span><span aria-hidden="true">↓</span> <span data-detail-downloads></span></span>
            <span><span aria-hidden="true">◷</span> <span data-detail-published></span></span>
          </div>
          <div class="market-tags" data-detail-tags></div>
        </div>
      </div>
      <a class="btn btn-primary market-detail-download" data-detail-download>
        <span aria-hidden="true">↓</span>{copy.download}
      </a>
    </header>

    <nav class="market-detail-tabs" role="tablist" aria-label={copy.detailNavigation}>
      <button type="button" role="tab" aria-selected="true" class="is-active" data-detail-tab="intro">{copy.introTab}</button>
      <button type="button" role="tab" aria-selected="false" data-detail-tab="contents">{copy.contentsTab}<span data-resource-count></span></button>
      <button type="button" role="tab" aria-selected="false" data-detail-tab="requirements">{copy.requirementsTab}</button>
    </nav>

    <div class="market-detail-workspace">
      <main class="market-detail-document">
        <section role="tabpanel" data-detail-panel="intro">
          <div class="market-document-toolbar" aria-hidden="true">
            <span>{copy.readmeLabel}</span>
            <span>{copy.previewLabel}</span>
          </div>
          <div class="market-readme" data-detail-readme></div>
        </section>

        <section role="tabpanel" data-detail-panel="contents" hidden>
          <div class="market-document-section-head">
            <p class="market-eyebrow">CodeY Package</p>
            <h2>{copy.resources}</h2>
            <p>{copy.resourcesDescription}</p>
          </div>
          <ul class="market-resource-list" data-detail-resources></ul>
        </section>

        <section role="tabpanel" data-detail-panel="requirements" hidden>
          <div class="market-document-section-head">
            <p class="market-eyebrow">Safety & Compatibility</p>
            <h2>{copy.permissions}</h2>
            <p>{copy.permissionsDescription}</p>
          </div>
          <ul class="market-permission-list" data-detail-permissions></ul>
          <div class="market-compatibility-summary">
            <h2>{copy.compatibility}</h2>
            <dl>
              <div><dt>{copy.codeyRange}</dt><dd data-inline-codey></dd></div>
              <div><dt>{copy.platforms}</dt><dd data-inline-platforms></dd></div>
              <div><dt>{copy.architectures}</dt><dd data-inline-architectures></dd></div>
            </dl>
          </div>
        </section>
      </main>

      <aside class="market-detail-sidebar">
        <section class="market-detail-side-card market-install-card">
          <p class="market-side-kicker">{copy.getTemplate}</p>
          <h2>{copy.downloadTemplate}</h2>
          <label for="market-version">{copy.selectVersion}</label>
          <select id="market-version" class="market-select" data-detail-versions></select>
          <a class="btn btn-primary" data-detail-download-side>
            <span aria-hidden="true">↓</span>{copy.download}
          </a>
          <p class="market-install-note">{copy.downloadHint}</p>
        </section>

        <section class="market-detail-side-card">
          <h2><span aria-hidden="true">◇</span>{copy.templateInfo}</h2>
          <dl class="market-facts">
            <div><dt>{copy.packageId}</dt><dd data-fact-package></dd></div>
            <div><dt>{copy.by}</dt><dd data-fact-publisher></dd></div>
            <div><dt>{copy.license}</dt><dd data-fact-license></dd></div>
            <div><dt>{copy.codeyRange}</dt><dd data-fact-codey></dd></div>
            <div><dt>{copy.platforms}</dt><dd data-fact-platforms></dd></div>
            <div><dt>{copy.architectures}</dt><dd data-fact-architectures></dd></div>
            <div><dt>{copy.published}</dt><dd data-fact-published></dd></div>
            <div><dt>{copy.downloads}</dt><dd data-fact-downloads></dd></div>
          </dl>
        </section>
      </aside>
    </div>
  </article>
</section>

<script>
  type ReleaseSummary = {
    releaseId: string
    version: string
    publishedAt: string
    compatibility: { codeyVersionRange: string; platforms: string[]; architectures: string[] }
  }
  type Resource = { displayName: string; resource: { type: string } }
  type Listing = {
    listingId: string
    packageId: string
    kind: 'agent_template' | 'team_template' | 'workflow_template' | 'skill' | 'mcp'
    title: string
    summary: string
    tags: string[]
    publisherDisplayName: string
    license: string
    downloadCount: number
    readmeMarkdown: string
    requestedPermissions: string[]
    resources: Resource[]
    releases: ReleaseSummary[]
    latestRelease: ReleaseSummary
  }
  type Release = ReleaseSummary & {
    packageId: string
    kind: Listing['kind']
    title: string
    summaryText: string
    tags: string[]
    publisherDisplayName: string
    license: string
    readmeMarkdown: string
    requestedPermissions: string[]
    resources: Resource[]
  }

  const root = document.querySelector<HTMLElement>('[data-market-detail]')
  if (root) {
    const apiBase = root.dataset.apiBase || '/api/market/v1'
    const locale = root.dataset.locale === 'en' ? 'en' : 'zh-CN'
    const copy = JSON.parse(root.dataset.copy || '{}') as Record<string, string>
    const state = root.querySelector<HTMLElement>('[data-detail-state]')!
    const content = root.querySelector<HTMLElement>('[data-detail-content]')!
    const versions = root.querySelector<HTMLSelectElement>('[data-detail-versions]')!
    const downloads = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-detail-download], [data-detail-download-side]'))
    const tabButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-detail-tab]'))
    const tabPanels = Array.from(root.querySelectorAll<HTMLElement>('[data-detail-panel]'))
    let listing: Listing | null = null

    const kindCopy: Record<Listing['kind'], string> = {
      agent_template: copy.agentTemplate,
      team_template: copy.teamTemplate,
      workflow_template: copy.workflowTemplate,
      skill: copy.skill,
      mcp: copy.mcp,
    }
    const kindMark: Record<Listing['kind'], string> = {
      agent_template: 'A',
      team_template: 'AT',
      workflow_template: 'W',
      skill: 'S',
      mcp: 'M',
    }

    function setText(selector: string, value: string): void {
      const element = root.querySelector<HTMLElement>(selector)
      if (element) element.textContent = value
    }

    function formatDate(value: string): string {
      const date = new Date(value)
      if (Number.isNaN(date.getTime())) return value
      return new Intl.DateTimeFormat(locale, { year: 'numeric', month: '2-digit', day: '2-digit' }).format(date)
    }

    function fillList(selector: string, values: string[], fallback: string, className: string): void {
      const element = root.querySelector<HTMLElement>(selector)!
      element.replaceChildren()
      const items = values.length ? values : [fallback]
      items.forEach((value) => {
        const item = document.createElement('li')
        item.className = className
        const mark = document.createElement('span')
        mark.textContent = values.length ? '✓' : '—'
        mark.setAttribute('aria-hidden', 'true')
        const label = document.createElement('span')
        label.textContent = value
        item.append(mark, label)
        element.append(item)
      })
    }

    function appendInlineText(target: HTMLElement, value: string): void {
      const tokens = value.split(/(`[^`]+`|\*\*[^*]+\*\*)/g).filter(Boolean)
      tokens.forEach((token) => {
        if (token.startsWith('`') && token.endsWith('`')) {
          const code = document.createElement('code')
          code.textContent = token.slice(1, -1)
          target.append(code)
        } else if (token.startsWith('**') && token.endsWith('**')) {
          const strong = document.createElement('strong')
          strong.textContent = token.slice(2, -2)
          target.append(strong)
        } else {
          target.append(document.createTextNode(token))
        }
      })
    }

    function renderMarkdown(markdown: string, fallback: string): void {
      const target = root.querySelector<HTMLElement>('[data-detail-readme]')!
      target.replaceChildren()
      const lines = markdown.replace(/\r\n/g, '\n').split('\n')
      let code: string[] | null = null
      let list: HTMLUListElement | HTMLOListElement | null = null
      let listType = ''
      for (const line of lines) {
        if (line.trim().startsWith('```')) {
          list = null
          listType = ''
          if (code) {
            const pre = document.createElement('pre')
            const node = document.createElement('code')
            node.textContent = code.join('\n')
            pre.append(node)
            target.append(pre)
            code = null
          } else {
            code = []
          }
          continue
        }
        if (code) {
          code.push(line)
          continue
        }
        const heading = /^(#{1,3})\s+(.+)$/.exec(line)
        if (heading) {
          list = null
          listType = ''
          const node = document.createElement(`h${heading[1].length}`)
          appendInlineText(node, heading[2])
          target.append(node)
          continue
        }
        const bullet = /^[-*]\s+(.+)$/.exec(line)
        const ordered = /^\d+\.\s+(.+)$/.exec(line)
        if (bullet || ordered) {
          const nextType = bullet ? 'ul' : 'ol'
          if (!list || listType !== nextType) {
            list = document.createElement(nextType)
            listType = nextType
            target.append(list)
          }
          const item = document.createElement('li')
          appendInlineText(item, (bullet || ordered)![1])
          list.append(item)
          continue
        }
        list = null
        listType = ''
        const quote = /^>\s?(.+)$/.exec(line)
        if (quote) {
          const blockquote = document.createElement('blockquote')
          appendInlineText(blockquote, quote[1])
          target.append(blockquote)
          continue
        }
        if (/^---+$/.test(line.trim())) {
          target.append(document.createElement('hr'))
          continue
        }
        if (line.trim()) {
          const paragraph = document.createElement('p')
          appendInlineText(paragraph, line)
          target.append(paragraph)
        }
      }
      if (code) {
        const pre = document.createElement('pre')
        const node = document.createElement('code')
        node.textContent = code.join('\n')
        pre.append(node)
        target.append(pre)
      }
      if (!target.childElementCount) {
        const paragraph = document.createElement('p')
        paragraph.textContent = fallback
        target.append(paragraph)
      }
    }

    function applyDetail(detail: Listing | Release, release: ReleaseSummary): void {
      const summary = 'summaryText' in detail ? detail.summaryText : detail.summary
      const platforms = release.compatibility.platforms.join(', ') || '—'
      const architectures = release.compatibility.architectures.join(', ') || '—'
      const published = formatDate(release.publishedAt)
      const downloadCount = new Intl.NumberFormat(locale).format(listing?.downloadCount || 0)
      setText('[data-detail-mark]', kindMark[detail.kind])
      setText('[data-detail-kind]', kindCopy[detail.kind])
      setText('[data-detail-title]', detail.title)
      setText('[data-detail-version]', `v${release.version}`)
      setText('[data-detail-summary]', summary)
      setText('[data-detail-publisher]', detail.publisherDisplayName)
      setText('[data-detail-downloads]', `${downloadCount} ${copy.downloads}`)
      setText('[data-detail-published]', published)
      const tags = root.querySelector<HTMLElement>('[data-detail-tags]')!
      tags.replaceChildren()
      detail.tags.forEach((tag) => {
        const item = document.createElement('span')
        item.className = 'market-tag'
        item.textContent = tag
        tags.append(item)
      })
      renderMarkdown(detail.readmeMarkdown, summary)
      fillList('[data-detail-resources]', detail.resources.map((resource) => resource.displayName), copy.noResources, 'market-resource-item')
      fillList('[data-detail-permissions]', detail.requestedPermissions, copy.noPermissions, 'market-permission-item')
      setText('[data-resource-count]', ` ${detail.resources.length}`)
      setText('[data-fact-package]', detail.packageId)
      setText('[data-fact-publisher]', detail.publisherDisplayName)
      setText('[data-fact-license]', detail.license)
      setText('[data-fact-codey]', release.compatibility.codeyVersionRange)
      setText('[data-fact-platforms]', platforms)
      setText('[data-fact-architectures]', architectures)
      setText('[data-fact-published]', published)
      setText('[data-fact-downloads]', downloadCount)
      setText('[data-inline-codey]', release.compatibility.codeyVersionRange)
      setText('[data-inline-platforms]', platforms)
      setText('[data-inline-architectures]', architectures)
      const href = `${apiBase}/releases/${encodeURIComponent(release.releaseId)}/artifact`
      downloads.forEach((link) => {
        link.href = href
        link.setAttribute('download', '')
      })
      document.title = `${detail.title} · CodeY`
    }

    async function selectRelease(releaseId: string): Promise<void> {
      const release = listing?.releases.find((item) => item.releaseId === releaseId)
      if (!release || !listing) return
      try {
        const response = await fetch(`${apiBase}/releases/${encodeURIComponent(releaseId)}`)
        if (!response.ok) throw new Error(`HTTP ${response.status}`)
        applyDetail((await response.json()) as Release, release)
      } catch {
        applyDetail(listing, release)
      }
    }

    function selectTab(name: string): void {
      tabButtons.forEach((button) => {
        const active = button.dataset.detailTab === name
        button.classList.toggle('is-active', active)
        button.setAttribute('aria-selected', String(active))
      })
      tabPanels.forEach((panel) => {
        panel.hidden = panel.dataset.detailPanel !== name
      })
    }

    async function load(): Promise<void> {
      const listingId = new URLSearchParams(window.location.search).get('id')
      if (!listingId) {
        state.textContent = copy.missingId
        return
      }
      try {
        const response = await fetch(`${apiBase}/listings/${encodeURIComponent(listingId)}`)
        if (!response.ok) throw new Error(`HTTP ${response.status}`)
        listing = (await response.json()) as Listing
        versions.replaceChildren()
        listing.releases.forEach((release) => {
          const option = document.createElement('option')
          option.value = release.releaseId
          option.textContent = `v${release.version}`
          option.selected = release.releaseId === listing?.latestRelease.releaseId
          versions.append(option)
        })
        applyDetail(listing, listing.latestRelease)
        state.hidden = true
        content.hidden = false
      } catch {
        state.textContent = copy.unavailable
      }
    }

    versions.addEventListener('change', () => void selectRelease(versions.value))
    tabButtons.forEach((button) => button.addEventListener('click', () => selectTab(button.dataset.detailTab || 'intro')))
    void load()
  }
</script>
