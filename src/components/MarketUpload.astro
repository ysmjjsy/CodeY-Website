---
import type { Locale } from '../i18n/ui'
import { marketCopy } from '../i18n/market'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = marketCopy(locale)
const apiBase = '/api/market/v1'
---

<dialog
  class="market-upload-dialog"
  data-market-upload
  data-api-base={apiBase}
  data-copy={JSON.stringify(copy)}
  data-locale={locale}
  aria-labelledby="market-upload-title"
>
  <div class="market-upload-modal">
    <header class="market-upload-head">
      <div>
        <p class="market-eyebrow">{copy.eyebrow}</p>
        <h2 id="market-upload-title">{copy.uploadTitle}</h2>
        <p>{copy.uploadDescription}</p>
      </div>
      <button
        class="market-dialog-close"
        type="button"
        data-upload-close
        aria-label={locale === 'en' ? 'Close' : '关闭'}>×</button
      >
    </header>

    <div class="market-upload-content">
      <form class="market-form-card" data-upload-inspect>
        <h3>{copy.stepArchive}</h3>
        <div class="market-field market-file">
          <label for="market-archive">{copy.archiveLabel}</label>
          <input id="market-archive" name="archive" type="file" accept=".codeypkg,application/json" required />
          <p class="market-field-hint">{copy.archiveHint}</p>
        </div>
        <div class="market-form-actions">
          <button class="btn btn-primary" type="submit" data-inspect-button>{copy.inspect}</button>
        </div>
        <div class="market-alert" hidden data-inspect-error></div>
      </form>

      <form class="market-form-card" hidden data-upload-publish>
        <h3>{copy.stepPublish}</h3>
        <div class="market-package-summary" data-package-summary></div>
        <p class="market-field-hint market-package-metadata-note">{copy.metadataFromPackage}</p>
        <div class="market-publication-preview" data-publication-preview></div>
        <div class="market-form-actions">
          <button class="btn btn-primary" type="submit" data-publish-button>{copy.publish}</button>
          <button class="btn btn-ghost" type="button" data-replace-archive>{copy.replaceArchive}</button>
        </div>
        <div class="market-alert" hidden data-publish-message></div>
      </form>
    </div>
  </div>
</dialog>

<script>
  import { localizedApiError } from '../i18n/api-errors'

  type Resource = { displayName: string; resource: Record<string, unknown> }
  type Publication = {
    primaryResource: Record<string, unknown>
    title: string
    summary: string
    tags: string[]
    readmeMarkdown: string
    changelog: string
  }
  type Preview = {
    uploadId: string
    packageId: string
    version: string
    archiveLength: number
    availablePrimaryResources: Resource[]
    publication: Publication
  }
  type Submission = { submissionId: string; status: 'pending' }

  const root = document.querySelector<HTMLDialogElement>('[data-market-upload]')
  if (root) {
    const apiBase = root.dataset.apiBase || '/api/market/v1'
    const copy = JSON.parse(root.dataset.copy || '{}') as Record<string, string>
    const locale = root.dataset.locale === 'en' ? 'en' : 'zh-CN'
    const inspectForm = root.querySelector<HTMLFormElement>('[data-upload-inspect]')!
    const publishForm = root.querySelector<HTMLFormElement>('[data-upload-publish]')!
    const inspectButton = root.querySelector<HTMLButtonElement>('[data-inspect-button]')!
    const publishButton = root.querySelector<HTMLButtonElement>('[data-publish-button]')!
    const inspectError = root.querySelector<HTMLElement>('[data-inspect-error]')!
    const publishMessage = root.querySelector<HTMLElement>('[data-publish-message]')!
    const packageSummary = root.querySelector<HTMLElement>('[data-package-summary]')!
    const publicationPreview = root.querySelector<HTMLElement>('[data-publication-preview]')!
    let preview: Preview | null = null
    let requestedOpen = false

    function openDialog(): void {
      if (!root.open) root.showModal()
    }

    function requestOpen(): void {
      requestedOpen = true
      if (document.documentElement.dataset.marketAuth === 'authenticated') {
        requestedOpen = false
        openDialog()
      } else {
        window.dispatchEvent(new CustomEvent('market-auth-required'))
      }
    }

    document.querySelectorAll<HTMLElement>('[data-market-upload-open]').forEach((button) => {
      button.addEventListener('click', requestOpen)
    })
    window.addEventListener('market-auth-changed', ((event: CustomEvent<{ user?: unknown }>) => {
      if (requestedOpen && event.detail.user) {
        requestedOpen = false
        openDialog()
      }
      if (!event.detail.user && root.open) root.close()
    }) as EventListener)
    root.querySelector<HTMLElement>('[data-upload-close]')?.addEventListener('click', () => root.close())
    root.addEventListener('click', (event) => {
      if (event.target === root) root.close()
    })
    const pageUrl = new URL(window.location.href)
    if (pageUrl.searchParams.get('upload') === '1') {
      requestOpen()
      pageUrl.searchParams.delete('upload')
      window.history.replaceState(window.history.state, '', pageUrl)
    }

    async function errorMessage(response: Response): Promise<string> {
      return localizedApiError(response, locale, copy.unavailable)
    }

    function resetMessage(element: HTMLElement): void {
      element.hidden = true
      element.classList.remove('market-success')
      element.replaceChildren()
    }

    function renderPreview(value: Preview): void {
      packageSummary.replaceChildren()
      const fields = [
        `${copy.package}: ${value.packageId}`,
        `${copy.version}: ${value.version}`,
        `${new Intl.NumberFormat().format(value.archiveLength)} bytes`,
      ]
      fields.forEach((field) => {
        const span = document.createElement('span')
        span.textContent = field
        packageSummary.append(span)
      })
      renderPublication(value)
      publishForm.hidden = false
      publishForm.scrollIntoView({ behavior: 'smooth', block: 'start' })
    }

    function renderPublication(value: Preview): void {
      const publication = value.publication
      const resource = value.availablePrimaryResources.find(
        (candidate) =>
          JSON.stringify(candidate.resource) === JSON.stringify(publication.primaryResource),
      )
      publicationPreview.replaceChildren()
      const heading = document.createElement('div')
      heading.className = 'market-publication-heading'
      const title = document.createElement('h4')
      title.textContent = publication.title
      const summary = document.createElement('p')
      summary.textContent = publication.summary
      heading.append(title, summary)

      const facts = document.createElement('dl')
      facts.className = 'market-publication-facts'
      ;[
        [copy.primaryResource, resource?.displayName || copy.unavailable],
        [copy.tagsLabel, publication.tags.join(', ') || '—'],
      ].forEach(([term, description]) => {
        const dt = document.createElement('dt')
        dt.textContent = term
        const dd = document.createElement('dd')
        dd.textContent = description
        facts.append(dt, dd)
      })
      publicationPreview.append(heading, facts)
      appendMarkdownPreview(copy.readmeLabel, publication.readmeMarkdown)
      appendMarkdownPreview(copy.changelogLabel, publication.changelog)
    }

    function appendMarkdownPreview(label: string, content: string): void {
      if (!content) return
      const details = document.createElement('details')
      details.className = 'market-markdown-preview'
      const summary = document.createElement('summary')
      summary.textContent = label
      const pre = document.createElement('pre')
      pre.textContent = content
      details.append(summary, pre)
      publicationPreview.append(details)
    }

    inspectForm.addEventListener('submit', async (event) => {
      event.preventDefault()
      resetMessage(inspectError)
      const input = inspectForm.elements.namedItem('archive') as HTMLInputElement
      const file = input.files?.[0]
      if (!file) return
      inspectButton.disabled = true
      inspectButton.textContent = copy.inspecting
      try {
        const body = new FormData()
        body.set('archive', file, file.name)
        const response = await fetch(`${apiBase}/uploads`, { method: 'POST', body })
        if (response.status === 401) window.dispatchEvent(new CustomEvent('market-auth-required'))
        if (!response.ok) throw new Error(await errorMessage(response))
        preview = (await response.json()) as Preview
        renderPreview(preview)
      } catch (error) {
        inspectError.textContent = error instanceof Error ? error.message : copy.unavailable
        inspectError.hidden = false
      } finally {
        inspectButton.disabled = false
        inspectButton.textContent = copy.inspect
      }
    })

    publishForm.addEventListener('submit', async (event) => {
      event.preventDefault()
      resetMessage(publishMessage)
      if (!preview) {
        publishMessage.textContent = copy.required
        publishMessage.hidden = false
        return
      }
      publishButton.disabled = true
      publishButton.textContent = copy.publishing
      try {
        const response = await fetch(`${apiBase}/uploads/${encodeURIComponent(preview.uploadId)}/publish`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(preview.publication),
        })
        if (!response.ok) throw new Error(await errorMessage(response))
        await response.json() as Submission
        publishMessage.classList.add('market-success')
        publishMessage.textContent = copy.publishedSuccess
        publishMessage.hidden = false
        window.dispatchEvent(new CustomEvent('market-submission-created'))
      } catch (error) {
        publishMessage.textContent = error instanceof Error ? error.message : copy.unavailable
        publishMessage.hidden = false
      } finally {
        publishButton.disabled = false
        publishButton.textContent = copy.publish
      }
    })

    root.querySelector<HTMLButtonElement>('[data-replace-archive]')?.addEventListener('click', () => {
      preview = null
      publishForm.hidden = true
      publishForm.reset()
      inspectForm.reset()
      inspectForm.scrollIntoView({ behavior: 'smooth', block: 'start' })
    })
  }
</script>
