---
import type { Locale } from '../i18n/ui'
import { t } from '../i18n/utils'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<section class="section" id="features">
  <div class="container">
    <div class="section-head reveal">
      <p class="section-tag">{t(locale, 'features.tag')}</p>
      <h2 class="section-title">{t(locale, 'features.title')}</h2>
      <p class="section-desc">{t(locale, 'features.desc')}</p>
    </div>

    <div class="bento">
      <article class="card card-lg reveal" style="--reveal-delay: 0s">
        <span class="card-icon">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
            <ellipse cx="12" cy="5.5" rx="7.5" ry="2.8"></ellipse>
            <path d="M4.5 5.5v13c0 1.55 3.36 2.8 7.5 2.8s7.5-1.25 7.5-2.8v-13"></path>
            <path d="M4.5 12c0 1.55 3.36 2.8 7.5 2.8s7.5-1.25 7.5-2.8"></path>
          </svg>
        </span>
        <h3>{t(locale, 'features.durable.title')}</h3>
        <p>{t(locale, 'features.durable.desc')}</p>
        <div class="card-visual log-visual" aria-hidden="true">
          <span class="log-line"><i class="log-key">event</i> run_accepted <i class="log-ok">persisted</i></span>
          <span class="log-line"><i class="log-key">event</i> tool_call · idempotency:a91f <i class="log-ok">persisted</i></span>
          <span class="log-line"><i class="log-key">event</i> daemon_restart → replay <i class="log-cyan">recovered</i></span>
        </div>
      </article>

      <article class="card card-lg reveal" style="--reveal-delay: 0.08s">
        <span class="card-icon">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2 4 5v6c0 5 3.4 8.7 8 10.5 4.6-1.8 8-5.5 8-10.5V5z"></path>
            <path d="m8.8 12 2.2 2.2 4.2-4.4"></path>
          </svg>
        </span>
        <h3>{t(locale, 'features.controlled.title')}</h3>
        <p>{t(locale, 'features.controlled.desc')}</p>
        <div class="card-visual mode-visual" aria-hidden="true">
          <span class="mode-chip">{t(locale, 'features.mode.safe')}</span>
          <span class="mode-chip is-active">{t(locale, 'features.mode.standard')}</span>
          <span class="mode-chip">{t(locale, 'features.mode.full')}</span>
          <span class="mode-chip">{t(locale, 'features.mode.custom')}</span>
        </div>
      </article>

      <article class="card reveal" style="--reveal-delay: 0s">
        <span class="card-icon">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
            <rect x="3" y="4" width="18" height="16" rx="2"></rect>
            <path d="M3 9h18M9 9v11"></path>
          </svg>
        </span>
        <h3>{t(locale, 'features.inspectable.title')}</h3>
        <p>{t(locale, 'features.inspectable.desc')}</p>
      </article>

      <article class="card reveal" style="--reveal-delay: 0.06s">
        <span class="card-icon">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 4h-.5A2.5 2.5 0 0 0 7 6.5V9a3 3 0 0 1-3 3 3 3 0 0 1 3 3v2.5A2.5 2.5 0 0 0 9.5 20h.5M14 4h.5A2.5 2.5 0 0 1 17 6.5V9a3 3 0 0 0 3 3 3 3 0 0 0-3 3v2.5a2.5 2.5 0 0 1-2.5 2.5H14"></path>
          </svg>
        </span>
        <h3>{t(locale, 'features.extensible.title')}</h3>
        <p>{t(locale, 'features.extensible.desc')}</p>
      </article>

      <article class="card reveal" style="--reveal-delay: 0.12s">
        <span class="card-icon">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
            <circle cx="12" cy="6" r="3"></circle>
            <circle cx="5" cy="18" r="3"></circle>
            <circle cx="19" cy="18" r="3"></circle>
            <path d="M12 9v3m0 0-5 3.5M12 12l5 3.5"></path>
          </svg>
        </span>
        <h3>{t(locale, 'features.orchestration.title')}</h3>
        <p>{t(locale, 'features.orchestration.desc')}</p>
      </article>

      <article class="card reveal" style="--reveal-delay: 0.18s">
        <span class="card-icon">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="m8 7-5 5 5 5M16 7l5 5-5 5M13.5 4l-3 16"></path>
          </svg>
        </span>
        <h3>{t(locale, 'features.sdk.title')}</h3>
        <p>{t(locale, 'features.sdk.desc')}</p>
      </article>

      <article class="card reveal" style="--reveal-delay: 0.24s">
        <span class="card-icon">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
            <rect x="3" y="4" width="18" height="13" rx="2"></rect>
            <path d="M8 21h8m-4-4v4"></path>
          </svg>
        </span>
        <h3>{t(locale, 'features.desktop.title')}</h3>
        <p>{t(locale, 'features.desktop.desc')}</p>
      </article>

      <article class="card reveal" style="--reveal-delay: 0.3s">
        <span class="card-icon">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M3 12h18M12 3c2.5 2.6 3.8 5.7 3.8 9S14.5 18.4 12 21c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3Z"></path>
          </svg>
        </span>
        <h3>{t(locale, 'features.i18n.title')}</h3>
        <p>{t(locale, 'features.i18n.desc')}</p>
      </article>
    </div>
  </div>
</section>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
  }

  .card {
    grid-column: span 2;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--ghost-bg-hover), var(--ghost-bg));
    padding: 26px;
    display: flex;
    flex-direction: column;
    transition: border-color 0.25s, background 0.25s, transform 0.25s var(--ease-out);
  }

  .card:hover {
    border-color: var(--accent-ring);
    transform: translateY(-3px);
  }

  .card-lg {
    grid-column: span 3;
  }

  .card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    color: var(--accent-bright);
    background: var(--accent-soft);
    border: 1px solid var(--accent-ring);
    margin-bottom: 18px;
  }

  .card h3 {
    font-size: 1.08rem;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .card p {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .card-visual {
    margin-top: auto;
    padding-top: 22px;
  }

  .log-visual {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .log-line {
    display: flex;
    gap: 8px;
    align-items: center;
    padding: 6px 10px;
    border-radius: 6px;
    background: var(--ghost-bg);
    border: 1px solid var(--border);
    color: var(--fg-muted);
  }

  .log-key {
    font-style: normal;
    color: var(--fg-faint);
  }

  .log-ok {
    font-style: normal;
    margin-left: auto;
    color: var(--success);
  }

  .log-cyan {
    font-style: normal;
    margin-left: auto;
    color: var(--accent-bright);
  }

  .mode-visual {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .mode-chip {
    font-size: 0.78rem;
    padding: 5px 14px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    color: var(--fg-muted);
  }

  .mode-chip.is-active {
    border-color: color-mix(in srgb, var(--amber) 50%, transparent);
    background: var(--amber-soft);
    color: var(--amber);
  }

  @media (max-width: 980px) {
    .card,
    .card-lg {
      grid-column: span 3;
    }
  }

  @media (max-width: 640px) {
    .card,
    .card-lg {
      grid-column: span 6;
    }
  }
</style>
