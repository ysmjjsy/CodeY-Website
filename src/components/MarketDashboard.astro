---
import { dashboardCopy } from '../i18n/dashboard'
import type { Locale } from '../i18n/ui'
import { marketPath } from '../i18n/utils'
import MarketUpload from './MarketUpload.astro'
import Button from './ui/Button.astro'
import Dialog from './ui/Dialog.astro'
import List from './ui/List.astro'
import PageHeader from './ui/PageHeader.astro'
import Pagination from './ui/Pagination.astro'
import StateMessage from './ui/StateMessage.astro'

interface Props {
  locale: Locale
  initialSection?: 'templates' | 'review'
}

const { locale, initialSection = 'templates' } = Astro.props
const copy = dashboardCopy(locale)
const isReview = initialSection === 'review'
---

<section
  class="dashboard-content"
  data-market-dashboard
  data-copy={JSON.stringify(copy)}
  data-locale={locale}
  data-initial-section={initialSection}
  data-detail-base={marketPath(locale, 'item')}
>
  <PageHeader
    class="dashboard-header"
    eyebrow={isReview ? copy.reviewWorkspace : copy.templateLibrary}
    eyebrowClass="dashboard-eyebrow"
    title={isReview ? copy.reviewTitle : copy.title}
    description={isReview ? copy.reviewDescription : copy.description}
  >
    <Fragment slot="actions">{
      isReview ? (
        <div class="dashboard-review-tabs" role="tablist" aria-label={copy.reviewTitle}>
          <button type="button" role="tab" aria-selected="true" class="is-active" data-review-view="history">
            <i class="ph ph-clock-counter-clockwise" aria-hidden="true"></i>
            <span>{copy.reviewHistory}</span>
          </button>
          <button type="button" role="tab" aria-selected="false" data-review-view="pending">
            <i class="ph ph-inbox" aria-hidden="true"></i>
            <span>{copy.pendingApplications}</span>
            <strong data-review-count>0</strong>
          </button>
        </div>
      ) : (
        <Button class="dashboard-upload" variant="primary" hidden data-authenticated-only data-market-upload-open>
          <i class="ph ph-upload-simple" aria-hidden="true"></i>
          {copy.upload}
        </Button>
      )
    }</Fragment>
  </PageHeader>

  <StateMessage as="div" class="dashboard-access" data-dashboard-access>{copy.loading}</StateMessage>

  {
    !isReview && (
      <section class="dashboard-section" hidden data-dashboard-section="templates">
        <div class="dashboard-summary" aria-label={copy.status}>
          <div class="dashboard-summary-primary">
            <span>{copy.total}</span>
            <strong data-stat="total">0</strong>
          </div>
          <div><span class="dashboard-dot is-pending"></span><span>{copy.pending}</span><strong data-stat="pending">0</strong></div>
          <div><span class="dashboard-dot is-approved"></span><span>{copy.approved}</span><strong data-stat="approved">0</strong></div>
          <div><span class="dashboard-dot is-rejected"></span><span>{copy.rejected}</span><strong data-stat="rejected">0</strong></div>
        </div>

        <List class="dashboard-panel">
          <div class="dashboard-panel-head">
            <div>
              <h2>{copy.templateList}</h2>
              <p>{copy.templateListDescription}</p>
            </div>
            <span data-template-result-count></span>
          </div>
          <div class="dashboard-table-wrap">
            <table class="dashboard-table dashboard-template-table">
              <thead>
                <tr>
                  <th>{copy.name}</th>
                  <th>{copy.latestVersion}</th>
                  <th>{copy.status}</th>
                  <th>{copy.submittedAt}</th>
                  <th><span class="sr-only">{copy.actions}</span></th>
                </tr>
              </thead>
              <tbody data-template-rows></tbody>
            </table>
          </div>
          <div slot="empty" class="dashboard-empty" hidden data-template-state></div>
          <Pagination slot="footer" locale={locale} pageSize={10} pageSizeOptions={[10, 20, 50]} data-template-pagination />
        </List>
      </section>
    )
  }

  {
    isReview && (
      <section class="dashboard-section" hidden data-dashboard-section="review">
        <div data-review-panel="history">
          <div class="dashboard-section-heading">
            <div><h2>{copy.reviewHistory}</h2><p>{copy.reviewHistoryDescription}</p></div>
            <span data-review-history-count></span>
          </div>
          <List class="dashboard-panel">
            <div class="dashboard-table-wrap">
              <table class="dashboard-table dashboard-review-table">
                <thead>
                  <tr>
                    <th>{copy.name}</th>
                    <th>{copy.uploader}</th>
                    <th>{copy.result}</th>
                    <th>{copy.reviewer}</th>
                    <th>{copy.reviewedAt}</th>
                    <th>{copy.reviewNote}</th>
                  </tr>
                </thead>
                <tbody data-review-history-rows></tbody>
              </table>
            </div>
            <div slot="empty" class="dashboard-empty" data-review-history-state>{copy.reviewLoading}</div>
            <Pagination slot="footer" locale={locale} pageSize={10} pageSizeOptions={[10, 20, 50]} data-review-history-pagination />
          </List>
        </div>

        <div hidden data-review-panel="pending">
          <div class="dashboard-section-heading">
            <div><h2>{copy.pendingApplications}</h2><p>{copy.pendingApplicationsDescription}</p></div>
          </div>
          <List class="dashboard-panel">
            <div class="dashboard-table-wrap">
              <table class="dashboard-table dashboard-pending-table">
                <thead>
                  <tr>
                    <th>{copy.name}</th>
                    <th>{copy.uploader}</th>
                    <th>{copy.packageVersion}</th>
                    <th>{copy.submittedAt}</th>
                    <th>{copy.actions}</th>
                  </tr>
                </thead>
                <tbody data-review-pending-rows></tbody>
              </table>
            </div>
            <div slot="empty" class="dashboard-empty" data-review-pending-state>{copy.reviewLoading}</div>
            <Pagination slot="footer" locale={locale} pageSize={10} pageSizeOptions={[10, 20, 50]} data-review-pending-pagination />
          </List>
        </div>

        <Dialog class="dashboard-review-dialog" data-review-dialog aria-labelledby="dashboard-review-dialog-title">
          <div class="dashboard-review-dialog-content">
            <header>
              <div>
                <p class="dashboard-eyebrow">{copy.reviewApplication}</p>
                <h2 id="dashboard-review-dialog-title" data-review-dialog-title></h2>
                <p data-review-dialog-summary></p>
              </div>
              <button type="button" class="dashboard-dialog-close" data-review-close aria-label={copy.close}>
                <i class="ph ph-x" aria-hidden="true"></i>
              </button>
            </header>
            <dl class="dashboard-review-detail" data-review-detail></dl>
            <label class="dashboard-review-note">
              <span>{copy.decisionNote}</span>
              <textarea maxlength="1000" data-review-note></textarea>
            </label>
            <div class="dashboard-review-actions">
              <Button data-review-decision="reject">{copy.reject}</Button>
              <Button variant="primary" data-review-decision="approve">{copy.approve}</Button>
            </div>
          </div>
        </Dialog>
      </section>
    )
  }
</section>

{!isReview && <MarketUpload locale={locale} />}

<script>
  import { initMarketDashboard } from '../lib/market-dashboard.ts'
  initMarketDashboard()
</script>

<style is:global>
  .dashboard-content { min-width: 0; }
  .dashboard-header { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-28); margin-bottom: var(--space-28); }
  .dashboard-header h1 { margin: var(--space-5) 0 0; }
  .dashboard-header > div:first-child > p:last-child { max-width: 680px; margin: var(--space-10) 0 0; color: var(--fg-muted); font-size: .9rem; line-height: 1.65; }
  .dashboard-eyebrow { margin: 0; color: var(--accent-bright); font-size: .7rem; font-weight: 600; letter-spacing: .09em; text-transform: uppercase; }
  .dashboard-upload { min-height: 42px; gap: var(--space-8); padding-inline: var(--space-17); }
  .dashboard-access, .dashboard-empty { padding: var(--space-54) var(--space-24); color: var(--fg-muted); text-align: center; }
  .dashboard-access { border: 1px dashed var(--border-strong); border-radius: var(--radius-lg); background: var(--panel-glass); }
  .dashboard-summary { display: flex; align-items: stretch; margin-bottom: var(--space-16); overflow: hidden; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--panel-glass); box-shadow: inset 0 1px 0 var(--panel-inset); }
  .dashboard-summary > div { display: flex; min-width: 0; align-items: center; gap: var(--space-8); padding: var(--space-15) var(--space-18); border-left: 1px solid var(--border); }
  .dashboard-summary > div:first-child { border-left: 0; }
  .dashboard-summary-primary { margin-right: auto; }
  .dashboard-summary span { color: var(--fg-faint); font-size: .75rem; }
  .dashboard-summary strong { color: var(--fg); font: 600 .88rem var(--font-mono); }
  .dashboard-summary-primary strong { order: -1; font-size: 1.35rem; }
  .dashboard-dot { width: 7px; height: 7px; flex: 0 0 auto; border-radius: 50%; background: var(--fg-faint); }
  .dashboard-dot.is-pending { background: var(--accent-bright); }
  .dashboard-dot.is-approved { background: var(--success); }
  .dashboard-dot.is-rejected { background: var(--danger); }
  .dashboard-panel { overflow: hidden; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--panel-glass); box-shadow: inset 0 1px 0 var(--panel-inset); }
  .dashboard-panel-head, .dashboard-section-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--space-20); }
  .dashboard-panel-head { padding: var(--space-19) var(--space-21); border-bottom: 1px solid var(--border); }
  .dashboard-section-heading { margin: 0 0 var(--space-15); }
  .dashboard-panel-head h2, .dashboard-section-heading h2 { margin: 0; font-size: 1rem; }
  .dashboard-panel-head p, .dashboard-section-heading p { margin: var(--space-5) 0 0; color: var(--fg-faint); font-size: .76rem; }
  .dashboard-panel-head > span, .dashboard-section-heading > span { color: var(--fg-faint); font: .72rem var(--font-mono); white-space: nowrap; }
  .dashboard-table-wrap { overflow-x: auto; }
  .dashboard-table { width: 100%; min-width: 820px; border-collapse: collapse; font-size: .79rem; }
  .dashboard-review-table { min-width: 960px; }
  .dashboard-table th { padding: var(--space-11) var(--space-18); border-bottom: 1px solid var(--border); color: var(--fg-faint); background: var(--chip-bg); font-size: .7rem; font-weight: 600; text-align: left; white-space: nowrap; }
  .dashboard-table td { padding: var(--space-16) var(--space-18); border-bottom: 1px solid var(--border); color: var(--fg-muted); vertical-align: middle; }
  .dashboard-table tbody tr:last-child td { border-bottom: 0; }
  .dashboard-table tbody tr:hover { background: var(--ghost-bg); }
  .dashboard-template-table th:first-child { width: 48%; }
  .dashboard-review-table th:first-child, .dashboard-pending-table th:first-child { width: 34%; }
  .dashboard-template-cell { display: flex; min-width: 250px; align-items: center; gap: var(--space-12); }
  .dashboard-template-mark { display: grid; width: 40px; height: 40px; flex: 0 0 auto; place-items: center; border: 1px solid var(--border); border-radius: var(--radius-md); color: var(--accent-bright); background: var(--accent-soft); font-size: 1rem; }
  .dashboard-template-cell > div { display: grid; min-width: 0; gap: var(--space-3); }
  .dashboard-template-cell strong, .dashboard-table td > strong { color: var(--fg); font-size: .82rem; font-weight: 600; }
  .dashboard-template-cell span, .dashboard-table td > span:not(.dashboard-status) { display: block; color: var(--fg-faint); font-size: .72rem; }
  .dashboard-template-summary { max-width: 460px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dashboard-template-cell code { overflow: hidden; color: var(--fg-faint); font: .66rem var(--font-mono); text-overflow: ellipsis; white-space: nowrap; }
  .dashboard-template-table td:nth-child(2) { white-space: nowrap; }
  .dashboard-template-table td:nth-child(2) strong { display: block; margin-bottom: var(--space-4); }
  .dashboard-template-table td:nth-child(2) span { color: var(--fg-faint); font-size: .68rem; }
  .dashboard-status { display: inline-flex; align-items: center; padding: var(--space-5) var(--space-9); border: 1px solid var(--border); border-radius: var(--radius-pill); font: .67rem var(--font-mono); white-space: nowrap; }
  .dashboard-status.is-pending { border-color: color-mix(in srgb, var(--accent) 25%, var(--border)); color: var(--accent-bright); background: var(--accent-soft); }
  .dashboard-status.is-approved { color: var(--success); background: color-mix(in srgb, var(--success) 9%, transparent); }
  .dashboard-status.is-rejected { color: var(--danger); background: color-mix(in srgb, var(--danger) 9%, transparent); }
  .dashboard-actions-cell { text-align: right; }
  .dashboard-row-action { display: inline-flex; align-items: center; gap: var(--space-5); color: var(--accent-bright); font-size: .75rem; font-weight: 600; }
  .dashboard-row-action i { font-size: .85rem; }
  .dashboard-mono { max-width: 250px; font-family: var(--font-mono); font-size: .68rem; overflow-wrap: anywhere; }
  .dashboard-review-note-cell { max-width: 280px; line-height: 1.55; }
  .dashboard-review-tabs { display: inline-flex; gap: var(--space-4); padding: var(--space-4); border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--chip-bg); }
  .dashboard-review-tabs button { display: inline-flex; min-height: 36px; align-items: center; gap: var(--space-7); padding: var(--space-7) var(--space-10); border: 0; border-radius: var(--radius-md); color: var(--fg-faint); background: transparent; font: 500 .76rem var(--font-body); cursor: pointer; }
  .dashboard-review-tabs button:hover, .dashboard-review-tabs button.is-active { color: var(--fg); background: var(--panel-glass); box-shadow: 0 1px 3px rgb(0 0 0 / .08); }
  .dashboard-review-tabs strong { display: inline-grid; min-width: 20px; height: 20px; place-items: center; padding: 0 var(--space-5); border-radius: var(--radius-pill); color: var(--btn-primary-fg); background: var(--accent); font: 600 .65rem var(--font-mono); }
  .dashboard-review-button { min-height: 34px; gap: var(--space-6); padding: var(--space-7) var(--space-10); font-size: .72rem; white-space: nowrap; }
  .dashboard-review-dialog { width: min(720px, calc(100vw - 32px)); max-width: none; max-height: calc(100vh - 32px); margin: auto; padding: 0; overflow: hidden; border: 1px solid var(--border-strong); border-radius: var(--radius-lg); color: var(--fg); background: var(--bg); box-shadow: 0 24px 80px rgb(0 0 0 / .28); }
  .dashboard-review-dialog::backdrop { background: rgb(9 12 22 / .68); backdrop-filter: blur(5px); }
  .dashboard-review-dialog-content { max-height: inherit; padding: var(--space-26); overflow-y: auto; }
  .dashboard-review-dialog header { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-22); }
  .dashboard-review-dialog h2 { margin: var(--space-5) 0 0; font-size: 1.35rem; }
  .dashboard-review-dialog header p:last-child { margin: var(--space-7) 0 0; color: var(--fg-muted); font-size: .82rem; line-height: 1.55; }
  .dashboard-dialog-close { display: grid; width: 34px; height: 34px; flex: 0 0 auto; place-items: center; padding: 0; border: 1px solid var(--border); border-radius: 50%; color: var(--fg-muted); background: var(--panel-glass); cursor: pointer; }
  .dashboard-review-detail { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0; margin: var(--space-22) 0; overflow: hidden; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--chip-bg); }
  .dashboard-review-detail div { min-width: 0; padding: var(--space-13) var(--space-15); border-top: 1px solid var(--border); }
  .dashboard-review-detail div:nth-child(-n + 2) { border-top: 0; }
  .dashboard-review-detail div:nth-child(even) { border-left: 1px solid var(--border); }
  .dashboard-review-detail dt { color: var(--fg-faint); font-size: .67rem; }
  .dashboard-review-detail dd { margin: var(--space-5) 0 0; color: var(--fg-muted); font: .72rem/1.5 var(--font-mono); overflow-wrap: anywhere; }
  .dashboard-review-note { display: grid; gap: var(--space-8); color: var(--fg); font-size: .76rem; font-weight: 600; }
  .dashboard-review-note textarea { min-height: 92px; padding: var(--space-11) var(--space-12); resize: vertical; }
  .dashboard-review-actions { display: flex; justify-content: flex-end; gap: var(--space-10); margin-top: var(--space-18); }
  .dashboard-panel .dashboard-empty { border: 0; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  /* The `hidden` attribute is overridden by component display rules such as
   * `.btn { display: inline-flex }`, which beat the UA `[hidden]` rule. Doubling
   * the attribute selector gives (0,2,0) so it wins on specificity alone; this
   * matches the idiom in `src/styles/market-shared.css`. */
  [hidden][hidden] { display: none; }
  @media (max-width: 760px) {
    .dashboard-header { align-items: stretch; flex-direction: column; }
    .dashboard-upload { justify-content: center; }
    .dashboard-review-tabs { align-self: stretch; }
    .dashboard-review-tabs button { flex: 1; justify-content: center; }
    .dashboard-summary { display: grid; grid-template-columns: repeat(3, 1fr); }
    .dashboard-summary-primary { grid-column: 1 / -1; margin-right: 0; border-bottom: 1px solid var(--border); }
    .dashboard-summary > div:nth-child(2) { border-left: 0; }
    .dashboard-review-detail { grid-template-columns: 1fr; }
    .dashboard-review-detail div:nth-child(n) { border-top: 1px solid var(--border); border-left: 0; }
    .dashboard-review-detail div:first-child { border-top: 0; }
  }
</style>
