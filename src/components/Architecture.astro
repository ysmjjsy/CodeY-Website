---
import type { Locale } from '../i18n/ui'
import { t } from '../i18n/utils'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<section class="section arch-section" id="architecture">
  <div class="container">
    <div class="section-head reveal">
      <p class="section-tag">{t(locale, 'arch.tag')}</p>
      <h2 class="section-title">{t(locale, 'arch.title')}</h2>
      <p class="section-desc">{t(locale, 'arch.desc')}</p>
    </div>

    <div class="diagram reveal" role="img" aria-label={t(locale, 'arch.aria')}>
      <div class="tier tier-clients">
        <div class="node node-client">
          <span class="node-title">{t(locale, 'arch.ui')}</span>
          <span class="node-sub">{t(locale, 'arch.ui.sub')}</span>
        </div>
        <div class="node node-client">
          <span class="node-title">{t(locale, 'arch.ts')}</span>
          <span class="node-sub">@codey/agent-sdk</span>
        </div>
        <div class="node node-client">
          <span class="node-title">{t(locale, 'arch.py')}</span>
          <span class="node-sub">codey_agent_sdk</span>
        </div>
        <div class="node node-client">
          <span class="node-title">{t(locale, 'arch.rs')}</span>
          <span class="node-sub">codey-agent-client</span>
        </div>
      </div>

      <div class="connector">
        <span class="connector-label">{t(locale, 'arch.ipc')}</span>
      </div>

      <div class="tier">
        <div class="node node-daemon">
          <div class="daemon-main">
            <span class="node-title">{t(locale, 'arch.daemon')}</span>
            <span class="node-sub">{t(locale, 'arch.daemon.sub')}</span>
          </div>
          <div class="daemon-store">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6">
              <ellipse cx="12" cy="6" rx="7" ry="2.6"></ellipse>
              <path d="M5 6v12c0 1.44 3.13 2.6 7 2.6s7-1.16 7-2.6V6"></path>
            </svg>
            {t(locale, 'arch.store')}
          </div>
        </div>
      </div>

      <div class="connector">
        <span class="connector-label">Agent Harness</span>
      </div>

      <div class="tier tier-caps">
        <span class="cap">{t(locale, 'arch.cap.models')}</span>
        <span class="cap">{t(locale, 'arch.cap.tools')}</span>
        <span class="cap">{t(locale, 'arch.cap.ext')}</span>
        <span class="cap">{t(locale, 'arch.cap.memory')}</span>
        <span class="cap">{t(locale, 'arch.cap.agents')}</span>
      </div>
    </div>

    <ul class="arch-notes reveal">
      <li>{t(locale, 'arch.note1')}</li>
      <li>{t(locale, 'arch.note2')}</li>
      <li>{t(locale, 'arch.note3')}</li>
    </ul>
  </div>
</section>

<style>
  .arch-section {
    background: var(--bg-soft);
    border-block: 1px solid var(--border);
  }

  .diagram {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  .tier {
    display: flex;
    justify-content: center;
    gap: 14px;
  }

  .tier-clients {
    flex-wrap: wrap;
  }

  .node {
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--surface);
    padding: 14px 20px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .node-client {
    flex: 1 1 0;
    min-width: 150px;
  }

  .node-title {
    font-weight: 600;
    font-size: 0.92rem;
  }

  .node-sub {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--fg-faint);
  }

  .connector {
    display: flex;
    justify-content: center;
    position: relative;
    padding: 26px 0;
  }

  .connector::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--accent) 10%, transparent),
      color-mix(in srgb, var(--accent) 60%, transparent),
      color-mix(in srgb, var(--accent) 10%, transparent)
    );
  }

  .connector-label {
    position: relative;
    align-self: center;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent-bright);
    background: var(--bg-soft);
    border: 1px solid var(--accent-ring);
    border-radius: 999px;
    padding: 4px 14px;
  }

  .node-daemon {
    flex-direction: row;
    align-items: center;
    gap: 24px;
    padding: 20px 28px;
    border-color: var(--accent-ring);
    background: linear-gradient(180deg, var(--accent-soft), transparent);
    box-shadow: 0 0 40px var(--accent-glow);
  }

  .daemon-main {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: left;
  }

  .daemon-main .node-title {
    font-size: 1.05rem;
  }

  .daemon-main .node-sub {
    color: var(--fg-muted);
    font-size: 0.78rem;
  }

  .daemon-store {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--fg-muted);
    border: 1px dashed var(--border-strong);
    border-radius: 8px;
    padding: 10px 14px;
    white-space: nowrap;
  }

  .tier-caps {
    flex-wrap: wrap;
  }

  .cap {
    font-size: 0.84rem;
    color: var(--fg-muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 8px 20px;
    background: var(--surface);
  }

  .arch-notes {
    margin: 48px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
    max-width: 760px;
  }

  .arch-notes li {
    color: var(--fg-muted);
    font-size: 0.92rem;
    padding: 14px 0 14px 26px;
    border-top: 1px solid var(--border);
    position: relative;
  }

  .arch-notes li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 24px;
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: var(--accent);
  }

  @media (max-width: 720px) {
    .node-daemon {
      flex-direction: column;
      gap: 14px;
      text-align: center;
    }

    .daemon-main {
      text-align: center;
    }
  }
</style>
