---
import { profileCopy } from '../i18n/profile'
import type { Locale } from '../i18n/ui'
import { pricingPath } from '../i18n/utils'
import Button from './ui/Button.astro'
import Field from './ui/Field.astro'
import PageHeader from './ui/PageHeader.astro'
import Panel from './ui/Panel.astro'
import StateMessage from './ui/StateMessage.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = profileCopy(locale)
const managePlanHref = pricingPath(locale)
---

<section class="profile-overview" data-profile-overview data-locale={locale} data-copy={JSON.stringify(copy)}>
  <PageHeader title={copy.title} description={copy.description} />

  <StateMessage class="profile-state" data-state>{copy.loading}</StateMessage>

  <div class="profile-content" data-content hidden>
    <Panel as="section" class="profile-hero">
      <span class="profile-avatar" data-avatar aria-hidden="true"></span>
      <div class="profile-heading">
        <strong data-heading-name>—</strong>
        <span data-heading-identity>—</span>
      </div>
      <span class="profile-role" data-heading-role>—</span>
    </Panel>

    <Panel as="section" class="profile-benefits">
      <header class="profile-benefits-head">
        <div>
          <h2>{copy.planSection}</h2>
          <p>{copy.planSectionDescription}</p>
        </div>
        <Button href={managePlanHref} size="sm">
          {copy.managePlan}
          <i class="ph ph-arrow-right" aria-hidden="true"></i>
        </Button>
      </header>

      <StateMessage class="profile-benefits-state" data-benefits-state>{copy.planLoading}</StateMessage>

      <div class="profile-benefits-content" data-benefits-content hidden>
        <div class="profile-plan-summary">
          <span class="profile-plan-icon" aria-hidden="true"><i class="ph ph-crown-simple"></i></span>
          <div class="profile-plan-copy">
            <span>{copy.currentPlan}</span>
            <strong data-current-plan>—</strong>
            <small><span data-plan-period-label>{copy.activeUntil}</span> <time data-plan-period>—</time></small>
          </div>
          <div class="profile-scheduled-plan" data-scheduled-plan-wrap hidden>
            <span>{copy.scheduledPlan}</span>
            <strong data-scheduled-plan>—</strong>
          </div>
        </div>

        <dl class="profile-credit-summary" aria-label={copy.availableCredits}>
          <div class="is-primary"><dt>{copy.availableCredits}</dt><dd><strong data-available-credit>0</strong><span>{copy.creditsUnit}</span></dd></div>
          <div><dt>{copy.planCredits}</dt><dd><strong data-plan-credit>0</strong><span>{copy.creditsUnit}</span></dd></div>
          <div><dt>{copy.permanentCredits}</dt><dd><strong data-permanent-credit>0</strong><span>{copy.creditsUnit}</span></dd></div>
          <div><dt>{copy.reservedCredits}</dt><dd><strong data-reserved-credit>0</strong><span>{copy.creditsUnit}</span></dd></div>
        </dl>
      </div>
    </Panel>

    <div class="profile-grid">
      <Panel as="section" class="profile-editor">
        <header class="profile-section-head">
          <div>
            <h2>{copy.profileSection}</h2>
            <p>{copy.profileSectionDescription}</p>
          </div>
        </header>
        <form data-profile-form>
          <Field label={copy.displayName}>
            <input name="displayName" autocomplete="name" required maxlength="80" />
          </Field>
          <Field label={copy.email} hint={copy.emailHint}>
            <input name="email" type="email" autocomplete="email" maxlength="254" />
          </Field>
          <div class="profile-form-actions">
            <Button variant="primary" type="submit" data-save>{copy.save}</Button>
          </div>
        </form>
      </Panel>

      <div class="profile-side">
        <Panel as="section" class="profile-details">
          <header class="profile-section-head">
            <div>
              <h2>{copy.identitySection}</h2>
              <p>{copy.identitySectionDescription}</p>
            </div>
          </header>
          <dl>
            <div><dt>{copy.username}</dt><dd data-username>—</dd></div>
            <div><dt>{copy.userId}</dt><dd><code data-user-id>—</code></dd></div>
            <div><dt>{copy.role}</dt><dd data-role>—</dd></div>
            <div><dt>{copy.joinedAt}</dt><dd data-created-at>—</dd></div>
          </dl>
        </Panel>

        <Panel as="section" class="profile-connections">
          <header class="profile-section-head">
            <div>
              <h2>{copy.connectionSection}</h2>
              <p>{copy.connectionSectionDescription}</p>
            </div>
          </header>
          <div class="connection-row">
            <span class="connection-icon"><i class="ph ph-github-logo" aria-hidden="true"></i></span>
            <div><strong>{copy.github}</strong><span data-github-login>{copy.notConnected}</span></div>
            <span class="connection-status" data-github-status>{copy.notConnected}</span>
          </div>
        </Panel>
      </div>
    </div>
  </div>
</section>

<script>
  import { localizedApiError } from '../i18n/api-errors'
  import { toast } from '../lib/toast'

  type Role = 'user' | 'admin'
  type User = {
    userId: string
    username: string
    email?: string | null
    displayName: string
    avatarUrl?: string | null
    githubLogin?: string | null
    role: Role
    createdAt: string
  }
  type AuthResponse = { user?: User | null }
  type Plan = { planId: string; displayName: string }
  type PlanCatalog = { plans: Plan[] }
  type CloudAccount = {
    subscription: {
      planId: string
      status: 'active' | 'expired'
      currentPeriodEnd: string
      scheduledPlanId?: string | null
    }
    wallet: {
      availableCreditMicros: number
      reservedCreditMicros: number
      expiringCreditMicros: number
      permanentCreditMicros: number
    }
  }

  const rootEl = document.querySelector<HTMLElement>('[data-profile-overview]')
  if (rootEl) {
    const root = rootEl
    const locale = root.dataset.locale === 'en' ? 'en' : 'zh-CN'
    const copy = JSON.parse(root.dataset.copy || '{}') as Record<string, string>
    const state = root.querySelector<HTMLElement>('[data-state]')!
    const content = root.querySelector<HTMLElement>('[data-content]')!
    const form = root.querySelector<HTMLFormElement>('[data-profile-form]')!
    const save = root.querySelector<HTMLButtonElement>('[data-save]')!
    const benefitsState = root.querySelector<HTMLElement>('[data-benefits-state]')!
    const benefitsContent = root.querySelector<HTMLElement>('[data-benefits-content]')!
    let currentUser: User | null = null
    let benefitsLoading = false

    const field = (name: string): HTMLInputElement => form.elements.namedItem(name) as HTMLInputElement
    const date = (value: string): string => new Intl.DateTimeFormat(locale, { dateStyle: 'long' }).format(new Date(value))
    const dateTime = (value: string): string => new Intl.DateTimeFormat(locale, { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(value))
    const points = (value: number): string => new Intl.NumberFormat(locale, { maximumFractionDigits: 2 }).format(value / 1_000_000)

    function render(user: User): void {
      currentUser = user
      const avatar = root.querySelector<HTMLElement>('[data-avatar]')!
      avatar.textContent = user.displayName.slice(0, 1).toUpperCase()
      avatar.style.backgroundImage = ''
      if (user.avatarUrl) {
        try {
          const url = new URL(user.avatarUrl, window.location.origin)
          if (url.protocol === 'https:') avatar.style.backgroundImage = `url("${url.href}")`
        } catch { /* retain initials for an invalid stored avatar URL */ }
      }
      root.querySelector<HTMLElement>('[data-heading-name]')!.textContent = user.displayName
      root.querySelector<HTMLElement>('[data-heading-identity]')!.textContent = user.email || copy.noEmail
      root.querySelector<HTMLElement>('[data-heading-role]')!.textContent = user.role === 'admin' ? copy.roleAdmin : copy.roleUser
      root.querySelector<HTMLElement>('[data-username]')!.textContent = `@${user.username}`
      root.querySelector<HTMLElement>('[data-user-id]')!.textContent = user.userId
      root.querySelector<HTMLElement>('[data-role]')!.textContent = user.role === 'admin' ? copy.roleAdmin : copy.roleUser
      root.querySelector<HTMLElement>('[data-created-at]')!.textContent = date(user.createdAt)
      const githubLogin = root.querySelector<HTMLElement>('[data-github-login]')!
      const githubStatus = root.querySelector<HTMLElement>('[data-github-status]')!
      githubLogin.textContent = user.githubLogin ? `@${user.githubLogin}` : copy.notConnected
      githubStatus.textContent = user.githubLogin ? copy.connected : copy.notConnected
      githubStatus.classList.toggle('is-connected', Boolean(user.githubLogin))
      field('displayName').value = user.displayName
      field('email').value = user.email || ''
    }

    async function load(): Promise<void> {
      state.hidden = false
      state.textContent = copy.loading
      content.hidden = true
      try {
        const response = await fetch('/api/market/v1/auth/me', { headers: { Accept: 'application/json' } })
        if (!response.ok) throw new Error(await localizedApiError(response, locale, copy.unavailable))
        const payload = await response.json() as AuthResponse
        if (!payload.user) {
          window.dispatchEvent(new CustomEvent('market-auth-required'))
          throw new Error(copy.signIn)
        }
        render(payload.user)
        state.hidden = true
        content.hidden = false
      } catch (reason) {
        toast.error(reason instanceof Error ? reason.message : copy.unavailable)
        const retry = document.createElement('button')
        retry.type = 'button'
        retry.className = 'btn btn-ghost'
        retry.textContent = copy.retry
        retry.onclick = () => void load()
        state.replaceChildren(retry)
      }
    }

    function renderBenefits(account: CloudAccount, catalog: PlanCatalog): void {
      const planById = new Map(catalog.plans.map((plan) => [plan.planId, plan.displayName]))
      root.querySelector<HTMLElement>('[data-current-plan]')!.textContent = planById.get(account.subscription.planId) || account.subscription.planId
      root.querySelector<HTMLElement>('[data-plan-period-label]')!.textContent = account.subscription.status === 'expired' ? copy.expiredAt : copy.activeUntil
      const period = root.querySelector<HTMLTimeElement>('[data-plan-period]')!
      period.dateTime = account.subscription.currentPeriodEnd
      period.textContent = dateTime(account.subscription.currentPeriodEnd)
      root.querySelector<HTMLElement>('[data-available-credit]')!.textContent = points(account.wallet.availableCreditMicros)
      root.querySelector<HTMLElement>('[data-plan-credit]')!.textContent = points(account.wallet.expiringCreditMicros)
      root.querySelector<HTMLElement>('[data-permanent-credit]')!.textContent = points(account.wallet.permanentCreditMicros)
      root.querySelector<HTMLElement>('[data-reserved-credit]')!.textContent = points(account.wallet.reservedCreditMicros)
      const scheduledWrap = root.querySelector<HTMLElement>('[data-scheduled-plan-wrap]')!
      scheduledWrap.hidden = !account.subscription.scheduledPlanId
      root.querySelector<HTMLElement>('[data-scheduled-plan]')!.textContent = planById.get(account.subscription.scheduledPlanId || '') || account.subscription.scheduledPlanId || '—'
    }

    async function loadBenefits(): Promise<void> {
      if (benefitsLoading) return
      benefitsLoading = true
      benefitsState.hidden = false
      benefitsState.textContent = copy.planLoading
      benefitsContent.hidden = true
      try {
        const [accountResponse, plansResponse] = await Promise.all([
          fetch('/api/cloud/v1/me', { headers: { Accept: 'application/json' } }),
          fetch('/api/cloud/v1/plans', { headers: { Accept: 'application/json' } }),
        ])
        if (accountResponse.status === 401) {
          window.dispatchEvent(new CustomEvent('market-auth-required'))
          throw new Error(copy.signIn)
        }
        if (!accountResponse.ok) throw new Error(copy.planUnavailable)
        const account = await accountResponse.json() as CloudAccount
        const catalog = plansResponse.ok ? await plansResponse.json() as PlanCatalog : { plans: [] }
        renderBenefits(account, catalog)
        benefitsState.hidden = true
        benefitsContent.hidden = false
      } catch (reason) {
        const retry = document.createElement('button')
        retry.type = 'button'
        retry.className = 'btn btn-ghost'
        retry.textContent = copy.retry
        retry.onclick = () => void loadBenefits()
        benefitsState.replaceChildren(retry)
        toast.error(reason instanceof Error ? reason.message : copy.planUnavailable)
      } finally {
        benefitsLoading = false
      }
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      if (!currentUser) return
      const original = save.textContent || ''
      save.disabled = true
      save.textContent = copy.saving
      try {
        const response = await fetch('/api/market/v1/account/profile', {
          method: 'POST',
          headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
          body: JSON.stringify({ displayName: field('displayName').value.trim(), email: field('email').value.trim() || null }),
        })
        if (!response.ok) throw new Error(await localizedApiError(response, locale, copy.unavailable))
        const user = await response.json() as User
        render(user)
        window.dispatchEvent(new CustomEvent('market-profile-updated', { detail: { user } }))
        toast.success(copy.saved)
      } catch (reason) {
        toast.error(reason instanceof Error ? reason.message : copy.unavailable)
      } finally {
        save.disabled = false
        save.textContent = original
      }
    })

    window.addEventListener('market-auth-changed', ((event: CustomEvent<AuthResponse>) => {
      if (event.detail.user) {
        render(event.detail.user)
        state.hidden = true
        content.hidden = false
        void loadBenefits()
      } else {
        content.hidden = true
        state.hidden = false
        state.textContent = copy.signIn
      }
    }) as EventListener)
    void load()
    void loadBenefits()
  }
</script>

<style is:global>
  .profile-state {
    display: grid;
    min-height: 156px;
    place-items: center;
    margin-top: var(--space-28);
    padding: var(--space-24);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
    color: var(--fg-muted);
    background: var(--panel-glass);
  }
  .profile-content {
    margin-top: var(--space-28);
  }
  .profile-hero {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-16);
    padding: var(--space-22);
    border: 1px solid color-mix(in srgb, var(--accent) 28%, var(--border));
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--accent) 5%, var(--panel-glass));
  }
  .profile-avatar {
    display: grid;
    width: 58px;
    height: 58px;
    place-items: center;
    border-radius: var(--radius-xl);
    color: var(--btn-primary-fg);
    background: var(--accent);
    background-position: center;
    background-size: cover;
    font-size: var(--text-xl);
    font-weight: 700;
  }
  .profile-heading {
    display: grid;
    min-width: 0;
    gap: var(--space-5);
  }
  .profile-heading strong {
    overflow: hidden;
    color: var(--fg);
    font-size: var(--text-xl);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .profile-heading span {
    overflow: hidden;
    color: var(--fg-muted);
    font-size: var(--text-xs);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .profile-role {
    padding: var(--space-6) var(--space-10);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--fg-muted);
    background: var(--bg);
    font-size: var(--text-2xs);
    font-weight: 600;
    white-space: nowrap;
  }
  .profile-benefits {
    margin-top: var(--space-14);
    padding: var(--space-22);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--panel-glass);
  }
  .profile-benefits-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-24);
  }
  .profile-benefits-head h2 {
    margin: 0;
    color: var(--fg);
    font-size: var(--text-md);
  }
  .profile-benefits-head p {
    max-width: 620px;
    margin: var(--space-6) 0 0;
    color: var(--fg-muted);
    font-size: var(--text-xs);
    line-height: 1.55;
  }
  .profile-benefits-head .btn {
    flex: none;
    gap: var(--space-7);
    white-space: nowrap;
  }
  .profile-benefits-state {
    display: grid;
    min-height: 104px;
    place-items: center;
    margin: var(--space-18) 0 0;
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg);
    color: var(--fg-muted);
    font-size: var(--text-xs);
  }
  .profile-benefits-content {
    display: grid;
    grid-template-columns: minmax(240px, 0.72fr) minmax(0, 1.28fr);
    gap: var(--space-14);
    margin-top: var(--space-18);
  }
  .profile-plan-summary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-14);
    min-width: 0;
    padding: var(--space-16);
    border: 1px solid color-mix(in srgb, var(--accent) 28%, var(--border));
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--accent) 5%, var(--bg));
  }
  .profile-plan-icon {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border-radius: var(--radius-lg);
    color: var(--accent-bright);
    background: var(--accent-soft);
    font-size: var(--text-lg);
  }
  .profile-plan-copy {
    display: grid;
    min-width: 0;
    gap: var(--space-3);
  }
  .profile-plan-copy > span,
  .profile-scheduled-plan span {
    color: var(--fg-muted);
    font-size: var(--text-2xs);
  }
  .profile-plan-copy strong {
    overflow: hidden;
    color: var(--fg);
    font-size: var(--text-md);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .profile-plan-copy small {
    color: var(--fg-faint);
    font-size: var(--text-2xs);
  }
  .profile-scheduled-plan {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-12);
    padding-top: var(--space-12);
    border-top: 1px solid var(--border);
  }
  .profile-scheduled-plan strong {
    color: var(--fg);
    font-size: var(--text-xs);
  }
  .profile-credit-summary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8);
    margin: 0;
  }
  .profile-credit-summary > div {
    min-width: 0;
    padding: var(--space-14) var(--space-15);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg);
  }
  .profile-credit-summary > div.is-primary {
    border-color: color-mix(in srgb, var(--accent) 32%, var(--border));
    background: color-mix(in srgb, var(--accent) 5%, var(--bg));
  }
  .profile-credit-summary dt {
    color: var(--fg-muted);
    font-size: var(--text-2xs);
  }
  .profile-credit-summary dd {
    display: flex;
    align-items: baseline;
    gap: var(--space-5);
    min-width: 0;
    margin: var(--space-7) 0 0;
  }
  .profile-credit-summary strong {
    overflow: hidden;
    color: var(--fg);
    font: 600 var(--text-lg) var(--font-mono);
    text-overflow: ellipsis;
  }
  .profile-credit-summary dd span {
    color: var(--fg-faint);
    font-size: var(--text-2xs);
  }
  .profile-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
    gap: var(--space-14);
    margin-top: var(--space-14);
  }
  .profile-editor,
  .profile-details,
  .profile-connections {
    padding: var(--space-22);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--panel-glass);
  }
  .profile-side {
    display: grid;
    gap: var(--space-14);
  }
  .profile-section-head h2 {
    margin: 0;
    color: var(--fg);
    font-size: var(--text-md);
  }
  .profile-section-head p {
    margin: var(--space-6) 0 0;
    color: var(--fg-muted);
    font-size: var(--text-xs);
    line-height: 1.55;
  }
  .profile-editor form {
    display: grid;
    gap: var(--space-18);
    margin-top: var(--space-24);
  }
  .profile-editor input {
    width: 100%;
    min-height: 42px;
    padding: var(--space-9) var(--space-11);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    outline: 0;
    color: var(--fg);
    background: var(--bg);
    font: inherit;
    font-size: var(--text-sm);
  }
  .profile-editor input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .profile-form-actions {
    display: flex;
    justify-content: flex-end;
    padding-top: var(--space-2);
  }
  .profile-details dl {
    display: grid;
    gap: 0;
    margin: var(--space-18) 0 0;
  }
  .profile-details dl > div {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    gap: var(--space-12);
    padding: var(--space-12) 0;
    border-top: 1px solid var(--border);
  }
  .profile-details dt {
    color: var(--fg-muted);
    font-size: var(--text-xs);
  }
  .profile-details dd {
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
    color: var(--fg);
    font-size: var(--text-xs);
    text-align: right;
  }
  .profile-details code {
    color: var(--fg-muted);
    font-size: var(--text-2xs);
  }
  .connection-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-12);
    margin-top: var(--space-18);
    padding-top: var(--space-16);
    border-top: 1px solid var(--border);
  }
  .connection-icon {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg);
    font-size: var(--text-lg);
  }
  .connection-row > div {
    display: grid;
    gap: var(--space-3);
  }
  .connection-row strong {
    font-size: var(--text-xs);
  }
  .connection-row div span {
    color: var(--fg-muted);
    font-size: var(--text-2xs);
  }
  .connection-status {
    padding: var(--space-5) var(--space-8);
    border-radius: var(--radius-pill);
    color: var(--fg-faint);
    background: var(--chip-bg);
    font-size: var(--text-2xs);
    white-space: nowrap;
  }
  .connection-status.is-connected {
    color: var(--success);
    background: color-mix(in srgb, var(--success) 10%, transparent);
  }
  @media (max-width: 980px) {
    .profile-benefits-content,
    .profile-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 620px) {
    .profile-hero {
      grid-template-columns: auto minmax(0, 1fr);
    }
