---
import type { Locale } from '../i18n/ui'
import { cloudCopy } from '../i18n/cloud'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = cloudCopy(locale)
---

<section class="cloud-shell" data-cloud-account data-locale={locale} data-copy={JSON.stringify(copy)}>
  <header class="cloud-head">
    <p class="eyebrow">CodeY Cloud</p>
    <h1>{copy.accountTitle}</h1>
    <p>{copy.accountDescription}</p>
  </header>

  <p class="cloud-state" data-state>{copy.loading}</p>

  <div hidden data-content>
    <section class="summary-grid" aria-label={copy.credits}>
      <article class="summary-card summary-card-primary">
        <span>{copy.credits}</span>
        <strong data-available-credit>0</strong>
      </article>
      <article class="summary-card"><span>{copy.expiring}</span><strong data-expiring-credit>0</strong></article>
      <article class="summary-card"><span>{copy.permanent}</span><strong data-permanent-credit>0</strong></article>
      <article class="summary-card"><span>{copy.reserved}</span><strong data-reserved-credit>0</strong></article>
    </section>

    <section class="current-plan">
      <div>
        <span>{copy.currentPlan}</span>
        <strong data-current-plan>—</strong>
      </div>
      <div>
        <span data-period-label>{copy.activeUntil}</span>
        <strong data-period-end>—</strong>
      </div>
      <div hidden data-scheduled-wrap>
        <span>{copy.scheduled}</span>
        <strong data-scheduled-plan>—</strong>
      </div>
    </section>

    <section class="catalog-section">
      <div class="section-title"><h2>{copy.plans}</h2></div>
      <div class="catalog-grid" data-plans></div>
    </section>

    <section class="catalog-section">
      <div class="section-title"><h2>{copy.topUps}</h2></div>
      <div class="catalog-grid" data-topups></div>
    </section>
  </div>

  <dialog class="payment-dialog" data-payment-dialog>
    <button type="button" class="dialog-close" data-payment-close aria-label="Close">×</button>
    <h2>{copy.paymentPending}</h2>
    <img hidden data-payment-qr alt={copy.scanPayment} />
    <a class="btn btn-primary" data-payment-link target="_blank" rel="noopener">{copy.openPayment}</a>
    <button class="btn btn-ghost" type="button" data-payment-copy>{copy.copyPayment}</button>
    <code data-payment-code></code>
  </dialog>
</section>

<script>
  type Offer = { offerId: string; region: string; currency: string; paymentProvider: string; amountMinor: number }
  type Plan = { planId: string; displayName: string; description: string; tierRank: number; isDefault: boolean; monthlyCreditMicros: number; offers: Offer[] }
  type TopUp = { productId: string; displayName: string; description: string; creditMicros: number; offers: Offer[] }
  type Catalog = { plans: Plan[] }
  type TopUpCatalog = { products: TopUp[] }
  type PaymentAvailability = { providers: string[] }
  type Account = {
    user: { displayName: string }
    subscription: {
      planId: string
      status: 'active' | 'expired'
      currentPeriodId: string
      currentPeriodEnd: string
      scheduledPlanId?: string | null
    }
    wallet: {
      availableCreditMicros: number
      reservedCreditMicros: number
      expiringCreditMicros: number
      permanentCreditMicros: number
    }
  }
  type Checkout = {
    order: { orderId: string; status: string }
    action:
      | { type: 'redirect'; url: string }
      | { type: 'qr_code'; code_url: string; image_data_url: string }
      | { type: 'form'; method: string; action: string; fields: Record<string, string> }
  }

  const root = document.querySelector<HTMLElement>('[data-cloud-account]')
  if (root) {
    const locale = root.dataset.locale === 'en' ? 'en' : 'zh-CN'
    const copy = JSON.parse(root.dataset.copy || '{}') as Record<string, string>
    const state = root.querySelector<HTMLElement>('[data-state]')!
    const content = root.querySelector<HTMLElement>('[data-content]')!
    const dialog = root.querySelector<HTMLDialogElement>('[data-payment-dialog]')!
    let account: Account
    let plans: Plan[] = []
    let paymentAvailability: PaymentAvailability = { providers: [] }
    let polling: number | undefined

    const points = (creditMicros: number): string =>
      new Intl.NumberFormat(locale, { maximumFractionDigits: 2 }).format(creditMicros / 1_000_000)
    const date = (value: string): string =>
      new Intl.DateTimeFormat(locale, { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(value))
    const price = (offer: Offer): string =>
      new Intl.NumberFormat(locale, { style: 'currency', currency: offer.currency }).format(offer.amountMinor / 100)
    const provider = (value: string): string => ({ stripe: 'Stripe', alipay: '支付宝', wechat_pay: '微信支付', test: 'Test' })[value] || value

    async function api<T>(path: string, init?: RequestInit): Promise<T> {
      const response = await fetch(`/api/cloud/v1${path}`, {
        ...init,
        headers: { Accept: 'application/json', ...(init?.body ? { 'Content-Type': 'application/json' } : {}), ...init?.headers },
      })
      if (response.status === 401) {
        window.dispatchEvent(new CustomEvent('market-auth-required'))
        throw new Error(copy.signIn)
      }
      if (!response.ok) {
        const payload = await response.json().catch(() => null) as { message?: string } | null
        throw new Error(payload?.message || copy.unavailable)
      }
      return response.json() as Promise<T>
    }

    function button(label: string, action: () => Promise<void>, kind = 'btn-primary'): HTMLButtonElement {
      const element = document.createElement('button')
      element.type = 'button'
      element.className = `btn ${kind}`
      element.textContent = label
      element.addEventListener('click', async () => {
        const original = element.textContent
        element.disabled = true
        try { await action() } catch (reason) { state.textContent = reason instanceof Error ? reason.message : copy.unavailable; state.hidden = false }
        finally { element.disabled = false; element.textContent = original }
      })
      return element
    }

    function offerButtons(offers: Offer[], action: (offer: Offer) => Promise<void>): HTMLElement {
      const wrap = document.createElement('div')
      wrap.className = 'offer-list'
      const available = offers.filter((offer) => paymentAvailability.providers.includes(offer.paymentProvider))
      for (const offer of available) {
        wrap.append(button(`${provider(offer.paymentProvider)} · ${price(offer)}`, () => action(offer)))
      }
      return wrap
    }

    async function beginCheckout(path: string, offerId: string): Promise<void> {
      const checkout = await api<Checkout>(path, {
        method: 'POST',
        body: JSON.stringify({ offerId, idempotencyKey: crypto.randomUUID() }),
      })
      if (checkout.action.type === 'redirect') {
        window.location.assign(checkout.action.url)
        return
      }
      if (checkout.action.type === 'form') {
        const form = document.createElement('form')
        form.method = checkout.action.method
        form.action = checkout.action.action
        for (const [name, value] of Object.entries(checkout.action.fields)) {
          const input = document.createElement('input')
          input.type = 'hidden'; input.name = name; input.value = value; form.append(input)
        }
        document.body.append(form)
        form.submit()
        return
      }
      const link = root.querySelector<HTMLAnchorElement>('[data-payment-link]')!
      const code = root.querySelector<HTMLElement>('[data-payment-code]')!
      const image = root.querySelector<HTMLImageElement>('[data-payment-qr]')!
      link.href = checkout.action.code_url
      code.textContent = checkout.action.code_url
      image.src = checkout.action.image_data_url
      image.hidden = false
      root.querySelector<HTMLButtonElement>('[data-payment-copy]')!.onclick = () => navigator.clipboard.writeText(checkout.action.code_url)
      dialog.showModal()
      polling = window.setInterval(async () => {
        try {
          const order = await api<{ status: string }>(`/orders/${checkout.order.orderId}`)
          if (order.status === 'fulfilled') { window.clearInterval(polling); dialog.close(); await load() }
        } catch { /* retain checkout while transient polling fails */ }
      }, 2000)
    }

    async function choosePlan(plan: Plan, offer: Offer): Promise<void> {
      const current = plans.find((candidate) => candidate.planId === account.subscription.planId)
      const isDowngrade = account.subscription.status === 'active' && current && plan.tierRank < current.tierRank
      if (isDowngrade && account.subscription.scheduledPlanId !== plan.planId) {
        await api('/subscription/scheduled-plan', {
          method: 'POST',
          body: JSON.stringify({ planId: plan.planId, expectedPeriodId: account.subscription.currentPeriodId }),
        })
        await load()
        return
      }
      await beginCheckout('/orders/plans', offer.offerId)
    }

    function renderPlan(plan: Plan): HTMLElement {
      const current = plan.planId === account.subscription.planId && account.subscription.status === 'active'
      const scheduled = plan.planId === account.subscription.scheduledPlanId
      const currentPlan = plans.find((candidate) => candidate.planId === account.subscription.planId)
      const verb = current ? copy.renew : scheduled ? copy.buy : currentPlan && plan.tierRank < currentPlan.tierRank ? copy.scheduleDowngrade : account.subscription.status === 'active' ? copy.upgrade : copy.buy
      const card = document.createElement('article')
      card.className = `catalog-card${current ? ' is-current' : ''}`
      card.innerHTML = `<div><h3>${escapeHtml(plan.displayName)}</h3><p>${escapeHtml(plan.description)}</p></div><strong>${points(plan.monthlyCreditMicros)} <small>${copy.creditsPerMonth}</small></strong>`
      if (current) { const badge = document.createElement('span'); badge.className = 'status-badge'; badge.textContent = copy.current; card.prepend(badge) }
      if (scheduled) { const badge = document.createElement('span'); badge.className = 'status-badge scheduled'; badge.textContent = copy.scheduledDone; card.prepend(badge) }
      if (!plan.isDefault && plan.offers.length) {
        const offers = offerButtons(plan.offers, (offer) => choosePlan(plan, offer))
        offers.dataset.verb = verb
        card.append(offers)
      }
      return card
    }

    function renderTopUp(product: TopUp): HTMLElement {
      const card = document.createElement('article')
      card.className = 'catalog-card'
      card.innerHTML = `<div><h3>${escapeHtml(product.displayName)}</h3><p>${escapeHtml(product.description)}</p></div><strong>${points(product.creditMicros)} <small>${copy.permanentCredits}</small></strong>`
      card.append(offerButtons(product.offers, (offer) => beginCheckout('/orders/top-ups', offer.offerId)))
      return card
    }

    function escapeHtml(value: string): string {
      const span = document.createElement('span'); span.textContent = value; return span.innerHTML
    }

    async function load(): Promise<void> {
      state.hidden = false
      state.textContent = copy.loading
      try {
        const [me, planCatalog, topUpCatalog, availability] = await Promise.all([
          api<Account>('/me'), api<Catalog>('/plans'), api<TopUpCatalog>('/top-ups'), api<PaymentAvailability>('/payments/availability'),
        ])
        account = me
        plans = planCatalog.plans
        paymentAvailability = availability
        const planById = new Map(plans.map((plan) => [plan.planId, plan]))
        root.querySelector('[data-available-credit]')!.textContent = points(me.wallet.availableCreditMicros)
        root.querySelector('[data-expiring-credit]')!.textContent = points(me.wallet.expiringCreditMicros)
        root.querySelector('[data-permanent-credit]')!.textContent = points(me.wallet.permanentCreditMicros)
        root.querySelector('[data-reserved-credit]')!.textContent = points(me.wallet.reservedCreditMicros)
        root.querySelector('[data-current-plan]')!.textContent = planById.get(me.subscription.planId)?.displayName || me.subscription.planId
        root.querySelector('[data-period-label]')!.textContent = me.subscription.status === 'expired' ? copy.expired : copy.activeUntil
        root.querySelector('[data-period-end]')!.textContent = date(me.subscription.currentPeriodEnd)
        const scheduledWrap = root.querySelector<HTMLElement>('[data-scheduled-wrap]')!
        scheduledWrap.hidden = !me.subscription.scheduledPlanId
        root.querySelector('[data-scheduled-plan]')!.textContent = planById.get(me.subscription.scheduledPlanId || '')?.displayName || me.subscription.scheduledPlanId || '—'
        const planRoot = root.querySelector<HTMLElement>('[data-plans]')!
        const topupRoot = root.querySelector<HTMLElement>('[data-topups]')!
        planRoot.replaceChildren(...plans.map(renderPlan))
        topupRoot.replaceChildren(...topUpCatalog.products.map(renderTopUp))
        content.hidden = false
        state.hidden = true
      } catch (reason) {
        content.hidden = true
        state.textContent = reason instanceof Error ? reason.message : copy.unavailable
      }
    }

    root.querySelector('[data-payment-close]')?.addEventListener('click', () => dialog.close())
    dialog.addEventListener('close', () => { if (polling) window.clearInterval(polling) })
    window.addEventListener('market-auth-changed', () => void load())
    void load()
  }
</script>

<style>
  .cloud-shell { width: min(1180px, calc(100% - 36px)); margin: 0 auto; padding: 132px 0 96px; }
  .cloud-head { max-width: 720px; }
  .eyebrow { margin: 0 0 12px; color: var(--accent-bright); font: 600 0.76rem var(--font-mono); letter-spacing: .12em; text-transform: uppercase; }
  .cloud-head h1 { font-size: clamp(2.2rem, 6vw, 4.3rem); letter-spacing: -.055em; }
  .cloud-head > p:last-child { margin: 16px 0 0; color: var(--fg-muted); font-size: 1.05rem; }
  .cloud-state { margin: 48px 0; color: var(--fg-muted); }
  .summary-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-top: 46px; }
  .summary-card, .current-plan, .catalog-card { border: 1px solid var(--border); border-radius: 16px; background: var(--panel-glass); }
  .summary-card { display: grid; gap: 9px; padding: 21px; }
  .summary-card span, .current-plan span { color: var(--fg-muted); font-size: .78rem; }
  .summary-card strong { font: 600 1.65rem var(--font-mono); }
  .summary-card-primary { border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); background: color-mix(in srgb, var(--accent) 8%, var(--panel-glass)); }
  .current-plan { display: flex; gap: 70px; margin-top: 14px; padding: 21px 24px; }
  .current-plan > div { display: grid; gap: 6px; }
  .catalog-section { margin-top: 54px; }
  .section-title { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; }
  .section-title h2 { font-size: 1.45rem; }
  .catalog-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .catalog-card { position: relative; display: grid; align-content: start; gap: 24px; min-height: 280px; padding: 24px; }
  .catalog-card.is-current { border-color: var(--accent); }
  .catalog-card h3 { font-size: 1.16rem; }
  .catalog-card p { min-height: 3em; margin: 8px 0 0; color: var(--fg-muted); font-size: .84rem; line-height: 1.6; }
  .catalog-card > strong { font: 600 1.55rem var(--font-mono); }
  .catalog-card strong small { display: block; margin-top: 5px; color: var(--fg-muted); font: 400 .72rem var(--font-body); }
  .status-badge { position: absolute; top: 18px; right: 18px; padding: 4px 8px; border-radius: 999px; color: var(--accent-bright); background: var(--accent-soft); font-size: .7rem; }
  .status-badge.scheduled { top: 47px; }
  .offer-list { display: grid; gap: 8px; align-self: end; }
  .offer-list::before { content: attr(data-verb); color: var(--fg-faint); font-size: .72rem; }
  .offer-list .btn { width: 100%; min-height: 39px; }
  .payment-dialog { width: min(500px, calc(100vw - 28px)); margin: auto; padding: 30px; border: 1px solid var(--border-strong); border-radius: 18px; color: var(--fg); background: var(--bg); }
  .payment-dialog::backdrop { background: rgb(9 12 22 / .7); backdrop-filter: blur(6px); }
  .payment-dialog h2 { margin: 0 30px 22px 0; font-size: 1.1rem; line-height: 1.5; }
  .payment-dialog img { display: block; width: min(280px, 100%); aspect-ratio: 1; margin: 0 auto 18px; border-radius: 10px; background: #fff; }
  .payment-dialog img[hidden] { display: none; }
  .payment-dialog .btn { display: flex; justify-content: center; margin-top: 9px; }
  .payment-dialog code { display: block; max-height: 90px; margin-top: 16px; overflow: auto; color: var(--fg-faint); font-size: .68rem; overflow-wrap: anywhere; }
  .dialog-close { position: absolute; top: 13px; right: 13px; width: 32px; height: 32px; border: 0; border-radius: 50%; color: var(--fg-muted); background: var(--ghost-bg); cursor: pointer; }
  @media (max-width: 900px) { .summary-grid { grid-template-columns: repeat(2, 1fr); } .catalog-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .cloud-shell { width: min(100% - 24px, 1180px); padding-top: 108px; } .summary-grid, .catalog-grid { grid-template-columns: 1fr; } .current-plan { display: grid; gap: 18px; } }
</style>
