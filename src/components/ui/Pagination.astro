---
import type { Locale } from '../../i18n/ui'

interface Props {
  locale: Locale
  pageSize?: number
  pageSizeOptions?: number[]
  class?: string
  [key: string]: unknown
}

const {
  locale,
  pageSize = 10,
  pageSizeOptions = [10, 20, 50],
  class: className,
  ...attributes
} = Astro.props
const copy = locale === 'en'
  ? {
      navigation: 'Pagination',
      previous: 'Previous page',
      next: 'Next page',
      perPage: 'Per page',
      page: 'Page',
      of: 'of',
      items: 'items',
    }
  : {
      navigation: '分页',
      previous: '上一页',
      next: '下一页',
      perPage: '每页',
      page: '第',
      of: '共',
      items: '项',
    }
const options = [...new Set([...pageSizeOptions, pageSize])].filter((value) => value > 0).sort((a, b) => a - b)
---

<nav
  class:list={['ui-pagination', className]}
  aria-label={copy.navigation}
  data-ui-pagination
  data-locale={locale}
  data-page-size={pageSize}
  data-copy={JSON.stringify(copy)}
  hidden
  {...attributes}
>
  <p class="ui-pagination__summary" aria-live="polite" data-pagination-summary></p>
  <div class="ui-pagination__controls">
    <label class="ui-pagination__size">
      <span>{copy.perPage}</span>
      <select data-pagination-size>
        {options.map((value) => <option value={value} selected={value === pageSize}>{value}</option>)}
      </select>
    </label>
    <div class="ui-pagination__pages">
      <button type="button" data-pagination-previous aria-label={copy.previous}>
        <i class="ph ph-caret-left" aria-hidden="true"></i>
      </button>
      <div class="ui-pagination__numbers" data-pagination-numbers></div>
      <button type="button" data-pagination-next aria-label={copy.next}>
        <i class="ph ph-caret-right" aria-hidden="true"></i>
      </button>
    </div>
  </div>
</nav>
