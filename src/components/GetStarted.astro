---
import type { Locale } from '../i18n/ui'
import { docsPath, t } from '../i18n/utils'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const descParts = t(locale, 'start.desc').split(/(`[^`]+`)/g)
---

<section class="section" id="get-started">
  <div class="container">
    <div class="start-panel reveal">
      <div class="start-copy">
        <p class="section-tag">{t(locale, 'start.tag')}</p>
        <h2 class="section-title">{t(locale, 'start.title')}</h2>
        <p class="section-desc">
          {
            descParts.map((part) =>
              part.startsWith('`') && part.endsWith('`') ? (
                <code>{part.slice(1, -1)}</code>
              ) : (
                part
              ),
            )
          }
        </p>
        <div class="req-chips">
          <span>Node.js 24.12</span>
          <span>pnpm 11.7</span>
          <span>Rust 1.96+</span>
          <span>Tauri 2</span>
        </div>
        <a class="btn btn-primary" href={docsPath(locale, 'getting-started')}>{t(locale, 'start.cta')}</a>
      </div>
      <div class="start-terminal" aria-label={t(locale, 'start.term')}>
        <div class="term-bar">
          <span class="term-dot"></span>
          <span class="term-dot"></span>
          <span class="term-dot"></span>
          <span class="term-name">zsh</span>
        </div>
        <pre><code><span class="term-prompt">$</span> git clone https://github.com/ysmjjsy/CodeY.git
<span class="term-prompt">$</span> cd CodeY
<span class="term-prompt">$</span> pnpm install
<span class="term-prompt">$</span> pnpm dev
<span class="term-comment">{t(locale, 'start.comment')}</span></code></pre>
      </div>
    </div>
  </div>
</section>

<style>
  .start-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(28px, 5vw, 56px);
    align-items: center;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-xl);
    padding: clamp(28px, 5vw, 56px);
    background:
      radial-gradient(ellipse 60% 90% at 100% 0%, var(--accent-glow), transparent),
      var(--surface);
  }

  .start-copy .section-desc code {
    font-size: 0.85em;
    color: var(--accent-bright);
  }

  .req-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 28px 0 32px;
  }

  .req-chips span {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--fg-muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 5px 14px;
  }

  .start-terminal {
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--term-bg);
    overflow: hidden;
    box-shadow: var(--shadow-window);
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
  }

  .term-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--fg-faint);
    opacity: 0.45;
  }

  .term-name {
    margin-left: 8px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--fg-faint);
  }

  .start-terminal pre {
    margin: 0;
    padding: clamp(14px, 3vw, 20px) clamp(14px, 3vw, 22px);
    font-size: clamp(0.72rem, 2.4vw, 0.84rem);
    line-height: 2.1;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    color: #e2e8f0;
  }

  .term-prompt {
    color: #22d3ee;
    user-select: none;
  }

  .term-comment {
    color: #64748b;
  }

  @media (max-width: 920px) {
    .start-panel {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .start-panel {
      border-radius: var(--radius-lg);
    }

    .start-copy .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
