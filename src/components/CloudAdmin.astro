---
import { cloudCopy } from '../i18n/cloud'
import type { Locale } from '../i18n/ui'
import { providerPresets } from '../lib/provider-presets'
import Button from './ui/Button.astro'
import Dialog from './ui/Dialog.astro'
import EmptyState from './ui/EmptyState.astro'
import Field from './ui/Field.astro'
import List from './ui/List.astro'
import PageHeader from './ui/PageHeader.astro'
import Pagination from './ui/Pagination.astro'
import SectionHeader from './ui/SectionHeader.astro'
import StateMessage from './ui/StateMessage.astro'

interface Props {
  locale: Locale
  section?: 'models' | 'plans' | 'topups'
}
const { locale, section = 'models' } = Astro.props
const copy = cloudCopy(locale)
const title =
  section === 'plans'
    ? copy.planAdminTitle
    : section === 'topups'
      ? copy.topUpAdminTitle
      : copy.adminTitle
const description =
  section === 'plans'
    ? copy.planAdminDescription
    : section === 'topups'
      ? copy.topUpAdminDescription
      : copy.adminDescription
---

<section class="admin-shell" data-cloud-admin data-admin-section={section} data-locale={locale} data-copy={JSON.stringify(copy)}>
  {section !== 'models' && <PageHeader class="admin-head" title={title} description={description} />}
  <StateMessage class="admin-state" data-state>{copy.loading}</StateMessage>

  <div class="admin-content" hidden data-content>
    <div class="model-admin-section model-admin-tabs" role="tablist" aria-label={copy.adminTitle}>
      <button type="button" role="tab" aria-selected="true" aria-controls="provider-management-panel" id="provider-management-tab" data-model-tab="providers"><i class="ph ph-plugs-connected" aria-hidden="true"></i>{copy.providerTab}</button>
      <button type="button" role="tab" aria-selected="false" aria-controls="model-management-panel" id="model-management-tab" data-model-tab="models"><i class="ph ph-brain" aria-hidden="true"></i>{copy.modelTab}</button>
    </div>

    <section class="admin-section model-admin-section model-tab-panel" role="tabpanel" id="provider-management-panel" aria-labelledby="provider-management-tab" data-model-panel="providers">
      <SectionHeader class="admin-section-header model-section-header" title={copy.providers} description={copy.providersDescription}>
        <Button slot="actions" variant="primary" data-new-provider><i class="ph ph-plus" aria-hidden="true"></i>{copy.addProvider}</Button>
      </SectionHeader>
      <List class="config-table-shell">
        <table class="config-table provider-config-table" data-provider-table hidden>
          <thead><tr><th scope="col">{copy.providerColumn}</th><th scope="col">{copy.connectionColumn}</th><th scope="col">{copy.modelCountColumn}</th><th scope="col">{copy.credentialColumn}</th><th scope="col">{copy.latencyColumn}</th><th scope="col">{copy.statusColumn}</th><th scope="col"><span class="sr-only">{copy.actionColumn}</span></th></tr></thead>
          <tbody data-provider-list></tbody>
        </table>
        <EmptyState class="config-empty" title={copy.emptyProviders} description={copy.emptyProvidersDescription} data-provider-empty>
          <i slot="icon" class="ph ph-plugs-connected" aria-hidden="true"></i>
          <Button slot="actions" data-new-provider><i class="ph ph-plus" aria-hidden="true"></i>{copy.addProvider}</Button>
        </EmptyState>
        <Pagination slot="footer" locale={locale} pageSize={10} pageSizeOptions={[10, 20, 50]} data-provider-pagination />
      </List>
    </section>

    <aside class="provider-model-popover" role="dialog" aria-label={copy.availableModels} hidden data-provider-model-popover>
      <strong data-provider-model-popover-title></strong>
      <div data-provider-model-popover-list></div>
    </aside>

    <section class="admin-section model-admin-section model-tab-panel" role="tabpanel" id="model-management-panel" aria-labelledby="model-management-tab" data-model-panel="models" hidden>
      <SectionHeader class="admin-section-header model-section-header" title={copy.models} description={copy.modelsDescription}>
        <Button slot="actions" data-new-model disabled><i class="ph ph-plus" aria-hidden="true"></i>{copy.addModel}</Button>
      </SectionHeader>
      <List class="config-table-shell">
        <table class="config-table model-config-table" data-model-table hidden>
          <thead><tr><th scope="col">{copy.modelColumn}</th><th scope="col">{copy.providerColumn}</th><th scope="col">{copy.protocol}</th><th scope="col">{copy.capabilityColumn}</th><th scope="col">{copy.pricingColumn}</th><th scope="col">{copy.latencyColumn}</th><th scope="col">{copy.statusColumn}</th><th scope="col"><span class="sr-only">{copy.actionColumn}</span></th></tr></thead>
          <tbody data-model-list></tbody>
        </table>
        <EmptyState class="config-empty" title={copy.emptyModels} description={copy.emptyModelsDescription} data-model-empty>
          <i slot="icon" class="ph ph-brain" aria-hidden="true"></i>
          <Button slot="actions" data-new-model disabled><i class="ph ph-plus" aria-hidden="true"></i>{copy.addModel}</Button>
        </EmptyState>
        <Pagination slot="footer" locale={locale} pageSize={10} pageSizeOptions={[10, 20, 50]} data-model-pagination />
      </List>
    </section>

    <section class="admin-section plan-admin-section">
      <SectionHeader class="admin-section-header" title={copy.plans}><Button slot="actions" variant="primary" data-new-plan>{copy.addPlan}</Button></SectionHeader>
      <List class="config-table-shell">
        <table class="config-table plan-config-table" data-plan-table hidden>
          <thead><tr><th scope="col">{copy.planColumn}</th><th scope="col">{copy.monthlyCredits}</th><th scope="col">{copy.tierRank}</th><th scope="col">{copy.allowedModels}</th><th scope="col">{copy.paymentOffers}</th><th scope="col">{copy.planTypeColumn}</th><th scope="col"><span class="sr-only">{copy.actionColumn}</span></th></tr></thead>
          <tbody data-plan-list></tbody>
        </table>
        <EmptyState class="config-empty" title={copy.emptyPlans} description={copy.emptyPlansDescription} data-plan-empty>
          <i slot="icon" class="ph ph-credit-card" aria-hidden="true"></i>
          <Button slot="actions" data-new-plan><i class="ph ph-plus" aria-hidden="true"></i>{copy.addPlan}</Button>
        </EmptyState>
        <Pagination slot="footer" locale={locale} pageSize={10} pageSizeOptions={[10, 20, 50]} data-plan-pagination />
      </List>
    </section>

    <section class="admin-section topup-admin-section">
      <SectionHeader class="admin-section-header" title={copy.topUps}><Button slot="actions" variant="primary" data-new-topup>{copy.addTopUp}</Button></SectionHeader>
      <List class="record-list">
        <div data-topup-list></div>
        <Pagination slot="footer" locale={locale} pageSize={10} pageSizeOptions={[10, 20, 50]} data-topup-pagination />
      </List>
    </section>
  </div>

  <Dialog class="admin-dialog model-config-dialog provider-config-dialog" data-provider-dialog aria-labelledby="provider-dialog-title">
    <div class="dialog-card">
      <header class="dialog-head"><div><h2 id="provider-dialog-title" data-provider-dialog-title>{copy.addProvider}</h2><p>{copy.providerFormDescription}</p></div><button type="button" data-close aria-label={copy.close}><i class="ph ph-x" aria-hidden="true"></i></button></header>
      <form class="model-config-editor connection-editor" data-provider-form>
        <input name="providerId" type="hidden" />
        <Field label={copy.providerVendor} hint={copy.providerVendorHelp}><select name="providerPresetId" required>{providerPresets.map((preset) => <option value={preset.id}>{preset.displayName}</option>)}<option value="custom">{copy.customProvider}</option></select></Field>
        <div data-provider-credential-field><Field label={copy.apiKey}><input name="apiKey" type="password" autocomplete="new-password" placeholder={copy.apiKeyCreateHint} /></Field></div>
        <div class="provider-advanced-fields">
          <Field label={copy.displayName}><input name="displayName" required maxlength="100" /></Field>
          <Field label={copy.slug} hint={copy.slugHelp}><input name="slug" required minlength="2" maxlength="100" pattern="[a-z0-9][a-z0-9._-]{1,99}" /></Field>
          <Field label={copy.protocolFamily} hint={copy.protocolFamilyHelp}><select name="providerKind"><option value="openai_compatible">{copy.openaiCompatible}</option><option value="anthropic">Anthropic</option><option value="gemini">Gemini</option></select></Field>
          <Field label={copy.baseUrl} hint={copy.baseUrlHelp}><input name="baseUrl" type="url" required placeholder={copy.baseUrlPlaceholder} /></Field>
        </div>
        <section class="provider-discovery" aria-live="polite" data-provider-discovery hidden>
          <div><i class="ph ph-radar" aria-hidden="true"></i><span data-provider-discovery-text>{copy.discoveryRequired}</span></div>
          <div class="provider-model-preview" data-provider-model-preview hidden></div>
        </section>
        <label class="setting-toggle"><span><strong>{copy.active}</strong><small>{copy.providerEnabledHelp}</small></span><input name="active" type="checkbox" role="switch" checked /></label>
        <div class="dialog-actions provider-dialog-actions"><Button data-discover-provider><i class="ph ph-plugs-connected" aria-hidden="true"></i><span>{copy.testAndFetchModels}</span></Button><Button variant="primary" type="submit" data-save-provider>{copy.saveProvider}</Button></div>
      </form>
    </div>
  </Dialog>

  <Dialog class="admin-dialog model-config-dialog model-editor-dialog" data-model-dialog aria-labelledby="model-dialog-title">
    <div class="dialog-card">
      <header class="dialog-head"><div><h2 id="model-dialog-title" data-model-dialog-title>{copy.addModel}</h2><p>{copy.modelFormDescription}</p></div><button type="button" data-close aria-label={copy.close}><i class="ph ph-x" aria-hidden="true"></i></button></header>
      <form class="model-config-editor model-editor" data-model-form>
        <input name="modelId" type="hidden" />
        <fieldset class="model-form-section"><legend>{copy.routing}</legend><p>{copy.routingDescription}</p><div class="model-form-grid">
          <Field label={copy.upstreamProvider}><select name="upstreamProviderId" required data-provider-select></select></Field>
          <Field label={copy.protocol}><select name="protocol" required data-protocol-select></select></Field>
          <Field label={copy.publicModelId} hint={copy.publicModelIdHelp}><input name="publicModelId" required minlength="2" maxlength="100" pattern="[a-z0-9][a-z0-9._-]{1,99}" /></Field>
          <Field label={copy.upstreamModelId} hint={copy.upstreamModelIdHelp}><select name="upstreamModelId" required data-upstream-model-select></select></Field>
          <Field class="model-field-wide" label={copy.displayName}><input name="displayName" required maxlength="100" /></Field>
        </div></fieldset>
        <fieldset class="model-form-section" data-token-model-section><legend>{copy.capacity}</legend><p>{copy.capacityDescription}</p><div class="model-form-grid">
          <Field label={copy.contextWindow}><input name="contextWindow" type="number" min="1" value="128000" required /></Field>
          <Field label={copy.maxOutputTokens}><input name="maxOutputTokens" type="number" min="1" value="8192" required /></Field>
        </div></fieldset>
        <fieldset class="model-form-section" data-token-model-section><legend>{copy.capabilities}</legend><p>{copy.capabilitiesDescription}</p><div class="capability-grid">
          <label><input name="vision" type="checkbox" /><span>{copy.vision}</span></label>
          <label><input name="tools" type="checkbox" checked /><span>{copy.toolCalling}</span></label>
          <label><input name="reasoning" type="checkbox" /><span>{copy.reasoning}</span></label>
          <label><input name="promptCache" type="checkbox" /><span>{copy.promptCache}</span></label>
          <label><input name="structuredOutput" type="checkbox" /><span>{copy.structuredOutput}</span></label>
        </div></fieldset>
        <fieldset class="model-form-section"><legend>{copy.pricing}</legend><p>{copy.pricingDescription}</p><div class="model-form-grid pricing-grid">
          <Field class="token-pricing-field" label={copy.inputPrice}><input name="inputPrice" type="number" min="0" step="0.000001" value="0" required /></Field>
          <Field class="token-pricing-field" label={copy.outputPrice}><input name="outputPrice" type="number" min="0" step="0.000001" value="0" required /></Field>
          <Field class="token-pricing-field" label={copy.cacheReadPrice}><input name="cacheReadPrice" type="number" min="0" step="0.000001" value="0" required /></Field>
          <Field class="token-pricing-field" label={copy.cacheWritePrice}><input name="cacheWritePrice" type="number" min="0" step="0.000001" value="0" required /></Field>
          <Field class="model-field-wide" label={copy.fixedPrice}><input name="fixedPrice" type="number" min="0" step="0.000001" value="0" required /></Field>
        </div></fieldset>
        <label class="setting-toggle"><span><strong>{copy.active}</strong><small>{copy.modelEnabledHelp}</small></span><input name="active" type="checkbox" role="switch" checked /></label>
        <div class="dialog-actions"><Button data-close>{copy.cancel}</Button><Button data-test-model><i class="ph ph-play-circle" aria-hidden="true"></i><span>{copy.testModel}</span></Button><Button variant="primary" type="submit">{copy.publishModel}</Button></div>
      </form>
    </div>
  </Dialog>

  <Dialog class="admin-dialog" data-plan-dialog>
    <div class="dialog-card">
      <header class="dialog-head"><h2 data-plan-dialog-title>{copy.addPlan}</h2><button type="button" data-close aria-label={copy.close}>×</button></header>
      <form class="editor" data-plan-form>
        <input name="planId" type="hidden" />
        <Field label={copy.slug}><input name="slug" required pattern="[a-z0-9][a-z0-9-]*" /></Field>
        <Field label={copy.tierRank}><input name="tierRank" type="number" min="0" value="0" required /></Field>
        <Field label={copy.displayNameZh}><input name="displayNameZh" required /></Field>
        <Field label={copy.displayNameEn}><input name="displayNameEn" required /></Field>
        <Field label={copy.descriptionZh}><textarea name="descriptionZh" rows="3" required></textarea></Field>
        <Field label={copy.descriptionEn}><textarea name="descriptionEn" rows="3" required></textarea></Field>
        <Field label={copy.monthlyCredits}><input name="monthlyCredits" type="number" min="0" step="0.000001" value="0" required /></Field>
        <label class="check"><input name="isDefault" type="checkbox" /><span>{copy.defaultPlan}</span></label>
        <fieldset class="wide offer-editor" data-plan-offers><legend>{copy.paymentOffers}</legend><div data-plan-offer-rows></div><Button data-add-plan-offer>{copy.addOffer}</Button></fieldset>
        <fieldset class="wide model-access"><legend>{copy.allowedModels}</legend><div data-plan-models></div></fieldset>
        <div class="dialog-actions wide"><Button data-close>{copy.cancel}</Button><Button variant="primary" type="submit">{copy.savePlan}</Button></div>
      </form>
    </div>
  </Dialog>

  <Dialog class="admin-dialog" data-topup-dialog>
    <div class="dialog-card">
      <header class="dialog-head"><h2 data-topup-dialog-title>{copy.addTopUp}</h2><button type="button" data-close aria-label={copy.close}>×</button></header>
      <form class="editor" data-topup-form>
        <input name="productId" type="hidden" />
        <Field label={copy.slug}><input name="slug" required pattern="[a-z0-9][a-z0-9-]*" /></Field>
        <Field label={copy.permanentCreditAmount}><input name="credits" type="number" min="0.000001" step="0.000001" required /></Field>
        <Field label={copy.displayNameZh}><input name="displayNameZh" required /></Field>
        <Field label={copy.displayNameEn}><input name="displayNameEn" required /></Field>
        <Field label={copy.descriptionZh}><textarea name="descriptionZh" rows="3" required></textarea></Field>
        <Field label={copy.descriptionEn}><textarea name="descriptionEn" rows="3" required></textarea></Field>
        <fieldset class="wide offer-editor"><legend>{copy.paymentOffers}</legend><div data-topup-offer-rows></div><Button data-add-topup-offer>{copy.addOffer}</Button></fieldset>
        <div class="dialog-actions wide"><Button data-close>{copy.cancel}</Button><Button variant="primary" type="submit">{copy.saveTopUp}</Button></div>
      </form>
    </div>
  </Dialog>
</section>

<script>
  import { initCloudAdmin } from '../lib/cloud-admin.ts'
  initCloudAdmin()
</script>

<style is:global>
  .admin-shell {
    width: 100%;
  }
  .admin-shell[data-admin-section="models"] :is(.plan-admin-section, .topup-admin-section),
  .admin-shell[data-admin-section="plans"] :is(.model-admin-section, .topup-admin-section),
  .admin-shell[data-admin-section="topups"] :is(.model-admin-section, .plan-admin-section) {
    display: none;
  }
  .admin-content {
    margin-top: var(--space-28);
  }
  .admin-head {
    width: 100%;
  }
  .admin-head > div > p:last-child {
    max-width: 720px;
  }
  .admin-state {
    display: grid;
    min-height: 156px;
    place-items: center;
    margin: var(--space-28) 0 0;
    padding: var(--space-24);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
    color: var(--fg-muted);
    background: var(--panel-glass);
    font-size: var(--text-sm);
  }
  .admin-shell[data-admin-section="models"] .admin-content {
    margin-top: 0;
  }
  .model-admin-tabs {
    display: flex;
    gap: var(--space-24);
    margin-top: 0;
    border-bottom: 1px solid var(--border);
  }
  .model-admin-tabs button {
    position: relative;
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-8) var(--space-2) var(--space-10);
    border: 0;
    color: var(--fg-faint);
    background: transparent;
    font: inherit;
    font-size: var(--text-xs);
    font-weight: 500;
    cursor: pointer;
    transition: color var(--duration-fast) ease;
  }
  .model-admin-tabs button::after {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    border-radius: var(--radius-pill) var(--radius-pill) 0 0;
    background: var(--accent);
    content: "";
    opacity: 0;
    transform: scaleX(0.55);
    transition:
      opacity var(--duration-fast) ease,
      transform var(--duration-fast) ease;
  }
  .model-admin-tabs button i {
    font-size: var(--text-base);
  }
  .model-admin-tabs button:hover {
    color: var(--fg-muted);
  }
  .model-admin-tabs button[aria-selected="true"] {
    color: var(--fg);
    font-weight: 600;
  }
  .model-admin-tabs button[aria-selected="true"]::after {
    opacity: 1;
    transform: scaleX(1);
  }
  .model-admin-tabs button:focus-visible {
    outline: 0;
    border-radius: var(--radius-sm);
    box-shadow: 0 0 0 2px var(--accent-soft);
  }
  .model-tab-panel {
    margin-top: var(--space-20);
  }
  .admin-section {
    margin-top: 0;
  }
  .admin-section-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-18);
    width: 100%;
    margin-bottom: var(--space-12);
  }
  .admin-section-header h2 {
    font-size: var(--text-2xl);
  }
  .admin-section-header p {
    max-width: 720px;
    margin: var(--space-5) 0 0;
    color: var(--fg-muted);
    font-size: var(--text-xs);
    line-height: 1.55;
  }
  .admin-section-header .btn {
    min-height: 38px;
    padding: var(--space-8) var(--space-14);
    justify-self: end;
  }
  .model-section-header .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-6);
  }
  .model-section-header .btn:disabled,
  .config-empty .btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .config-table-shell {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--panel-glass);
    box-shadow: inset 0 1px 0 var(--panel-inset);
  }
  .config-table-shell > .ui-list__viewport {
    overflow-x: auto;
    overflow-y: hidden;
  }
  .config-table {
    width: 100%;
    min-width: 780px;
    border-collapse: collapse;
    text-align: left;
  }
  .provider-config-table {
    min-width: 960px;
    table-layout: fixed;
  }
  .provider-config-table th:nth-child(1) {
    width: 105px;
  }
  .provider-config-table th:nth-child(2) {
    width: 180px;
  }
  .provider-config-table th:nth-child(3) {
    width: 150px;
  }
  .provider-config-table th:nth-child(4) {
    width: 110px;
  }
  .provider-config-table th:nth-child(5) {
    width: 80px;
  }
  .provider-config-table th:nth-child(6) {
    width: 100px;
  }
  .model-config-table {
    min-width: 980px;
    table-layout: fixed;
  }
  .model-config-table th:nth-child(1) {
    width: 130px;
  }
  .model-config-table th:nth-child(2) {
    width: 140px;
  }
  .model-config-table th:nth-child(3) {
    width: 140px;
  }
  .model-config-table th:nth-child(4) {
    width: 125px;
  }
  .model-config-table th:nth-child(5) {
    width: 135px;
  }
  .model-config-table th:nth-child(6) {
    width: 70px;
  }
  .model-config-table th:nth-child(7) {
    width: 90px;
  }
  .plan-config-table {
    min-width: 940px;
    table-layout: fixed;
  }
  .plan-config-table th:nth-child(1) {
    width: 180px;
  }
  .plan-config-table th:nth-child(2) {
    width: 110px;
  }
  .plan-config-table th:nth-child(3) {
    width: 82px;
  }
  .plan-config-table th:nth-child(4) {
    width: 145px;
  }
  .plan-config-table th:nth-child(5) {
    width: 170px;
  }
  .plan-config-table th:nth-child(6) {
    width: 115px;
  }
  .plan-config-table th:last-child,
  .plan-config-table td:last-child {
    width: 100px;
  }
  .config-table th {
    padding: var(--space-10) var(--space-13);
    color: var(--fg-faint);
    background: var(--chip-bg);
    font-size: var(--text-2xs);
    font-weight: 600;
    white-space: nowrap;
  }
  .config-table td {
    min-width: 0;
    padding: var(--space-13);
    border-top: 1px solid var(--border);
    color: var(--fg-muted);
    font-size: var(--text-xs);
    vertical-align: middle;
  }
  .config-table th:last-child,
  .config-table td:last-child {
    width: 150px;
    text-align: right;
  }
  .provider-config-table th:last-child,
  .provider-config-table td:last-child {
    width: 150px;
  }
  .config-identity,
  .config-connection,
  .pricing-summary {
    display: grid;
    min-width: 0;
    gap: var(--space-4);
  }
  .config-identity strong,
  .config-identity > span,
  .config-connection > span {
    overflow: hidden;
    color: var(--fg);
    font-size: var(--text-sm);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .config-identity code,
  .config-connection code {
    display: block;
    max-width: 250px;
    overflow: hidden;
    color: var(--fg-faint);
    font: var(--text-2xs) / 1.35 var(--font-mono);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .config-count {
    color: var(--fg-muted);
    white-space: nowrap;
  }
  .provider-model-trigger {
    display: inline-flex;
    min-height: 30px;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-5) var(--space-7);
    border: 0;
    border-radius: var(--radius-sm);
    color: inherit;
    background: transparent;
    font: inherit;
    cursor: pointer;
  }
  .provider-model-trigger:hover,
  .provider-model-trigger:focus-visible,
  .provider-model-trigger[aria-expanded="true"] {
    outline: 0;
    background: var(--ghost-bg);
  }
  .provider-model-trigger i {
    color: var(--fg-faint);
    font-size: var(--text-2xs);
