---
import type { Locale } from '../i18n/ui'
import { authCopy } from '../i18n/auth'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = authCopy(locale)
---

<section class="container market-admin" data-market-admin data-copy={JSON.stringify(copy)} data-locale={locale}>
  <header class="market-admin-head">
    <p class="market-eyebrow">CodeY Marketplace</p>
    <h1>{copy.adminTitle}</h1>
    <p>{copy.adminDescription}</p>
  </header>
  <div class="market-admin-state" data-admin-state>{copy.adminLoading}</div>
  <div class="market-admin-queue" data-admin-queue></div>
</section>

<script>
  import { localizedApiError } from '../i18n/api-errors'

  type User = { role: 'user' | 'admin' }
  type AuthResponse = { user?: User | null }
  type Submission = {
    submissionId: string
    owner: { displayName: string; username: string }
    preview: { packageId: string; version: string; requestedPermissions: string[] }
    request: { title: string; summary: string }
    submittedAt: string
  }

  const root = document.querySelector<HTMLElement>('[data-market-admin]')
  if (root) {
    const copy = JSON.parse(root.dataset.copy || '{}') as Record<string, string>
    const locale = root.dataset.locale === 'en' ? 'en' : 'zh-CN'
    const state = root.querySelector<HTMLElement>('[data-admin-state]')!
    const queue = root.querySelector<HTMLElement>('[data-admin-queue]')!

    function text(tag: string, value: string, className?: string): HTMLElement {
      const element = document.createElement(tag)
      element.textContent = value
      if (className) element.className = className
      return element
    }

    async function errorMessage(response: Response): Promise<string> {
      return localizedApiError(response, locale, copy.adminLoadError)
    }

    function renderSubmission(submission: Submission): HTMLElement {
      const card = document.createElement('article')
      card.className = 'market-admin-card'
      card.dataset.submissionId = submission.submissionId
      const header = document.createElement('div')
      header.className = 'market-admin-card-head'
      const title = document.createElement('div')
      title.append(text('h2', submission.request.title), text('p', submission.request.summary))
      const status = text('span', 'PENDING', 'market-admin-status')
      header.append(title, status)
      card.append(header)

      const meta = document.createElement('dl')
      const fields = [
        [copy.uploader, `${submission.owner.displayName} (@${submission.owner.username})`],
        [copy.packageVersion, `${submission.preview.packageId} · ${submission.preview.version}`],
        [copy.submittedAt, new Intl.DateTimeFormat(locale, { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(submission.submittedAt))],
        [copy.permissions, submission.preview.requestedPermissions.join(', ') || copy.noPermissions],
      ]
      fields.forEach(([label, value]) => {
        const row = document.createElement('div')
        row.append(text('dt', label), text('dd', value))
        meta.append(row)
      })
      card.append(meta)

      const note = document.createElement('textarea')
      note.placeholder = copy.reviewNote
      note.maxLength = 1000
      note.setAttribute('aria-label', copy.reviewNote)
      const actions = document.createElement('div')
      actions.className = 'market-admin-actions'
      const approve = text('button', copy.approve, 'btn btn-primary') as HTMLButtonElement
      const reject = text('button', copy.reject, 'btn btn-ghost') as HTMLButtonElement
      approve.type = 'button'
      reject.type = 'button'
      actions.append(approve, reject)
      const message = text('p', '', 'market-admin-message')
      message.hidden = true
      card.append(note, actions, message)

      async function decide(decision: 'approve' | 'reject', button: HTMLButtonElement): Promise<void> {
        approve.disabled = true
        reject.disabled = true
        const original = button.textContent || ''
        button.textContent = decision === 'approve' ? copy.approving : copy.rejecting
        message.hidden = true
        try {
          const response = await fetch(`/api/market/v1/admin/submissions/${encodeURIComponent(submission.submissionId)}/${decision}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ note: note.value.trim() || null }),
          })
          if (!response.ok) throw new Error(await errorMessage(response))
          card.remove()
          if (!queue.childElementCount) {
            state.textContent = copy.adminEmpty
            state.hidden = false
          }
        } catch (reason) {
          message.textContent = reason instanceof Error ? reason.message : copy.adminLoadError
          message.hidden = false
          approve.disabled = false
          reject.disabled = false
          button.textContent = original
        }
      }
      approve.addEventListener('click', () => void decide('approve', approve))
      reject.addEventListener('click', () => void decide('reject', reject))
      return card
    }

    async function load(user: User | null | undefined): Promise<void> {
      queue.replaceChildren()
      state.hidden = false
      if (!user) {
        state.textContent = copy.signInRequired
        window.dispatchEvent(new CustomEvent('market-auth-required'))
        return
      }
      if (user.role !== 'admin') {
        state.textContent = copy.adminRequired
        return
      }
      state.textContent = copy.adminLoading
      try {
        const response = await fetch('/api/market/v1/admin/submissions', { headers: { Accept: 'application/json' } })
        if (!response.ok) throw new Error(await errorMessage(response))
        const submissions = (await response.json()) as Submission[]
        submissions.forEach((submission) => queue.append(renderSubmission(submission)))
        state.textContent = copy.adminEmpty
        state.hidden = submissions.length > 0
      } catch {
        state.textContent = copy.adminLoadError
      }
    }

    window.addEventListener('market-auth-changed', ((event: CustomEvent<AuthResponse>) => {
      void load(event.detail.user)
    }) as EventListener)
    fetch('/api/market/v1/auth/me', { headers: { Accept: 'application/json' } })
      .then(async (response) => response.ok ? response.json() as Promise<AuthResponse> : Promise.reject())
      .then((payload) => void load(payload.user))
      .catch(() => {
        state.textContent = copy.adminLoadError
      })
  }
</script>

<style>
  .market-admin { padding-block: clamp(52px, 8vw, 88px) clamp(72px, 10vw, 120px); }
  .market-admin-head { max-width: 760px; margin-bottom: 34px; }
  .market-admin-head h1 { margin-top: 8px; font-size: clamp(2rem, 5vw, 3.4rem); }
  .market-admin-head > p:last-child { margin: 14px 0 0; color: var(--fg-muted); }
  .market-admin-state { padding: 52px 24px; border: 1px dashed var(--border); border-radius: var(--radius-lg); color: var(--fg-muted); text-align: center; }
  .market-admin-queue { display: grid; gap: 18px; }
  .market-admin-card { padding: clamp(22px, 4vw, 32px); border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--panel-glass); }
  .market-admin-card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; }
  .market-admin-card-head h2 { font-size: 1.25rem; }
  .market-admin-card-head p { margin: 8px 0 0; color: var(--fg-muted); font-size: 0.88rem; }
  .market-admin-status { padding: 5px 8px; border: 1px solid var(--border); border-radius: 999px; color: var(--accent-bright); background: var(--accent-soft); font: 0.68rem var(--font-mono); }
  .market-admin-card dl { display: grid; gap: 10px; margin: 24px 0; }
  .market-admin-card dl div { display: grid; grid-template-columns: minmax(100px, 0.25fr) 1fr; gap: 16px; }
  .market-admin-card dt { color: var(--fg-faint); font-size: 0.76rem; }
  .market-admin-card dd { margin: 0; color: var(--fg-muted); font-size: 0.82rem; overflow-wrap: anywhere; }
  .market-admin-card textarea { width: 100%; min-height: 84px; padding: 11px 12px; resize: vertical; }
  .market-admin-actions { display: flex; gap: 10px; margin-top: 14px; }
  .market-admin-message { margin: 12px 0 0; color: var(--danger); font-size: 0.8rem; }
  @media (max-width: 560px) { .market-admin-card-head { flex-direction: column; } .market-admin-card dl div { grid-template-columns: 1fr; gap: 3px; } .market-admin-actions { align-items: stretch; flex-direction: column; } }
</style>
