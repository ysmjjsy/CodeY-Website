---
import type { Locale } from '../i18n/ui'
import { marketCopy } from '../i18n/market'
import { docsPath, marketPath } from '../i18n/utils'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = marketCopy(locale)
const apiBase = '/api/market/v1'
const [discoverTitlePrefix, discoverTitleSuffix = ''] = copy.discoverTitle.split('CodeY')
---

<section
  class="market-browser"
  data-market-catalog
  data-api-base={apiBase}
  data-detail-base={marketPath(locale, 'item')}
  data-locale={locale}
  data-copy={JSON.stringify(copy)}
>
  <div class="market-results">
    <header class="market-results-head market-hero">
      <div>
        <p class="market-eyebrow">{copy.eyebrow}</p>
        <h1>
          {discoverTitlePrefix}<span>CodeY</span>{discoverTitleSuffix}
        </h1>
        <p>{copy.description}</p>
      </div>
      <div class="market-hero-actions">
        <form class="market-search" data-market-search>
          <label class="sr-only" for="market-query">{copy.searchLabel}</label>
          <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
          <input
            id="market-query"
            name="q"
            type="search"
            autocomplete="off"
            placeholder={copy.searchPlaceholder}
          />
          <button type="submit" aria-label={copy.search}><kbd>⌘ K</kbd></button>
        </form>
        <button class="btn btn-primary market-upload-button" type="button" data-market-upload-open>
          <i class="ph ph-upload-simple" aria-hidden="true"></i>{copy.upload}
        </button>
      </div>
    </header>

    <div class="market-toolbar">
      <nav class="market-category-list" aria-label={copy.categories} data-market-filters>
        <button class="market-category is-active" type="button" data-kind="" aria-pressed="true">
          <i class="ph ph-squares-four" aria-hidden="true"></i><span>{copy.all}</span>
        </button>
        <button class="market-category" type="button" data-kind="agent_template" aria-pressed="false">
          <i class="ph ph-user" aria-hidden="true"></i><span>{copy.agentTemplate}</span>
        </button>
        <button class="market-category" type="button" data-kind="team_template" aria-pressed="false">
          <i class="ph ph-users-three" aria-hidden="true"></i><span>{copy.teamTemplate}</span>
        </button>
        <button class="market-category" type="button" data-kind="workflow_template" aria-pressed="false">
          <i class="ph ph-flow-arrow" aria-hidden="true"></i><span>{copy.workflowTemplate}</span>
        </button>
        <button class="market-category" type="button" data-kind="skill" aria-pressed="false">
          <i class="ph ph-wrench" aria-hidden="true"></i><span>{copy.skill}</span>
        </button>
        <button class="market-category" type="button" data-kind="mcp" aria-pressed="false">
          <i class="ph ph-plugs" aria-hidden="true"></i><span>{copy.mcp}</span>
        </button>
      </nav>
      <p class="market-result-count" data-result-count aria-live="polite"></p>
    </div>

    <div class="market-grid" data-market-grid aria-live="polite"></div>
    <div class="market-state" data-market-state>{copy.loading}</div>
    <section class="market-empty" data-market-empty hidden aria-labelledby="market-empty-title">
      <div class="market-empty-copy">
        <h2 id="market-empty-title" data-market-empty-title>{copy.emptyTitle}</h2>
        <p data-market-empty-description>{copy.emptyDescription}</p>
        <div class="market-empty-actions" data-market-inventory-actions>
          <button class="btn btn-primary" type="button" data-market-upload-open>
            <i class="ph ph-upload-simple" aria-hidden="true"></i>{copy.publishFirst}
          </button>
          <a class="btn btn-ghost" href={docsPath(locale, 'sdk/agent-definitions')}>
            <i class="ph ph-file-code" aria-hidden="true"></i>{copy.learnPackage}
          </a>
        </div>
        <div class="market-empty-actions" data-market-no-results-actions hidden>
          <button class="btn btn-primary" type="button" data-market-clear-filters>
            <i class="ph ph-x-circle" aria-hidden="true"></i>{copy.clearFilters}
          </button>
        </div>
      </div>
      <picture class="market-empty-visual">
        <img class="market-empty-visual-light" src="/images/market/empty-market-light.png" alt="" width="720" height="440" />
        <img class="market-empty-visual-dark" src="/images/market/empty-market-dark.png" alt="" width="720" height="440" />
      </picture>
    </section>
    <p class="market-trust-note">
      <i class="ph ph-shield-check" aria-hidden="true"></i>{copy.trustNote}
    </p>
    <div class="market-load-more" hidden data-market-more>
      <button class="btn btn-ghost" type="button">{copy.loadMore}</button>
    </div>
  </div>
</section>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  type Listing = {
    listingId: string
    packageId?: string
    kind: 'agent_template' | 'team_template' | 'workflow_template' | 'skill' | 'mcp'
    title: string
    summary: string
    tags: string[]
    publisherDisplayName: string
    downloadCount: number
    updatedAt: string
    latestRelease: { version: string; publishedAt?: string }
  }

  type CatalogResponse = { listings: Listing[]; nextCursor?: string | null }

  const root = document.querySelector<HTMLElement>('[data-market-catalog]')
  if (root) {
    const apiBase = root.dataset.apiBase || '/api/market/v1'
    const detailBase = root.dataset.detailBase || '/market/item/'
    const locale = root.dataset.locale === 'en' ? 'en' : 'zh-CN'
    const copy = JSON.parse(root.dataset.copy || '{}') as Record<string, string>
    const grid = root.querySelector<HTMLElement>('[data-market-grid]')!
    const state = root.querySelector<HTMLElement>('[data-market-state]')!
    const empty = root.querySelector<HTMLElement>('[data-market-empty]')!
    const emptyTitle = root.querySelector<HTMLElement>('[data-market-empty-title]')!
    const emptyDescription = root.querySelector<HTMLElement>('[data-market-empty-description]')!
    const inventoryActions = root.querySelector<HTMLElement>('[data-market-inventory-actions]')!
    const noResultsActions = root.querySelector<HTMLElement>('[data-market-no-results-actions]')!
    const clearFilters = root.querySelector<HTMLButtonElement>('[data-market-clear-filters]')!
    const more = root.querySelector<HTMLElement>('[data-market-more]')!
    const moreButton = more.querySelector<HTMLButtonElement>('button')!
    const search = root.querySelector<HTMLFormElement>('[data-market-search]')!
    const queryInput = search.elements.namedItem('q') as HTMLInputElement
    const filterButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-kind]'))
    const resultCount = root.querySelector<HTMLElement>('[data-result-count]')!
    let activeKind = ''
    let nextCursor: string | null = null
    let loading = false

    const kindCopy: Record<Listing['kind'], string> = {
      agent_template: copy.agentTemplate,
      team_template: copy.teamTemplate,
      workflow_template: copy.workflowTemplate,
      skill: copy.skill,
      mcp: copy.mcp,
    }
    const kindIcon: Record<Listing['kind'], string> = {
      agent_template: 'user',
      team_template: 'users-three',
      workflow_template: 'flow-arrow',
      skill: 'wrench',
      mcp: 'plugs',
    }

    function text(tag: string, value: string, className?: string): HTMLElement {
      const element = document.createElement(tag)
      element.textContent = value
      if (className) element.className = className
      return element
    }

    function icon(name: string, className = ''): HTMLElement {
      const element = document.createElement('i')
      element.className = `ph ph-${name}${className ? ` ${className}` : ''}`
      element.setAttribute('aria-hidden', 'true')
      return element
    }

    function formatDate(value: string): string {
      const date = new Date(value)
      if (Number.isNaN(date.getTime())) return value
      return new Intl.DateTimeFormat(locale, { year: 'numeric', month: '2-digit', day: '2-digit' }).format(date)
    }

    function isNew(listing: Listing): boolean {
      const value = listing.latestRelease.publishedAt || listing.updatedAt
      const timestamp = new Date(value).getTime()
      return Number.isFinite(timestamp) && Date.now() - timestamp < 1000 * 60 * 60 * 24 * 30
    }

    function card(listing: Listing): HTMLAnchorElement {
      const link = document.createElement('a')
      link.className = 'market-card'
      link.href = `${detailBase}?id=${encodeURIComponent(listing.listingId)}`
      link.setAttribute('aria-label', `${listing.title} · ${kindCopy[listing.kind]}`)

      const cardIcon = icon(kindIcon[listing.kind], `market-card-icon market-card-icon-${listing.kind}`)

      const body = document.createElement('div')
      body.className = 'market-card-body'
      const titleRow = document.createElement('div')
      titleRow.className = 'market-card-title-row'
      titleRow.append(text('h2', listing.title))
      if (isNew(listing)) titleRow.append(text('span', copy.newLabel, 'market-new'))
      body.append(titleRow)
      body.append(text('p', listing.summary, 'market-card-summary'))

      const attributes = document.createElement('div')
      attributes.className = 'market-card-attributes'
      attributes.append(text('span', kindCopy[listing.kind], 'market-card-kind'))
      attributes.append(text('span', `v${listing.latestRelease.version}`, 'market-card-version'))
      listing.tags.slice(0, 3).forEach((tag) => attributes.append(text('span', tag, 'market-tag')))
      body.append(attributes)

      const meta = document.createElement('div')
      meta.className = 'market-card-meta'
      const publisher = text('span', listing.publisherDisplayName, 'market-card-publisher')
      publisher.prepend(icon('user-circle'))
      meta.append(publisher)
      const updated = text('span', formatDate(listing.updatedAt))
      updated.prepend(icon('clock'))
      meta.append(updated)
      const downloads = text('span', new Intl.NumberFormat(locale, { notation: 'compact' }).format(listing.downloadCount))
      downloads.prepend(icon('download-simple'))
      meta.append(downloads)

      link.append(cardIcon, body, meta)
      return link
    }

    function updateCount(): void {
      const count = grid.childElementCount
      resultCount.textContent = `${new Intl.NumberFormat(locale).format(count)} ${copy.loadedSuffix}`
    }

    function showEmptyState(filtered: boolean): void {
      emptyTitle.textContent = filtered ? copy.noResultsTitle : copy.emptyTitle
      emptyDescription.textContent = filtered ? copy.noResultsDescription : copy.emptyDescription
      inventoryActions.hidden = filtered
      noResultsActions.hidden = !filtered
      empty.hidden = false
    }

    async function load(append = false): Promise<void> {
      if (loading) return
      loading = true
      state.hidden = append
      empty.hidden = true
      if (!append) {
        state.textContent = copy.loading
        grid.replaceChildren()
        more.hidden = true
        resultCount.textContent = ''
      }
      try {
        const url = new URL(`${apiBase}/listings`, window.location.origin)
        const query = queryInput.value.trim()
        if (query) url.searchParams.set('q', query)
        if (activeKind) url.searchParams.set('kind', activeKind)
        if (append && nextCursor) url.searchParams.set('cursor', nextCursor)
        const response = await fetch(url, { headers: { Accept: 'application/json' } })
        if (!response.ok) throw new Error(`HTTP ${response.status}`)
        const payload = (await response.json()) as CatalogResponse
        payload.listings.forEach((listing) => grid.append(card(listing)))
        updateCount()
        nextCursor = payload.nextCursor || null
        more.hidden = !nextCursor
        state.hidden = true
        if (grid.childElementCount > 0) empty.hidden = true
        else showEmptyState(Boolean(query || activeKind))
      } catch {
        if (!append) {
          empty.hidden = true
          state.replaceChildren(text('span', copy.unavailable))
          const retry = text('button', copy.retry, 'btn btn-ghost') as HTMLButtonElement
          retry.type = 'button'
          retry.addEventListener('click', () => void load())
          state.append(document.createElement('br'), retry)
          state.hidden = false
        }
      } finally {
        loading = false
      }
    }

    search.addEventListener('submit', (event) => {
      event.preventDefault()
      nextCursor = null
      void load()
    })
    clearFilters.addEventListener('click', () => {
      queryInput.value = ''
      activeKind = ''
      filterButtons.forEach((item, index) => {
        const active = index === 0
        item.setAttribute('aria-pressed', String(active))
        item.classList.toggle('is-active', active)
      })
      nextCursor = null
      void load()
    })
    window.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault()
        queryInput.focus()
      }
    })
    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        activeKind = button.dataset.kind || ''
        filterButtons.forEach((item) => {
          const active = item === button
          item.setAttribute('aria-pressed', String(active))
          item.classList.toggle('is-active', active)
        })
        nextCursor = null
        void load()
      })
    })
    moreButton.addEventListener('click', () => void load(true))
    void load()
  }
</script>
