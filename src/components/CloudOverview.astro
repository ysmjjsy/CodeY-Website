---
import type { Locale } from '../i18n/ui'
import { cloudCopy } from '../i18n/cloud'
import { modelsPath, pricingPath } from '../i18n/utils'
import Button from './ui/Button.astro'
import PageHeader from './ui/PageHeader.astro'
import Panel from './ui/Panel.astro'
import StateMessage from './ui/StateMessage.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = cloudCopy(locale)
---

<section class="cloud-overview" data-cloud-overview data-locale={locale} data-copy={JSON.stringify(copy)}>
  <PageHeader class="overview-head" title={copy.accountTitle} description={copy.accountDescription} actionsClass="overview-actions">
    <Button slot="actions" href={modelsPath(locale)}>{copy.browseModels}</Button>
    <Button slot="actions" variant="primary" href={pricingPath(locale)}>{copy.browsePlans}</Button>
  </PageHeader>

  <StateMessage class="overview-state" data-state>{copy.loading}</StateMessage>

  <div hidden data-content>
    <section class="summary-grid" aria-label={copy.credits}>
      <Panel as="article" class="summary-card summary-card-primary"><span>{copy.credits}</span><strong data-available>0</strong></Panel>
      <Panel as="article" class="summary-card"><span>{copy.expiring}</span><strong data-expiring>0</strong></Panel>
      <Panel as="article" class="summary-card"><span>{copy.permanent}</span><strong data-permanent>0</strong></Panel>
      <Panel as="article" class="summary-card"><span>{copy.reserved}</span><strong data-reserved>0</strong></Panel>
    </section>

    <Panel as="section" class="plan-summary">
      <div><span>{copy.currentPlan}</span><strong data-plan>—</strong></div>
      <div><span data-period-label>{copy.activeUntil}</span><strong data-period>—</strong></div>
      <div hidden data-scheduled-wrap><span>{copy.scheduled}</span><strong data-scheduled>—</strong></div>
      <a href={pricingPath(locale)}>{copy.browsePlans}<i class="ph ph-arrow-right" aria-hidden="true"></i></a>
    </Panel>
  </div>
</section>

<script>
  import { toast } from '../lib/toast'

  type Plan = { planId: string; displayName: string }
  type PlanCatalog = { plans: Plan[] }
  type Account = {
    subscription: { planId: string; status: 'active' | 'expired'; currentPeriodEnd: string; scheduledPlanId?: string | null }
    wallet: { availableCreditMicros: number; reservedCreditMicros: number; expiringCreditMicros: number; permanentCreditMicros: number }
  }

  const root = document.querySelector<HTMLElement>('[data-cloud-overview]')
  if (root) {
    const locale = root.dataset.locale === 'en' ? 'en' : 'zh-CN'
    const copy = JSON.parse(root.dataset.copy || '{}') as Record<string, string>
    const state = root.querySelector<HTMLElement>('[data-state]')!
    const content = root.querySelector<HTMLElement>('[data-content]')!
    const points = (value: number): string => new Intl.NumberFormat(locale, { maximumFractionDigits: 2 }).format(value / 1_000_000)
    const date = (value: string): string => new Intl.DateTimeFormat(locale, { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(value))

    async function load(): Promise<void> {
      state.hidden = false
      state.textContent = copy.loading
      try {
        const [meResponse, plansResponse] = await Promise.all([
          fetch('/api/cloud/v1/me', { headers: { Accept: 'application/json' } }),
          fetch('/api/cloud/v1/plans', { headers: { Accept: 'application/json' } }),
        ])
        if (meResponse.status === 401) {
          window.dispatchEvent(new CustomEvent('market-auth-required'))
          throw new Error(copy.signIn)
        }
        if (!meResponse.ok || !plansResponse.ok) throw new Error(copy.unavailable)
        const account = await meResponse.json() as Account
        const catalog = await plansResponse.json() as PlanCatalog
        const planById = new Map(catalog.plans.map((plan) => [plan.planId, plan.displayName]))
        root.querySelector<HTMLElement>('[data-available]')!.textContent = points(account.wallet.availableCreditMicros)
        root.querySelector<HTMLElement>('[data-expiring]')!.textContent = points(account.wallet.expiringCreditMicros)
        root.querySelector<HTMLElement>('[data-permanent]')!.textContent = points(account.wallet.permanentCreditMicros)
        root.querySelector<HTMLElement>('[data-reserved]')!.textContent = points(account.wallet.reservedCreditMicros)
        root.querySelector<HTMLElement>('[data-plan]')!.textContent = planById.get(account.subscription.planId) || account.subscription.planId
        root.querySelector<HTMLElement>('[data-period-label]')!.textContent = account.subscription.status === 'expired' ? copy.expired : copy.activeUntil
        root.querySelector<HTMLElement>('[data-period]')!.textContent = date(account.subscription.currentPeriodEnd)
        const scheduledWrap = root.querySelector<HTMLElement>('[data-scheduled-wrap]')!
        scheduledWrap.hidden = !account.subscription.scheduledPlanId
        root.querySelector<HTMLElement>('[data-scheduled]')!.textContent = planById.get(account.subscription.scheduledPlanId || '') || account.subscription.scheduledPlanId || '—'
        state.hidden = true
        content.hidden = false
      } catch (reason) {
        content.hidden = true
        toast.error(reason instanceof Error ? reason.message : copy.unavailable)
        const retry = document.createElement('button')
        retry.type = 'button'
        retry.className = 'btn btn-ghost'
        retry.textContent = copy.retry
        retry.onclick = () => void load()
        state.replaceChildren(retry)
      }
    }

    window.addEventListener('market-auth-changed', () => void load())
    void load()
  }
</script>

<style is:global>
  .overview-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; }
  .overview-head p { margin: 10px 0 0; color: var(--fg-muted); font-size: .88rem; }
  .overview-actions { display: flex; gap: 9px; }
  .overview-state { display: grid; min-height: 156px; place-items: center; margin: 28px 0 0; padding: 24px; border: 1px dashed var(--border-strong); border-radius: var(--radius-lg); color: var(--fg-muted); background: var(--panel-glass); }
  .summary-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 28px; }
  .summary-card, .plan-summary { border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--panel-glass); box-shadow: inset 0 1px 0 var(--panel-inset); }
  .summary-card { display: grid; gap: 8px; padding: 20px; }
  .summary-card span, .plan-summary span { color: var(--fg-muted); font-size: .75rem; }
  .summary-card strong { font: 600 1.5rem var(--font-mono); }
  .summary-card-primary { border-color: color-mix(in srgb, var(--accent) 32%, var(--border)); background: color-mix(in srgb, var(--accent) 6%, var(--panel-glass)); }
  .plan-summary { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)) auto; align-items: center; gap: 24px; margin-top: 12px; padding: 20px 22px; }
  .plan-summary > div { display: grid; gap: 6px; }
  .plan-summary a { display: flex; align-items: center; gap: 7px; color: var(--accent-bright); font-size: .8rem; white-space: nowrap; }
  @media (max-width: 900px) { .summary-grid { grid-template-columns: repeat(2, 1fr); } .plan-summary { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 620px) { .overview-head { align-items: stretch; flex-direction: column; } .overview-actions { display: grid; grid-template-columns: 1fr 1fr; } .overview-actions .btn { justify-content: center; } .summary-grid, .plan-summary { grid-template-columns: 1fr; } }
</style>
