---
import type { Locale } from '../i18n/ui'
import { downloadPath, t } from '../i18n/utils'
import HeroVisual from './HeroVisual.astro'
import Button from './ui/Button.astro'
import Container from './ui/Container.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const downloadHref = downloadPath(locale)
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true"></div>
  <Container class="hero-grid">
    <div class="hero-copy">
      <p class="hero-badge">
        <span class="badge-dot"></span>
        {t(locale, 'hero.badge')}
      </p>
      <h1 class="hero-title">
        {t(locale, 'hero.title.line1')}<br />
        <span class="hero-title-accent">{t(locale, 'hero.title.line2')}</span>
      </h1>
      <p class="hero-sub">{t(locale, 'hero.sub')}</p>
      <div class="hero-actions">
        <Button variant="primary" href={downloadHref}>
          <i class="ph ph-download-simple" aria-hidden="true"></i>
          {t(locale, 'hero.cta')}
        </Button>
      </div>
      <p class="hero-meta">{t(locale, 'hero.meta')}</p>
    </div>

    <HeroVisual locale={locale} />
  </Container>
</section>

<style>
  .hero {
    position: relative;
    padding-top: var(--space-172);
    padding-bottom: var(--space-120);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, black 20%, transparent 78%);
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr);
    gap: var(--space-64);
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    margin: 0 0 var(--space-24);
    padding: var(--space-6) var(--space-14);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    font-size: 0.8rem;
    font-family: var(--font-mono);
    color: var(--fg-muted);
    background: var(--chip-bg);
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--amber);
    box-shadow: 0 0 8px var(--amber);
  }

  .hero-title {
    font-size: clamp(2.1rem, 7vw, 4rem);
    font-weight: 700;
    line-height: 1.14;
    text-wrap: balance;
  }

  .hero-title-accent {
    color: var(--accent-bright);
  }

  .hero-sub {
    color: var(--fg-muted);
    font-size: clamp(0.98rem, 2.4vw, 1.08rem);
    max-width: 34em;
    margin: var(--space-24) 0 var(--space-36);
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-14);
    flex-wrap: wrap;
  }

  .hero-meta {
    margin-top: var(--space-28);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--fg-faint);
    letter-spacing: 0.02em;
  }

@media (max-width: 920px) {
    .hero {
      padding-top: var(--space-140);
      padding-bottom: var(--space-80);
    }
    .hero-grid {
      grid-template-columns: 1fr;
      gap: var(--space-48);
    }
  }

@media (max-width: 640px) {
    .hero {
      padding-top: var(--space-112);
      padding-bottom: var(--space-64);
    }
    .hero-grid {
      gap: var(--space-40);
    }
    .hero-badge {
      max-width: 100%;
      white-space: normal;
      line-height: 1.4;
    }
    .hero-actions .btn {
      flex: 1 1 auto;
      justify-content: center;
    }
    .hero-meta {
      line-height: 1.6;
    }
  }
</style>

