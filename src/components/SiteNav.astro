---
import { Image } from 'astro:assets'
import logo from '../assets/logo.png'
import type { Locale } from '../i18n/ui'
import { docsPath, homePath, t } from '../i18n/utils'
import ThemeToggle from './ThemeToggle.astro'
import LangToggle from './LangToggle.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<header class="site-nav" id="site-nav">
  <div class="container nav-inner">
    <a href={homePath(locale)} class="nav-brand">
      <Image src={logo} alt="CodeY" width="30" height="30" />
      <span>CodeY</span>
    </a>

    <nav class="nav-links" id="nav-menu" aria-label={t(locale, 'nav.aria')}>
      <a href="#features">{t(locale, 'nav.features')}</a>
      <a href="#architecture">{t(locale, 'nav.architecture')}</a>
      <a href="#sdk">{t(locale, 'nav.sdk')}</a>
      <a href={docsPath(locale, 'intro')}>{t(locale, 'nav.docs')}</a>
      <a class="btn btn-primary nav-cta-mobile" href={docsPath(locale, 'getting-started')}>
        {t(locale, 'nav.cta')}
      </a>
    </nav>

    <div class="nav-actions">
      <LangToggle locale={locale} />
      <ThemeToggle locale={locale} />
      <a
        class="nav-github"
        href="https://github.com/ysmjjsy/CodeY"
        target="_blank"
        rel="noopener"
        aria-label={t(locale, 'nav.github')}
      >
        <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
      </a>
      <a class="btn btn-primary nav-cta" href={docsPath(locale, 'getting-started')}>
        {t(locale, 'nav.cta')}
      </a>
      <button
        class="nav-toggle"
        type="button"
        id="nav-toggle"
        aria-controls="nav-menu"
        aria-expanded="false"
        aria-label={t(locale, 'nav.menu.open')}
        data-label-open={t(locale, 'nav.menu.open')}
        data-label-close={t(locale, 'nav.menu.close')}
      >
        <span class="nav-toggle-bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
  <div class="nav-backdrop" id="nav-backdrop" hidden></div>
</header>

<style>
  .site-nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition: background 0.25s, border-color 0.25s, backdrop-filter 0.25s;
  }

  .site-nav.is-scrolled,
  .site-nav.is-open {
    background: var(--nav-scrolled-bg);
    backdrop-filter: blur(14px) saturate(160%);
    border-bottom-color: var(--border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 68px;
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    flex-shrink: 0;
    z-index: 2;
  }

  .nav-brand img {
    border-radius: 8px;
  }

  .nav-links {
    display: flex;
    gap: 28px;
    margin-inline: auto;
  }

  .nav-links a {
    font-size: 0.92rem;
    color: var(--fg-muted);
    transition: color 0.15s;
  }

  .nav-links a:hover {
    color: var(--fg);
  }

  .nav-cta-mobile {
    display: none;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    z-index: 2;
  }

  .nav-github {
    color: var(--fg-muted);
    display: inline-flex;
    transition: color 0.15s;
  }

  .nav-github:hover {
    color: var(--fg);
  }

  .nav-cta {
    padding: 8px 18px;
    font-size: 0.88rem;
  }

  .nav-toggle {
    display: none;
    appearance: none;
    border: 1px solid var(--border-strong);
    background: var(--ghost-bg);
    color: var(--fg);
    width: 40px;
    height: 36px;
    border-radius: 8px;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: border-color 0.15s, background 0.15s;
  }

  .nav-toggle:hover {
    border-color: var(--border-hover);
    background: var(--ghost-bg-hover);
  }

  .nav-toggle-bars,
  .nav-toggle-bars::before,
  .nav-toggle-bars::after {
    display: block;
    width: 16px;
    height: 1.5px;
    background: currentColor;
    border-radius: 1px;
    transition: transform 0.2s var(--ease-out), opacity 0.2s;
  }

  .nav-toggle-bars {
    position: relative;
  }

  .nav-toggle-bars::before,
  .nav-toggle-bars::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .nav-toggle-bars::before {
    top: -5px;
  }

  .nav-toggle-bars::after {
    top: 5px;
  }

  .site-nav.is-open .nav-toggle-bars {
    background: transparent;
  }

  .site-nav.is-open .nav-toggle-bars::before {
    top: 0;
    transform: rotate(45deg);
  }

  .site-nav.is-open .nav-toggle-bars::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .nav-backdrop {
    display: none;
  }

  @media (max-width: 960px) {
    .nav-inner {
      gap: 12px;
    }

    .nav-actions {
      margin-left: auto;
    }

    .nav-toggle {
      display: inline-flex;
    }

    .nav-cta {
      display: none;
    }

    .nav-links {
      position: fixed;
      top: 68px;
      left: 0;
      right: 0;
      margin: 0;
      flex-direction: column;
      gap: 0;
      padding: 12px 0 20px;
      background: var(--nav-scrolled-bg);
      backdrop-filter: blur(14px) saturate(160%);
      border-bottom: 1px solid var(--border);
      max-height: min(70vh, 420px);
      overflow-y: auto;
      transform: translateY(-8px);
      opacity: 0;
      pointer-events: none;
      visibility: hidden;
      z-index: 51;
      transition:
        opacity 0.2s var(--ease-out),
        transform 0.2s var(--ease-out),
        visibility 0.2s;
    }

    .site-nav.is-open .nav-links {
      opacity: 1;
      transform: none;
      pointer-events: auto;
      visibility: visible;
    }

    .nav-links a {
      padding: 14px clamp(16px, 4vw, 24px);
      font-size: 1rem;
      color: var(--fg);
      border-top: 1px solid var(--border);
    }

    .nav-cta-mobile {
      display: inline-flex;
      margin: 16px clamp(16px, 4vw, 24px) 4px;
      justify-content: center;
      border-top: none !important;
      padding: 12px 24px !important;
    }

    .nav-backdrop {
      display: block;
      position: fixed;
      inset: 68px 0 0 0;
      background: rgba(0, 0, 0, 0.42);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s;
      z-index: -1;
    }

    .site-nav.is-open .nav-backdrop {
      opacity: 1;
      pointer-events: auto;
    }

    .nav-backdrop[hidden] {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .nav-brand span {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .nav-actions {
      gap: 6px;
    }

    .nav-actions :global(.theme-toggle select) {
      padding-inline: 8px 24px;
      max-width: 7.5rem;
    }

    .nav-actions :global(.lang-toggle) {
      padding-inline: 8px;
    }
  }
</style>

<script>
  const nav = document.getElementById('site-nav')
  const toggle = document.getElementById('nav-toggle')
  const backdrop = document.getElementById('nav-backdrop')
  const menu = document.getElementById('nav-menu')
  const page = document.querySelector('main')
  const footer = document.querySelector('.site-footer')

  let hideBackdropTimer = 0

  const setPageInert = (inert: boolean) => {
    if (page instanceof HTMLElement) page.inert = inert
    if (footer instanceof HTMLElement) footer.inert = inert
  }

  const clearHideBackdrop = () => {
    if (hideBackdropTimer) {
      window.clearTimeout(hideBackdropTimer)
      hideBackdropTimer = 0
    }
  }

  const setOpen = (open: boolean) => {
    const wasOpen = nav?.classList.contains('is-open')
    if (open && backdrop) {
      clearHideBackdrop()
      backdrop.hidden = false
    }

    nav?.classList.toggle('is-open', open)
    toggle?.setAttribute('aria-expanded', String(open))
    if (toggle instanceof HTMLButtonElement) {
      const label = open ? toggle.dataset.labelClose : toggle.dataset.labelOpen
      if (label) toggle.setAttribute('aria-label', label)
    }

    if (!open && backdrop && !backdrop.hidden) {
      const hide = () => {
        backdrop.hidden = true
        backdrop.removeEventListener('transitionend', hide)
        clearHideBackdrop()
      }
      backdrop.addEventListener('transitionend', hide)
      hideBackdropTimer = window.setTimeout(hide, 220)
    }

    document.documentElement.classList.toggle('nav-open', open)
    document.body.classList.toggle('nav-open', open)
    setPageInert(open)

    if (!open && wasOpen && toggle instanceof HTMLButtonElement) {
      toggle.focus()
    }
  }

  const onScroll = () => nav?.classList.toggle('is-scrolled', window.scrollY > 12)
  onScroll()
  window.addEventListener('scroll', onScroll, { passive: true })

  toggle?.addEventListener('click', () => {
    setOpen(!nav?.classList.contains('is-open'))
  })

  backdrop?.addEventListener('click', () => setOpen(false))

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false))
  })

  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false)
  })

  const media = window.matchMedia('(max-width: 960px)')
  const onBreakpoint = () => {
    if (!media.matches) setOpen(false)
  }
  media.addEventListener('change', onBreakpoint)
</script>
