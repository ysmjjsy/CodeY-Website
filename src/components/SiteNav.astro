---
import { Image } from 'astro:assets'
import logo from '../assets/logo.png'
import type { Locale } from '../i18n/ui'
import { docsPath, downloadPath, homePath, marketPath, modelsPath, pricingPath, t } from '../i18n/utils'
import ThemeToggle from './ThemeToggle.astro'
import LangToggle from './LangToggle.astro'
import AccountMenu from './AccountMenu.astro'
import Button from './ui/Button.astro'
import Container from './ui/Container.astro'

interface Props {
  locale: Locale
  alternateHref?: string
}

const { locale, alternateHref } = Astro.props
const home = homePath(locale)
const downloadHref = downloadPath(locale)
---

<header class="site-nav" id="site-nav">
  <Container class="nav-inner">
    <a href={homePath(locale)} class="nav-brand">
      <Image src={logo} alt="CodeY" width="30" height="30" />
      <span>CodeY</span>
    </a>

    <nav class="nav-links" id="nav-menu" aria-label={t(locale, 'nav.aria')}>
      <a href={home}>{t(locale, 'nav.product')}</a>
      <a href={downloadHref}>{t(locale, 'nav.download')}</a>
      <a href={modelsPath(locale)}>{t(locale, 'nav.models')}</a>
      <a href={pricingPath(locale)}>{t(locale, 'nav.pricing')}</a>
      <a href={marketPath(locale)}>{t(locale, 'nav.market')}</a>
      <a href={docsPath(locale, 'intro')}>{t(locale, 'nav.docs')}</a>
    </nav>

    <div class="nav-actions">
      <LangToggle locale={locale} href={alternateHref} />
      <ThemeToggle locale={locale} />
      <AccountMenu locale={locale} />
      <Button id="nav-cta" class="nav-cta" size="sm" variant="primary" href={docsPath(locale, 'getting-started')}>
        {t(locale, 'nav.cta')}
      </Button>
      <button
        class="nav-toggle"
        type="button"
        id="nav-toggle"
        aria-controls="nav-menu"
        aria-expanded="false"
        aria-label={t(locale, 'nav.menu.open')}
        data-label-open={t(locale, 'nav.menu.open')}
        data-label-close={t(locale, 'nav.menu.close')}
      >
        <span class="nav-toggle-bars" aria-hidden="true"></span>
      </button>
    </div>
  </Container>
  <div class="nav-backdrop" id="nav-backdrop" hidden></div>
</header>

<style>
  .site-nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition: background 0.25s, border-color 0.25s, backdrop-filter 0.25s;
  }

  .site-nav.is-scrolled,
  .site-nav.is-open {
    background: var(--nav-scrolled-bg);
    backdrop-filter: blur(14px) saturate(160%);
    border-bottom-color: var(--border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 68px;
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    flex-shrink: 0;
    z-index: 2;
  }

  .nav-brand img {
    border-radius: 8px;
  }

  .nav-links {
    display: flex;
    gap: 28px;
    margin-inline: auto;
  }

  .nav-links a {
    font-size: 0.92rem;
    color: var(--fg-muted);
    transition: color 0.15s;
  }

  .nav-links a:hover {
    color: var(--fg);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    z-index: 2;
  }

  .nav-actions .nav-cta {
    min-height: 34px;
    margin-left: 2px;
    padding: 6px 13px;
    border-radius: 9px;
    color: var(--btn-primary-fg);
    font-size: 0.8rem;
    line-height: 1;
    white-space: nowrap;
  }

  .nav-actions .nav-cta:hover,
  .nav-links .nav-cta:hover {
    color: var(--btn-primary-fg);
  }

  .nav-toggle {
    display: none;
    appearance: none;
    border: 1px solid var(--border-strong);
    background: var(--ghost-bg);
    color: var(--fg);
    width: 40px;
    height: 36px;
    border-radius: 8px;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: border-color 0.15s, background 0.15s;
  }

  .nav-toggle:hover {
    border-color: var(--border-hover);
    background: var(--ghost-bg-hover);
  }

  .nav-toggle-bars,
  .nav-toggle-bars::before,
  .nav-toggle-bars::after {
    display: block;
    width: 16px;
    height: 1.5px;
    background: currentColor;
    border-radius: 1px;
    transition: transform 0.2s var(--ease-out), opacity 0.2s;
  }

  .nav-toggle-bars {
    position: relative;
  }

  .nav-toggle-bars::before,
  .nav-toggle-bars::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .nav-toggle-bars::before {
    top: -5px;
  }

  .nav-toggle-bars::after {
    top: 5px;
  }

  .site-nav.is-open .nav-toggle-bars {
    background: transparent;
  }

  .site-nav.is-open .nav-toggle-bars::before {
    top: 0;
    transform: rotate(45deg);
  }

  .site-nav.is-open .nav-toggle-bars::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .nav-backdrop {
    display: none;
  }

  @media (max-width: 960px) {
    .nav-inner {
      gap: 12px;
    }

    .nav-actions {
      margin-left: auto;
    }

    .nav-toggle {
      display: inline-flex;
    }

    .nav-links {
      position: fixed;
      top: 68px;
      left: 0;
      right: 0;
      margin: 0;
      flex-direction: column;
      gap: 0;
      padding: 12px 0 20px;
      background: var(--nav-scrolled-bg);
      backdrop-filter: blur(14px) saturate(160%);
      border-bottom: 1px solid var(--border);
      max-height: min(70vh, 420px);
      overflow-y: auto;
      transform: translateY(-8px);
      opacity: 0;
      pointer-events: none;
      visibility: hidden;
      z-index: 51;
      transition:
        opacity 0.2s var(--ease-out),
        transform 0.2s var(--ease-out),
        visibility 0.2s;
    }

    .site-nav.is-open .nav-links {
      opacity: 1;
      transform: none;
      pointer-events: auto;
      visibility: visible;
    }

    .nav-links a {
      padding: 14px clamp(16px, 4vw, 24px);
      font-size: 1rem;
      color: var(--fg);
      border-top: 1px solid var(--border);
    }

    .nav-links .nav-cta {
      display: inline-flex;
      margin: 16px clamp(16px, 4vw, 24px) 4px;
      justify-content: center;
      border-top: none !important;
      padding: 12px 24px !important;
      font-size: 0.92rem;
    }

    .nav-backdrop {
      display: block;
      position: fixed;
      inset: 68px 0 0 0;
      background: rgba(0, 0, 0, 0.42);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s;
      z-index: -1;
    }

    .site-nav.is-open .nav-backdrop {
      opacity: 1;
      pointer-events: auto;
    }

    .nav-backdrop[hidden] {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .nav-brand span {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .nav-actions {
      gap: 6px;
    }

    .nav-actions :global(.theme-toggle select) {
      padding-inline: 8px 24px;
      max-width: 7.5rem;
    }

    .nav-actions :global(.lang-toggle) {
      padding-inline: 8px;
    }
  }
</style>

<script>
  const nav = document.getElementById('site-nav')
  const toggle = document.getElementById('nav-toggle')
  const backdrop = document.getElementById('nav-backdrop')
  const menu = document.getElementById('nav-menu')
  const actions = nav?.querySelector('.nav-actions')
  const cta = document.getElementById('nav-cta')
  const page = document.querySelector('main')
  const footer = document.querySelector('.site-footer')

  let hideBackdropTimer = 0

  const setPageInert = (inert: boolean) => {
    if (page instanceof HTMLElement) page.inert = inert
    if (footer instanceof HTMLElement) footer.inert = inert
  }

  const clearHideBackdrop = () => {
    if (hideBackdropTimer) {
      window.clearTimeout(hideBackdropTimer)
      hideBackdropTimer = 0
    }
  }

  const setOpen = (open: boolean) => {
    const wasOpen = nav?.classList.contains('is-open')
    if (open && backdrop) {
      clearHideBackdrop()
      backdrop.hidden = false
    }

    nav?.classList.toggle('is-open', open)
    toggle?.setAttribute('aria-expanded', String(open))
    if (toggle instanceof HTMLButtonElement) {
      const label = open ? toggle.dataset.labelClose : toggle.dataset.labelOpen
      if (label) toggle.setAttribute('aria-label', label)
    }

    if (!open && backdrop && !backdrop.hidden) {
      const hide = () => {
        backdrop.hidden = true
        backdrop.removeEventListener('transitionend', hide)
        clearHideBackdrop()
      }
      backdrop.addEventListener('transitionend', hide)
      hideBackdropTimer = window.setTimeout(hide, 220)
    }

    document.documentElement.classList.toggle('nav-open', open)
    document.body.classList.toggle('nav-open', open)
    setPageInert(open)

    if (!open && wasOpen && toggle instanceof HTMLButtonElement) {
      toggle.focus()
    }
  }

  const onScroll = () => nav?.classList.toggle('is-scrolled', window.scrollY > 12)
  onScroll()
  window.addEventListener('scroll', onScroll, { passive: true })

  const media = window.matchMedia('(max-width: 960px)')
  const onBreakpoint = () => {
    if (cta && menu && actions) {
      if (media.matches) menu.append(cta)
      else actions.insertBefore(cta, toggle)
    }
    if (!media.matches) setOpen(false)
  }
  onBreakpoint()
  media.addEventListener('change', onBreakpoint)

  toggle?.addEventListener('click', () => {
    setOpen(!nav?.classList.contains('is-open'))
  })

  backdrop?.addEventListener('click', () => setOpen(false))

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false))
  })

  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false)
  })

</script>
