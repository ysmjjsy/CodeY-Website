---
import { Code } from 'astro:components'
import githubDark from 'shiki/themes/github-dark-default.mjs'

const tsCode = `import { CodeY } from '@codey/agent-sdk'

// 启动或连接本地运行时
await using runtime = await CodeY.start({
  applicationId: 'com.example.agent',
})

// 提供商配置与凭据只在守护进程内解析
const profile = await runtime.client.providers.put({ /* ... */ })
const credential = await runtime.client.credentials.put({ /* ... */ })

// 创建不可变的 AgentDefinition 修订并执行
const definition = await runtime.client.definitions.create(spec)
const run = await runtime.client.agent(definition.id).query({
  blocks: [{ type: 'text', text: 'Review this project.' }],
})

console.log(await run.result())`

const pyCode = `from codey_agent_sdk import CodeY

async with await CodeY.start("com.example.agent") as runtime:
    # 提供商配置与凭据只在守护进程内解析
    profile = await runtime.client.providers.put({...})
    credential = await runtime.client.credentials.put({...})

    # 创建不可变的 AgentDefinition 修订并执行
    definition = await runtime.client.definitions.create(spec)
    run = await runtime.client.agent(definition["id"]).query(
        {"blocks": [{"type": "text", "text": "Review this project."}]}
    )
    print(await run.result())`

const rsCode = `use codey_agent_client::{AgentClient, AgentClientOptions};

// 连接本地 Agent Runtime 协议
let client = AgentClient::connect(options).await?;

let capabilities = client.capabilities().await?;
println!("runtime {}", capabilities.runtime_version);

client.close().await;`
---

<section class="section" id="sdk">
  <div class="container sdk-grid">
    <div class="sdk-copy reveal">
      <p class="section-tag">Agent Runtime SDK</p>
      <h2 class="section-title">一套运行时，三种语言</h2>
      <p class="section-desc">
        TypeScript、Python、Rust 客户端使用同一份语言无关 Schema 和同一条守护进程执行路径。
      </p>
      <ul class="sdk-points">
        <li><code>RunHandle.result()</code> 不需要消费事件迭代器，内部事件泵负责游标恢复与去重。</li>
        <li>密钥只在写入时提交，读取只返回元数据，永远不进入事件、日志或快照。</li>
        <li>运行时与 SDK 严格成对，清单校验目标、哈希与存储 Schema 范围后才启动。</li>
      </ul>
      <a class="sdk-link" href="/docs/sdk/overview/">
        阅读 SDK 文档
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 8h10M9 4l4 4-4 4"></path>
        </svg>
      </a>
    </div>

    <div class="sdk-code reveal" style="--reveal-delay: 0.1s">
      <div class="code-tabs" role="tablist" aria-label="SDK 语言">
        <button class="code-tab is-active" role="tab" aria-selected="true" data-tab="ts">TypeScript</button>
        <button class="code-tab" role="tab" aria-selected="false" data-tab="py">Python</button>
        <button class="code-tab" role="tab" aria-selected="false" data-tab="rs">Rust</button>
      </div>
      <div class="code-panel is-active" data-panel="ts" role="tabpanel">
        <Code code={tsCode} lang="ts" theme={githubDark} />
      </div>
      <div class="code-panel" data-panel="py" role="tabpanel" hidden>
        <Code code={pyCode} lang="python" theme={githubDark} />
      </div>
      <div class="code-panel" data-panel="rs" role="tabpanel" hidden>
        <Code code={rsCode} lang="rust" theme={githubDark} />
      </div>
    </div>
  </div>
</section>

<style>
  .sdk-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 64px;
    align-items: start;
  }

  .sdk-points {
    margin: 32px 0 36px;
    padding: 0;
    list-style: none;
  }

  .sdk-points li {
    position: relative;
    color: var(--fg-muted);
    font-size: 0.92rem;
    padding: 12px 0 12px 26px;
    border-top: 1px solid var(--border);
  }

  .sdk-points li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 22px;
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: var(--accent);
  }

  .sdk-points code {
    font-size: 0.82rem;
    color: var(--accent-bright);
  }

  .sdk-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent-bright);
    font-weight: 500;
    font-size: 0.95rem;
    transition: gap 0.2s var(--ease-out);
  }

  .sdk-link:hover {
    gap: 12px;
  }

  .sdk-code {
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: #0c0c0f;
    overflow: hidden;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.05),
      0 20px 50px rgba(0, 0, 0, 0.45);
  }

  .code-tabs {
    display: flex;
    gap: 4px;
    padding: 10px 12px;
    border-bottom: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.02);
  }

  .code-tab {
    appearance: none;
    border: 1px solid transparent;
    background: transparent;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 6px 16px;
    border-radius: 8px;
    cursor: pointer;
    transition: color 0.15s, background 0.15s, border-color 0.15s;
  }

  .code-tab:hover {
    color: var(--fg);
  }

  .code-tab.is-active {
    color: var(--accent-bright);
    background: var(--accent-soft);
    border-color: rgba(6, 182, 212, 0.3);
  }

  .code-panel {
    display: none;
    padding: 8px 6px;
  }

  .code-panel.is-active {
    display: block;
  }

  .code-panel :global(pre) {
    margin: 0;
    padding: 16px 18px;
    background: transparent !important;
    font-size: 0.82rem;
    line-height: 1.75;
    overflow-x: auto;
  }

  .code-panel :global(code) {
    font-family: var(--font-mono);
  }

  @media (max-width: 920px) {
    .sdk-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.code-tab')
  const panels = document.querySelectorAll<HTMLElement>('.code-panel')
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        const active = t === tab
        t.classList.toggle('is-active', active)
        t.setAttribute('aria-selected', String(active))
      })
      panels.forEach((p) => {
        const active = p.dataset.panel === tab.dataset.tab
        p.classList.toggle('is-active', active)
        p.hidden = !active
      })
    })
  })
</script>
