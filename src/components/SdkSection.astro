---
import { Code } from 'astro:components'
import githubDark from 'shiki/themes/github-dark-default.mjs'
import type { Locale } from '../i18n/ui'
import { docsPath, t } from '../i18n/utils'

interface Props {
  locale: Locale
}

const { locale } = Astro.props

const tsCode = `import { CodeY } from '@codey/agent-sdk'

// ${t(locale, 'sdk.comment.start')}
await using runtime = await CodeY.start({
  applicationId: 'com.example.agent',
})

// ${t(locale, 'sdk.comment.creds')}
const profile = await runtime.client.providers.put({ /* ... */ })
const credential = await runtime.client.credentials.put({ /* ... */ })

// ${t(locale, 'sdk.comment.def')}
const definition = await runtime.client.definitions.create(spec)
const run = await runtime.client.agent(definition.id).query({
  blocks: [{ type: 'text', text: 'Review this project.' }],
})

console.log(await run.result())`

const pyCode = `from codey_agent_sdk import CodeY

async with await CodeY.start("com.example.agent") as runtime:
    # ${t(locale, 'sdk.comment.creds')}
    profile = await runtime.client.providers.put({...})
    credential = await runtime.client.credentials.put({...})

    # ${t(locale, 'sdk.comment.def')}
    definition = await runtime.client.definitions.create(spec)
    run = await runtime.client.agent(definition["id"]).query(
        {"blocks": [{"type": "text", "text": "Review this project."}]}
    )
    print(await run.result())`

const rsCode = `use codey_agent_client::{AgentClient, AgentClientOptions};

// ${t(locale, 'sdk.comment.rs')}
let client = AgentClient::connect(options).await?;

let capabilities = client.capabilities().await?;
println!("runtime {}", capabilities.runtime_version);

client.close().await;`

const point1Parts = t(locale, 'sdk.point1').split(/(`[^`]+`)/g)
---

<section class="section" id="sdk">
  <div class="container sdk-grid">
    <div class="sdk-copy reveal">
      <p class="section-tag">{t(locale, 'sdk.tag')}</p>
      <h2 class="section-title">{t(locale, 'sdk.title')}</h2>
      <p class="section-desc">{t(locale, 'sdk.desc')}</p>
      <ul class="sdk-points">
        <li>
          {
            point1Parts.map((part) =>
              part.startsWith('`') && part.endsWith('`') ? (
                <code>{part.slice(1, -1)}</code>
              ) : (
                part
              ),
            )
          }
        </li>
        <li>{t(locale, 'sdk.point2')}</li>
        <li>{t(locale, 'sdk.point3')}</li>
      </ul>
      <a class="sdk-link" href={docsPath(locale, 'sdk/overview')}>
        {t(locale, 'sdk.link')}
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 8h10M9 4l4 4-4 4"></path>
        </svg>
      </a>
    </div>

    <div class="sdk-code reveal" style="--reveal-delay: 0.1s">
      <div class="code-tabs" role="tablist" aria-label={t(locale, 'sdk.tabs')}>
        <button class="code-tab is-active" role="tab" aria-selected="true" data-tab="ts">TypeScript</button>
        <button class="code-tab" role="tab" aria-selected="false" data-tab="py">Python</button>
        <button class="code-tab" role="tab" aria-selected="false" data-tab="rs">Rust</button>
      </div>
      <div class="code-panel is-active" data-panel="ts" role="tabpanel">
        <Code code={tsCode} lang="ts" theme={githubDark} />
      </div>
      <div class="code-panel" data-panel="py" role="tabpanel" hidden>
        <Code code={pyCode} lang="python" theme={githubDark} />
      </div>
      <div class="code-panel" data-panel="rs" role="tabpanel" hidden>
        <Code code={rsCode} lang="rust" theme={githubDark} />
      </div>
    </div>
  </div>
</section>

<style>
  .sdk-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 64px;
    align-items: start;
  }

  .sdk-points {
    margin: 32px 0 36px;
    padding: 0;
    list-style: none;
  }

  .sdk-points li {
    position: relative;
    color: var(--fg-muted);
    font-size: 0.92rem;
    padding: 12px 0 12px 26px;
    border-top: 1px solid var(--border);
  }

  .sdk-points li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 22px;
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: var(--accent);
  }

  .sdk-points code {
    font-size: 0.82rem;
    color: var(--accent-bright);
  }

  .sdk-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent-bright);
    font-weight: 500;
    font-size: 0.95rem;
    transition: gap 0.2s var(--ease-out);
  }

  .sdk-link:hover {
    gap: 12px;
  }

  .sdk-code {
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--code-bg);
    overflow: hidden;
    min-width: 0;
    max-width: 100%;
    box-shadow:
      inset 0 1px 0 var(--panel-inset),
      var(--shadow-window);
  }

  .code-tabs {
    display: flex;
    gap: 4px;
    padding: 10px 12px;
    border-bottom: 1px solid var(--border);
    background: var(--ghost-bg);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .code-tabs::-webkit-scrollbar {
    display: none;
  }

  .code-tab {
    appearance: none;
    border: 1px solid transparent;
    background: transparent;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 6px 16px;
    border-radius: 8px;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition: color 0.15s, background 0.15s, border-color 0.15s;
  }

  .code-tab:hover {
    color: var(--fg);
  }

  .code-tab.is-active {
    color: var(--accent-bright);
    background: var(--accent-soft);
    border-color: var(--accent-ring);
  }

  .code-panel {
    display: none;
    padding: 8px 6px;
  }

  .code-panel.is-active {
    display: block;
  }

  .code-panel :global(pre) {
    margin: 0;
    padding: 16px 18px;
    background: transparent !important;
    font-size: 0.82rem;
    line-height: 1.75;
    overflow-x: auto;
  }

  .code-panel :global(code) {
    font-family: var(--font-mono);
  }

  @media (max-width: 920px) {
    .sdk-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 640px) {
    .code-panel :global(pre) {
      padding: 12px 14px;
      font-size: 0.74rem;
      line-height: 1.65;
    }

    .sdk-points {
      margin: 24px 0 28px;
    }
  }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.code-tab')
  const panels = document.querySelectorAll<HTMLElement>('.code-panel')
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        const active = t === tab
        t.classList.toggle('is-active', active)
        t.setAttribute('aria-selected', String(active))
      })
      panels.forEach((p) => {
        const active = p.dataset.panel === tab.dataset.tab
        p.classList.toggle('is-active', active)
        p.hidden = !active
      })
    })
  })
</script>
