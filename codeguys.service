# File path: /etc/systemd/system/codeguys.service
# sudo systemctl daemon-reload
# sudo systemctl start codeguys
# sudo systemctl enable codeguys
# sudo systemctl status codeguys
[Unit]
Description=codeguys Service
After=network.target

[Service]
User=ubuntu  # 注意修改用户名
WorkingDirectory=/path/to/codeguys  # 注意修改路径
ExecStart=/path/to/codeguys/codeguys --port 3000 --log-dir /path/to/codeguys/logs  # 注意修改路径和端口号
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
