CODEY_WEBSITE_HOST=127.0.0.1
CODEY_WEBSITE_PORT=4321
# Production example: https://codey.example.com
CODEY_WEBSITE_ORIGIN=http://127.0.0.1:4321

CODEY_MARKET_UPSTREAM=http://127.0.0.1:8787
# PostgreSQL connection used by website accounts, marketplace, and cloud data.
CODEY_DATABASE_URL=postgresql://goya:change-me@39.105.2.5:15432/codey
CODEY_CLOUD_DEFAULT_TIMEZONE=UTC
# Base64-encoded 32-byte key used to encrypt upstream model API keys at rest.
CODEY_CLOUD_SECRET_KEY=

CODEY_MARKET_GITHUB_CLIENT_ID=
CODEY_MARKET_GITHUB_CLIENT_SECRET=
CODEY_MARKET_ADMIN_GITHUB_LOGINS=
CODEY_MARKET_ADMIN_USERNAME=admin
CODEY_MARKET_ADMIN_PASSWORD=change-me

# Hosted checkout return pages.
CODEY_CLOUD_PAYMENT_SUCCESS_URL=
CODEY_CLOUD_PAYMENT_CANCEL_URL=

# Stripe Checkout. Configure both values or leave both empty.
CODEY_STRIPE_SECRET_KEY=
CODEY_STRIPE_WEBHOOK_SECRET=

# WeChat Pay API v3 Native payment. Key files stay on the server.
CODEY_WECHAT_PAY_APP_ID=
CODEY_WECHAT_PAY_MERCHANT_ID=
CODEY_WECHAT_PAY_MERCHANT_SERIAL=
CODEY_WECHAT_PAY_PRIVATE_KEY_FILE=
CODEY_WECHAT_PAY_API_V3_KEY=
CODEY_WECHAT_PAY_PUBLIC_KEY_ID=
CODEY_WECHAT_PAY_PUBLIC_KEY_FILE=
CODEY_WECHAT_PAY_NOTIFY_URL=

# Alipay computer website payment. Key files stay on the server.
CODEY_ALIPAY_APP_ID=
CODEY_ALIPAY_SELLER_ID=
CODEY_ALIPAY_PRIVATE_KEY_FILE=
CODEY_ALIPAY_PUBLIC_KEY_FILE=
CODEY_ALIPAY_NOTIFY_URL=
CODEY_ALIPAY_RETURN_URL=

# Local integration only. Never enable in production.
CODEY_CLOUD_ENABLE_TEST_PAYMENTS=false
