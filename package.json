{
  "name": "codey-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "24.12.0"
  },
  "scripts": {
    "dev": "node scripts/run-site.mjs dev",
    "dev:web": "astro dev",
    "build": "node scripts/build-site.mjs",
    "build:web": "astro build",
    "build:market": "node scripts/build-site.mjs market",
    "start": "node scripts/run-site.mjs start",
    "preview": "node scripts/run-site.mjs start",
    "typecheck": "tsc --noEmit",
    "check:astro": "astro check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:server": "cargo test -p codey-market-server",
    "check": "pnpm typecheck && pnpm check:astro && pnpm lint && pnpm check:styles && pnpm check:brand && pnpm check:scales && pnpm check:agent-notes && pnpm test && pnpm test:server && pnpm build:web",
    "check:styles": "node scripts/check-astro-styles.mjs && node scripts/check-font-sizes.mjs && node scripts/check-astro-styles.test.mjs && node scripts/check-font-sizes.test.mjs",
    "test:styles": "node scripts/check-astro-styles.test.mjs",
    "check:fonts": "node scripts/check-font-sizes.mjs && node scripts/check-font-sizes.test.mjs",
    "check:brand": "node scripts/check-brand-tokens.mjs && node scripts/check-brand-tokens.test.mjs",
    "check:scales": "node scripts/check-breakpoints.mjs && node scripts/check-breakpoints.test.mjs",
    "check:agent-notes:tree": "node scripts/check-agent-note-tree.mjs",
    "check:agent-notes:format": "node --test scripts/check-agent-note-format.test.mjs && node scripts/check-agent-note-format.mjs",
    "check:agent-notes:archived": "node scripts/check-archived-agent-notes.mjs",
    "check:agent-notes": "pnpm check:agent-notes:tree && pnpm check:agent-notes:format && pnpm check:agent-notes:archived"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.4",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@phosphor-icons/web": "^2.1.2",
    "astro": "^7.1.3",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.13",
    "jsdom": "^29.1.1",
    "shiki": "^4.3.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
