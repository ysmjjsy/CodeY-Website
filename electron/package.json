{
  "name": "codeguys-electron",
  "version": "1.0.0",
  "description": "CodeGuys - AI Model Gateway Desktop Application",
  "main": "main.js",
  "scripts": {
    "start-app": "electron .",
    "dev-app": "cross-env NODE_ENV=development electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "ai",
    "api",
    "gateway",
    "openai",
    "claude"
  ],
  "author": "CodeGuys",
  "repository": {
    "type": "git",
    "url": "https://github.com/ysmjjsy/CodeY-Website"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "42.11.16",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.codeguys.desktop",
    "productName": "CodeGuys",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "codeguys-icon.png",
      "codeguys-tray-template.png",
      "codeguys-tray-template@2x.png",
      "codeguys-tray-windows.png"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "codeguys-icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ],
      "extraResources": [
        {
          "from": "../codeguys",
          "to": "bin/codeguys"
        },
        {
          "from": "node_modules/electron/dist/LICENSE",
          "to": "licenses/electron/LICENSE"
        },
        {
          "from": "node_modules/electron/dist/LICENSES.chromium.html",
          "to": "licenses/electron/LICENSES.chromium.html"
        }
      ]
    },
    "win": {
      "icon": "codeguys-icon.png",
      "target": [
        "nsis",
        "portable"
      ],
      "extraResources": [
        {
          "from": "../codeguys.exe",
          "to": "bin/codeguys.exe"
        },
        {
          "from": "node_modules/electron/dist/LICENSE",
          "to": "licenses/electron/LICENSE"
        },
        {
          "from": "node_modules/electron/dist/LICENSES.chromium.html",
          "to": "licenses/electron/LICENSES.chromium.html"
        }
      ]
    },
    "linux": {
      "icon": "codeguys-icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "extraResources": [
        {
          "from": "../codeguys",
          "to": "bin/codeguys"
        },
        {
          "from": "node_modules/electron/dist/LICENSE",
          "to": "licenses/electron/LICENSE"
        },
        {
          "from": "node_modules/electron/dist/LICENSES.chromium.html",
          "to": "licenses/electron/LICENSES.chromium.html"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
