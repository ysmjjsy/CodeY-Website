# =============================================================================
# CodeY 官网 Docker 部署环境文件
#
# 用法：
#   cp .env.docker.example .env
#   编辑 .env 填入真实值
#   docker compose up -d --build
#
# 本文件被 .gitignore 忽略，禁止提交。
# =============================================================================

# ---------- 公开地址 ----------
# 必须是完整 Origin（协议 + 域名，不能带路径/查询/片段）。
# 它同时决定 GitHub OAuth 回调地址、写操作 Origin 白名单、
# 以及会话 Cookie 是否带 Secure（代码按 api_base_url 是否 https 判断）。
CODEY_WEBSITE_ORIGIN=https://codey.ysmjjsy.com

# ---------- PostgreSQL ----------
# 容器内的 127.0.0.1 指向容器自身，不是宿主机。
# 宿主机上监听的 PostgreSQL 必须用 host.docker.internal 访问
# （compose 已配置 host-gateway 映射）。
# 若 PostgreSQL 也在 compose 网络内，可直接用服务名，例如 postgres:5432。
CODEY_DATABASE_URL=postgresql://goya:goya123@host.docker.internal:14210/codey

# ---------- Cloud 商业域 ----------
CODEY_CLOUD_DEFAULT_TIMEZONE=Asia/Shanghai

# 加密上游模型 API Key，必须 base64 编码的恰好 32 字节。
# 生成：openssl rand -base64 32
# 更换会导致已存的上游密钥无法解密。
CODEY_CLOUD_SECRET_KEY=

# 留空时服务会在 CODEY_MARKET_DATA_ROOT 下生成
# cloud-entitlement-ed25519.pk8。该文件必须持久化备份，
# 丢失会导致已下发的 Desktop 模型授权全部失效。
CODEY_CLOUD_ENTITLEMENT_SIGNING_KEY=
CODEY_CLOUD_ENTITLEMENT_KEY_ID=codey-cloud-v1

# 生产环境必须保持 false
CODEY_CLOUD_ENABLE_TEST_PAYMENTS=false

# ---------- GitHub OAuth ----------
# 两项必须同时填或同时留空。
# 回调地址：https://codey.ysmjjsy.com/api/market/v1/auth/github/callback
CODEY_MARKET_GITHUB_CLIENT_ID=
CODEY_MARKET_GITHUB_CLIENT_SECRET=

# 逗号分隔的 GitHub 登录名（小写比对）。多个必须用英文逗号，不能用空格。
CODEY_MARKET_ADMIN_GITHUB_LOGINS=

# ---------- 本地管理员 ----------
# 密码必须 10-128 字节，否则服务拒绝启动。
CODEY_MARKET_ADMIN_USERNAME=admin
CODEY_MARKET_ADMIN_PASSWORD=

# ---------- 注册邮箱验证码 ----------
# HOST 与 EMAIL_FROM 必须同时填或同时留空；留空则注册入口关闭。
# SECURITY 只接受 tls / starttls / none。465 端口用 tls，587 用 starttls。
# USERNAME 与 PASSWORD 必须同时填或同时留空。
CODEY_REGISTRATION_SMTP_HOST=
CODEY_REGISTRATION_SMTP_PORT=465
CODEY_REGISTRATION_SMTP_SECURITY=tls
CODEY_REGISTRATION_SMTP_USERNAME=
CODEY_REGISTRATION_SMTP_PASSWORD=
CODEY_REGISTRATION_EMAIL_FROM=

# ---------- 支付渠道（每组要么全填要么全空） ----------
# 只填一部分时服务拒绝启动。

# Stripe：两个都填或都留空
CODEY_STRIPE_SECRET_KEY=
CODEY_STRIPE_WEBHOOK_SECRET=

# 微信支付 API v3 Native：以下 7 个必须全部填写
# CODEY_WECHAT_PAY_API_V3_KEY 必须恰好 32 字节
CODEY_WECHAT_PAY_APP_ID=
CODEY_WECHAT_PAY_MERCHANT_ID=
CODEY_WECHAT_PAY_MERCHANT_SERIAL=
CODEY_WECHAT_PAY_PRIVATE_KEY_FILE=
CODEY_WECHAT_PAY_API_V3_KEY=
CODEY_WECHAT_PAY_PUBLIC_KEY_ID=
CODEY_WECHAT_PAY_PUBLIC_KEY_FILE=
CODEY_WECHAT_PAY_NOTIFY_URL=

# 支付宝：以下 3 个必须全部填写
CODEY_ALIPAY_APP_ID=
CODEY_ALIPAY_PRIVATE_KEY_FILE=
CODEY_ALIPAY_PUBLIC_KEY_FILE=
CODEY_ALIPAY_SELLER_ID=
CODEY_ALIPAY_NOTIFY_URL=
CODEY_ALIPAY_RETURN_URL=
